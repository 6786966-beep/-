const [theme, setTheme] = useState<'light' | 'dark'>(() => {
  if (typeof window === 'undefined') return 'light';
  const saved = localStorage.getItem('logistics_theme');
  return saved === 'dark' ? 'dark' : 'light';
});

  useEffect(() => {
    const currentLocalDate = getTodayString();
    setToday(currentLocalDate);
    setSelectedDate(currentLocalDate);
    setOperatorDate(currentLocalDate);
    const loadedTasks = loadFromStorage<Task[]>('logistics_tasks', ['logistics_tasks_v8', 'logistics_tasks_v7', 'logistics_tasks_v6', 'logistics_tasks_v5'], createInitialTasks(currentLocalDate));
    setTasks(migrateTasks(loadedTasks));
    setCouriers(loadFromStorage<Courier[]>('logistics_couriers', ['logistics_couriers_v1'], initialCouriers));
    setClients(loadFromStorage<Client[]>('logistics_clients', ['logistics_clients_v1'], []));
    setCashOperations(loadFromStorage<CashOperation[]>('logistics_cash', [], []));
    setOfficeMeta(loadFromStorage<Record<string, OfficeMeta>>('logistics_office_meta', [], {}));
    const loadedStaff = loadFromStorage<StaffMember[]>('logistics_staff', [], []);
    setStaff(loadedStaff.map(s => ({
      ...s,
      permissions: {
        pages: { board: true, courier: true, operator: true, admin: true, ...s.permissions?.pages },
        adminTabs: { couriers: false, clients: false, offices: true, reports: true, staff: false, cash: false, ...s.permissions?.adminTabs },
        actions: { createTask: true, editTask: true, deleteTask: true, operatorConfirm: true, importClients: true, manageClients: true, manageCouriers: true, manageStaff: true, ...s.permissions?.actions },
      },
    })));
    const sessionId = localStorage.getItem('logistics_session_staff');
    if (sessionId) {
      const emp = loadedStaff.find(s => s.id === sessionId && s.active);
      setCurrentStaffId(emp ? emp.id : null);
      if (!emp) localStorage.removeItem('logistics_session_staff');
    }
    // 🆕 Синхронизация темы с <html data-theme="...">
useEffect(() => {
  if (typeof document !== 'undefined') {
    document.documentElement.setAttribute('data-theme', theme);
  }
}, [theme]);
    setIsLoaded(true);
  }, []);

  useEffect(() => {
    fetch('/api/post-offices').then(res => res.json()).then(data => { if (data.postOffices) setPostOffices(data.postOffices); }).catch(err => console.error(err));
  }, []);

  useEffect(() => { if (isLoaded) localStorage.setItem('logistics_tasks', JSON.stringify(tasks)); }, [tasks, isLoaded]);
  useEffect(() => { if (isLoaded) localStorage.setItem('logistics_couriers', JSON.stringify(couriers)); }, [couriers, isLoaded]);
  useEffect(() => { if (isLoaded) localStorage.setItem('logistics_clients', JSON.stringify(clients)); }, [clients, isLoaded]);
  useEffect(() => { if (isLoaded) localStorage.setItem('logistics_cash', JSON.stringify(cashOperations)); }, [cashOperations, isLoaded]);
  useEffect(() => { if (isLoaded) localStorage.setItem('logistics_staff', JSON.stringify(staff)); }, [staff, isLoaded]);
  useEffect(() => { if (isLoaded) localStorage.setItem('logistics_office_meta', JSON.stringify(officeMeta)); }, [officeMeta, isLoaded]);
  useEffect(() => { localStorage.setItem('logistics_theme', theme); }, [theme]);

  useEffect(() => {
    if (isLoaded) {
      const todayStr = getTodayString();
      if (!cashDateTo) setCashDateTo(todayStr);
      if (!cashDateFrom) { const d = new Date(); d.setDate(1); setCashDateFrom(d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-01'); }
      if (!cashForm.date) setCashForm(prev => ({ ...prev, date: todayStr }));
      if (!reportDateTo) setReportDateTo(todayStr);
      if (!reportDateFrom) { const d = new Date(); d.setDate(1); setReportDateFrom(d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-01'); }
    }
  }, [isLoaded]);

  const sensors = useSensors(useSensor(PointerSensor, { activationConstraint: { distance: 8 } }));
  const filteredAndSortedTasks = sortTasksByStatus(tasks.filter(task => task.date === selectedDate));
  const currentUser = useMemo(() => staff.find(s => s.id === currentStaffId) || null, [staff, currentStaffId]);
  const canPage = (p: PageKey) => !currentUser || currentUser.permissions.pages[p];
  const canAdminTab = (t: AdminTabKey) => !currentUser || currentUser.permissions.adminTabs[t];
  const canAction = (a: ActionKey) => !currentUser || currentUser.permissions.actions[a];

  useEffect(() => {
    if (!currentUser || !isLoaded) return;
    if (!currentUser.permissions.pages[currentPage]) {
      const first = (['board', 'courier', 'operator', 'admin'] as PageKey[]).find(p => currentUser.permissions.pages[p]);
      setCurrentPage(first || 'board');
      return;
    }
    if (currentPage === 'admin' && !currentUser.permissions.adminTabs[adminTab]) {
      const t = (['couriers', 'clients', 'offices', 'reports', 'staff', 'cash'] as AdminTabKey[]).find(x => currentUser.permissions.adminTabs[x]);
      if (t) setAdminTab(t);
    }
  }, [currentUser, currentPage, adminTab, isLoaded]);

  // 🆕 Даты текущей недели (Пн-Сб)
  const getWeekDates = (dateStr: string): string[] => {
    if (!dateStr) return [];
    const d = new Date(dateStr + 'T00:00:00');
    const day = d.getDay();
    const diffToMonday = day === 0 ? -6 : 1 - day;
    const monday = new Date(d);
    monday.setDate(d.getDate() + diffToMonday);
    const result: string[] = [];
    for (let i = 0; i < 6; i++) {
      const cur = new Date(monday);
      cur.setDate(monday.getDate() + i);
      result.push(cur.getFullYear() + '-' + String(cur.getMonth() + 1).padStart(2, '0') + '-' + String(cur.getDate()).padStart(2, '0'));
    }
    return result;
  };

  const weekDates = useMemo(() => getWeekDates(today), [today]);

  // 🆕 Тариф задачи из карточки клиента
  const getTaskRate = (task: Task): string => {
    let client: Client | undefined;
    if (task.clientId) client = clients.find(c => c.id === task.clientId);
    if (!client && task.clientCompany) { const n = task.clientCompany.toLowerCase().trim(); client = clients.find(c => c.companyName.toLowerCase().trim() === n); }
    if (!client && task.officeCompany) { const n = task.officeCompany.toLowerCase().trim(); client = clients.find(c => c.companyName.toLowerCase().trim() === n); }
    if (!client && (task as any).legalCompanyName) { const n = (task as any).legalCompanyName.toLowerCase().trim(); client = clients.find(c => c.companyName.toLowerCase().trim() === n); }
    return (client as any)?.deliveryPickupRate || '';
  };

  // 🆕 Форматирование времени завершения
  const formatCompletedAt = (iso?: string): string => {
    if (!iso) return '';
    return new Date(iso).toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  };

  // 🆕 Проверка попадания даты в режим оператора
  const matchesOperatorDate = (taskDate: string): boolean => {
    if (operatorDateMode === 'single') return taskDate === operatorDate;
    if (operatorDateFrom && taskDate < operatorDateFrom) return false;
    if (operatorDateTo && taskDate > operatorDateTo) return false;
    return true;
  };

  // 🆕 Неактивный клиент
  const isCompanyInactive = (companyName: string): boolean => {
    const normalized = companyName.toLowerCase().trim();
    const client = clients.find(c => c.companyName.toLowerCase().trim() === normalized);
    return !!client && (client as any).active === false;
  };

  // 🆕 Ячейка клиента
  const getClientCell = (companyName: string): string => {
    const normalized = companyName.toLowerCase().trim();
    const client = clients.find(c => c.companyName.toLowerCase().trim() === normalized);
    return (client as any)?.cell || '';
  };

  // 🆕 Переключение активности клиента
  const toggleClientActive = (clientId: number) => {
    setClients(clients.map(c => {
      if (c.id !== clientId) return c;
      const currentlyActive = (c as any).active !== false;
      return ({ ...c, active: !currentlyActive } as any);
    }));
  };

  // 🆕 Переключатель «Дата / Период» для оператора
  const renderOperatorDateControls = () => (
    <div className="space-y-2">
      <div className="flex gap-1 p-1 rounded-lg w-fit" style={{ background: 'var(--panel-3)' }}>
        <button type="button" onClick={() => setOperatorDateMode('single')} className={'tab ' + (operatorDateMode === 'single' ? 'active' : '')}>📅 Дата</button>
        <button type="button" onClick={() => setOperatorDateMode('range')} className={'tab ' + (operatorDateMode === 'range' ? 'active' : '')}>📆 Период</button>
      </div>
      {operatorDateMode === 'single' ? (
        <div><label className="label">Дата:</label><input type="date" value={operatorDate} onChange={(e) => setOperatorDate(e.target.value)} className="input" /></div>
      ) : (
        <div className="grid-2">
          <div><label className="label">С:</label><input type="date" value={operatorDateFrom} onChange={(e) => setOperatorDateFrom(e.target.value)} className="input" /></div>
          <div><label className="label">По:</label><input type="date" value={operatorDateTo} onChange={(e) => setOperatorDateTo(e.target.value)} className="input" /></div>
        </div>
      )}
    </div>
  );

  const handleLogin = () => {
    const emp = staff.find(s => s.login.toLowerCase() === loginForm.login.trim().toLowerCase());
    if (!emp || !emp.active) { alert('⚠️ Сотрудник не найден или отключён'); return; }
    if (emp.passwordHash !== hashPassword(loginForm.password)) { alert('⚠️ Неверный пароль'); return; }
    setCurrentStaffId(emp.id);
    localStorage.setItem('logistics_session_staff', emp.id);
    setIsLoginModalOpen(false);
    setLoginForm({ login: '', password: '' });
    const firstPage = (['board', 'courier', 'operator', 'admin'] as PageKey[]).find(p => emp.permissions.pages[p]);
    if (firstPage) {
      setCurrentPage(firstPage);
      if (firstPage === 'admin') {
        const t = (['couriers', 'clients', 'offices', 'reports', 'staff', 'cash'] as AdminTabKey[]).find(x => emp.permissions.adminTabs[x]);
        if (t) setAdminTab(t);
      }
    }
  };
  const handleLogout = () => {
    setCurrentStaffId(null);
    localStorage.removeItem('logistics_session_staff');
    setCurrentPage('board');
    setAdminTab('couriers');
    setCourierWeekView(null);
  };
  const openStaffCreate = () => {
    setEditingStaff(null);
    setStaffForm({ name: '', login: '', password: '', showPassword: false, role: 'logistic', active: true, permissions: ROLE_PRESETS['logistic'].make() });
    setIsStaffModalOpen(true);
  };
  const openStaffEdit = (s: StaffMember) => {
    setEditingStaff(s);
    setStaffForm({ name: s.name, login: s.login, password: '', showPassword: false, role: s.role, active: s.active, permissions: JSON.parse(JSON.stringify(s.permissions)) });
    setIsStaffModalOpen(true);
  };
  const handleSaveStaff = () => {
    if (!staffForm.name.trim()) return alert('⚠️ Укажите имя сотрудника');
    if (!staffForm.login.trim()) return alert('⚠️ Укажите логин');
    const loginNorm = staffForm.login.trim().toLowerCase();
    if (staff.some(s => s.login.toLowerCase() === loginNorm && s.id !== editingStaff?.id)) return alert('⚠️ Такой логин уже занят');
    const pwd = staffForm.password.trim();
    if (pwd && pwd.length < 4) return alert('⚠️ Пароль должен быть не короче 4 символов');
    if (editingStaff) {
      const newHash = pwd ? hashPassword(pwd) : editingStaff.passwordHash;
      setStaff(staff.map(s => s.id === editingStaff.id ? { ...s, name: staffForm.name.trim(), login: staffForm.login.trim(), passwordHash: newHash, role: staffForm.role, active: s.id === currentStaffId ? true : staffForm.active, permissions: staffForm.permissions } : s));
    } else {
      if (!pwd) return alert('⚠️ Задайте пароль для нового сотрудника');
      setStaff([...staff, { id: 'staff_' + Date.now(), name: staffForm.name.trim(), login: staffForm.login.trim(), passwordHash: hashPassword(pwd), role: staffForm.role, active: staffForm.active, permissions: staffForm.permissions, createdAt: new Date().toISOString() }]);
    }
    setIsStaffModalOpen(false);
  };
  const handleDeleteStaff = (id: string) => {
    if (id === currentStaffId) return alert('⚠️ Нельзя удалить учётную запись, под которой вы вошли');
    const s = staff.find(x => x.id === id);
    if (!s) return;
    if (!confirm('Удалить сотрудника "' + s.name + '" (' + s.login + ')?')) return;
    setStaff(staff.filter(x => x.id !== id));
  };
  const toggleStaffActive = (s: StaffMember) => {
    if (s.id === currentStaffId) return alert('⚠️ Нельзя отключить собственную учётную запись');
    setStaff(staff.map(x => x.id === s.id ? { ...x, active: !x.active } : x));
  };
  const toggleStaffPage = (key: PageKey) => setStaffForm(f => ({ ...f, permissions: { ...f.permissions, pages: { ...f.permissions.pages, [key]: !f.permissions.pages[key] } } }));
  const toggleStaffAdminTab = (key: AdminTabKey) => setStaffForm(f => ({ ...f, permissions: { ...f.permissions, adminTabs: { ...f.permissions.adminTabs, [key]: !f.permissions.adminTabs[key] } } }));
  const toggleStaffAction = (key: ActionKey) => setStaffForm(f => ({ ...f, permissions: { ...f.permissions, actions: { ...f.permissions.actions, [key]: !f.permissions.actions[key] } } }));

  useEffect(() => {
    const handleClickOutside = (event: MouseEvent) => {
      if (globalSearchRef.current && !globalSearchRef.current.contains(event.target as Node)) setShowGlobalSearch(false);
    };
    document.addEventListener('mousedown', handleClickOutside);
    return () => document.removeEventListener('mousedown', handleClickOutside);
  }, []);

  const globalSearchQuery = globalSearch.toLowerCase().trim();
  const globalSearchResults = useMemo(() => {
    if (globalSearchQuery.length < 2) return null;
    const matchedClients = clients.filter(c =>
      c.companyName.toLowerCase().includes(globalSearchQuery) ||
      c.address.toLowerCase().includes(globalSearchQuery) ||
      c.contactPerson.toLowerCase().includes(globalSearchQuery) ||
      c.phone.toLowerCase().includes(globalSearchQuery) ||
      (c.note || '').toLowerCase().includes(globalSearchQuery) ||
      (c.postOffice || '').toLowerCase().includes(globalSearchQuery) ||
      (c.holding || '').toLowerCase().includes(globalSearchQuery)
    ).slice(0, 8);
    const matchedTasks = tasks
      .filter(t => {
        const parts: (string | undefined)[] = [t.title, t.clientCompany, t.clientAddress, t.officeCompany, t.officeAddress, t.comments, t.courierComments, t.noVisitReason, t.postIndex, t.postAddress];
        if (t.companies) t.companies.forEach(c => parts.push(typeof c === 'string' ? c : c.name));
        if (t.postPoints) t.postPoints.forEach(p => {
          parts.push(p.postIndex, p.postAddress);
          p.companies.forEach(c => parts.push(typeof c === 'string' ? c : c.name));
        });
        return parts.filter(Boolean).join(' ').toLowerCase().includes(globalSearchQuery);
      })
      .sort((a, b) => a.date.localeCompare(b.date))
      .slice(0, 10);
    const matchedPostOffices = postOffices.filter(po =>
      po.displayName.toLowerCase().includes(globalSearchQuery) ||
      po.index.toLowerCase().includes(globalSearchQuery) ||
      po.address.toLowerCase().includes(globalSearchQuery) ||
      po.folderName.toLowerCase().includes(globalSearchQuery) ||
      po.companies.some(c => c.toLowerCase().includes(globalSearchQuery))
    ).slice(0, 5);
    return { matchedClients, matchedTasks, matchedPostOffices };
  }, [globalSearchQuery, clients, tasks, postOffices]);

  const hasGlobalSearchResults = !!globalSearchResults && (
    globalSearchResults.matchedClients.length > 0 ||
    globalSearchResults.matchedTasks.length > 0 ||
    globalSearchResults.matchedPostOffices.length > 0
  );

  const handleGlobalSearchSelectTask = (task: Task) => {
    setSelectedDate(task.date); setSelectedTask(task); setCurrentPage('board'); setCourierWeekView(null); setGlobalSearch(''); setShowGlobalSearch(false);
  };
  const handleGlobalSearchSelectClient = (client: Client) => {
    setCurrentPage('admin'); setAdminTab('clients'); setEditingClient(client);
    setClientForm({ companyName: client.companyName, contactPerson: client.contactPerson, phone: client.phone, address: client.address, note: client.note, postOffice: client.postOffice || '', holding: client.holding || '', contractEndDate: (client as any).contractEndDate || '', powerOfAttorneyEndDate: (client as any).powerOfAttorneyEndDate || '', deliveryPickupRate: (client as any).deliveryPickupRate || '', cell: (client as any).cell || '', active: (client as any).active !== false });
    setIsClientModalOpen(true); setGlobalSearch(''); setShowGlobalSearch(false);
  };
  const handleGlobalSearchSelectPostOffice = (office: PostOffice) => {
    handleOpenAllDoverennostiForOffice(office.folderName); setGlobalSearch(''); setShowGlobalSearch(false);
  };

  const getClientsByPostOffice = (folderName: string): Client[] => {
    if (!folderName.trim()) return [];
    const office = postOffices.find(po => po.folderName === folderName);
    if (!office) return [];
    const nf = folderName.toLowerCase().trim();
    const ni = office.index.toLowerCase().trim();
    const na = office.address.toLowerCase().trim();
    return clients.filter(client => {
      if (!client.postOffice || !client.postOffice.trim()) return false;
      const cpo = client.postOffice.toLowerCase().trim();
      if (cpo === nf) return true;
      if (ni && (cpo.includes(ni) || ni.includes(cpo))) return true;
      if (na && (cpo.includes(na) || na.includes(cpo))) return true;
      return false;
    });
  };

  const getCompaniesFromClientsByPostOffice = (folderName: string): CompanyItem[] =>
    getClientsByPostOffice(folderName).filter(c => (c as any).active !== false).map(c => ({ name: c.companyName, letterCount: 0 }));

  const postOfficeOptions = postOffices.map(po => {
    const clientsCount = getClientsByPostOffice(po.folderName).length;
    return { value: po.folderName, label: po.displayName + ' (' + clientsCount + ' клиентов)' };
  });
  const clientOptions = clients.filter(c => (c as any).active !== false).map(c => ({ value: String(c.id), label: c.companyName }));
  const courierOptions = couriers.map(c => ({ value: c.id, label: c.fullName || c.name }));
  const courierViewOptions = couriers.filter(c => c.id !== 'unassigned').map(c => ({ value: c.id, label: c.fullName || c.name }));
  const cashClientFilterOptions = useMemo(() => [
    { value: '', label: 'Все клиенты' },
    ...clients.map(c => ({ value: String(c.id), label: c.companyName })),
  ], [clients]);

  useEffect(() => {
    if (courierViewId) localStorage.setItem('courier_view_id', courierViewId);
    else localStorage.removeItem('courier_view_id');
  }, [courierViewId]);

  const getClientNoteForCompany = (companyName: string): string | null => {
    if (!companyName.trim()) return null;
    const normalized = companyName.toLowerCase().trim();
    let client = clients.find(c => c.companyName.toLowerCase().trim() === normalized);
    if (!client) {
      client = clients.find(c => {
        const clientName = c.companyName.toLowerCase().trim();
        if (clientName.length < 3 || normalized.length < 3) return false;
        return clientName.includes(normalized) || normalized.includes(clientName);
      });
    }
    if (client?.note?.trim()) return client.note.trim();
    return null;
  };

  const findPostOfficeForClient = (client: Client): PostOffice | undefined => {
    if (client.postOffice && client.postOffice.trim()) {
      const normalizedClientPO = client.postOffice.toLowerCase().trim();
      const found = postOffices.find(po => {
        const folder = po.folderName.toLowerCase().trim();
        const index = po.index.toLowerCase().trim();
        const address = po.address.toLowerCase().trim();
        if (folder === normalizedClientPO) return true;
        if (index && (normalizedClientPO.includes(index) || index.includes(normalizedClientPO))) return true;
        if (address && (normalizedClientPO.includes(address) || address.includes(normalizedClientPO))) return true;
        return false;
      });
      if (found) return found;
    }
    const normalizedCompanyName = client.companyName.toLowerCase().trim();
    return postOffices.find(po => po.companies.some(c => c.toLowerCase().trim() === normalizedCompanyName));
  };

  const handleCourierOpenPowerOfAttorney = (clientIdStr: string) => {
    if (!clientIdStr) { setCourierSearchClient(''); return; }
    const client = clients.find(c => c.id === Number(clientIdStr));
    if (!client) { setCourierSearchClient(''); return; }
    const foundOffice = findPostOfficeForClient(client);
    if (!foundOffice) {
      alert('⚠️ Не удалось найти доверенность для "' + client.companyName + '".');
      setCourierSearchClient('');
      return;
    }
    openPrintWindow([{ folderName: foundOffice.folderName, pointTitle: foundOffice.index + ', ' + foundOffice.address, companies: [{ name: client.companyName, letterCount: 0 }] }], 'Доверенность — ' + client.companyName);
    setCourierSearchClient('');
  };

  const handleOpenAllDoverennostiForOffice = (folderName: string) => {
    const office = postOffices.find(po => po.folderName === folderName);
    if (!office) return;
    const allCompanies: CompanyItem[] = office.companies.map(name => ({ name, letterCount: 0 }));
    if (allCompanies.length === 0) { alert('В этом отделении нет доверенностей'); return; }
    openPrintWindow([{ folderName: office.folderName, pointTitle: office.index + ', ' + office.address, companies: allCompanies }], 'Все доверенности — ' + office.displayName);
  };

  const filteredPostOfficesForCourier = (() => {
    const q = courierDoverennostSearch.toLowerCase().trim();
    if (!q) return postOffices;
    return postOffices.filter(po => {
      if (po.displayName.toLowerCase().includes(q)) return true;
      if (po.index.toLowerCase().includes(q)) return true;
      if (po.address.toLowerCase().includes(q)) return true;
      if (po.folderName.toLowerCase().includes(q)) return true;
      return po.companies.some(c => c.toLowerCase().includes(q));
    });
  })();

  const handleImportExcel = (event: React.ChangeEvent<HTMLInputElement>) => {
    const file = event.target.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (e) => {
      try {
        const data = new Uint8Array(e.target?.result as ArrayBuffer);
        const workbook = XLSX.read(data, { type: 'array' });
        const worksheet = workbook.Sheets[workbook.SheetNames[0]];
        const jsonData = XLSX.utils.sheet_to_json<any[]>(worksheet, { header: 1 });
        if (!jsonData || jsonData.length === 0) { setImportExcelStatus({ message: '❌ Файл пуст или неверный формат', type: 'error' }); return; }
        const startRow = jsonData.length > 1 && typeof jsonData[0][0] === 'string' && jsonData[0][0].toLowerCase().includes('почтов') ? 1 : 0;
        const rows = jsonData.slice(startRow);
        const newClients: Client[] = [];
        let baseId = Date.now();
        rows.forEach((row: any[]) => {
          if (!row || row.length === 0) return;
          const postOffice = String(row[0] || '').trim();
          const nameAndAddress = String(row[1] || '').trim();
          const note = String(row[2] || '').trim();
          const holding = String(row[3] || '').trim();
          if (!nameAndAddress && !postOffice) return;
          const { companyName, address } = parseCompanyNameAndAddress(nameAndAddress);
          newClients.push({ id: baseId++, companyName: companyName || nameAndAddress, contactPerson: '', phone: '', address: address, note: note, postOffice: postOffice, holding: holding });
        });
        if (newClients.length === 0) { setImportExcelStatus({ message: '❌ Не удалось распознать данные в файле', type: 'error' }); return; }
        if (confirm('📋 Найдено записей: ' + newClients.length + '\nЗаменить текущую базу клиентов или добавить к существующей?\nОК = Заменить полностью\nОтмена = Добавить к существующим')) {
          setClients(newClients);
        } else {
          setClients(prev => [...prev, ...newClients]);
        }
        setImportExcelStatus({ message: '✅ Успешно импортировано ' + newClients.length + ' клиентов', type: 'success' });
      } catch (err) {
        setImportExcelStatus({ message: '❌ Ошибка чтения файла: ' + (err as Error).message, type: 'error' });
      }
    };
    reader.readAsArrayBuffer(file);
    event.target.value = '';
  };

  const moveTaskInColumn = (task: Task, direction: -1 | 1) => {
    if (!canAction('editTask')) return;
    const columnTasks = tasks.filter(t => t.date === task.date && t.status === task.status).sort(boardComparator);
    const idx = columnTasks.findIndex(t => t.id === task.id);
    if (idx < 0) return;
    const swapIdx = idx + direction;
    if (swapIdx < 0 || swapIdx >= columnTasks.length) return;
    const newOrder = [...columnTasks];
    const tmp = newOrder[idx];
    newOrder[idx] = newOrder[swapIdx];
    newOrder[swapIdx] = tmp;
    const idToOrder = new Map<number, number>();
    newOrder.forEach((t, i) => idToOrder.set(t.id, i));
    const seriesOrder = new Map<string, number>();
    newOrder.forEach((t, i) => { if (t.recurrenceGroupId) seriesOrder.set(t.recurrenceGroupId, i); });
    setTasks(prev => prev.map(t => {
      if (t.date === task.date && t.status === task.status && idToOrder.has(t.id)) return { ...t, sortOrder: idToOrder.get(t.id) };
      if (t.recurrenceGroupId && seriesOrder.has(t.recurrenceGroupId)) return { ...t, sortOrder: seriesOrder.get(t.recurrenceGroupId) };
      return t;
    }));
  };

  const handleUpdateTask = (taskId: number, updates: Partial<Task>) => {
    setTasks(prev => prev.map(t => (t.id === taskId ? { ...t, ...updates } : t)));
    if (selectedTask?.id === taskId) setSelectedTask({ ...selectedTask, ...updates });
    if (courierSelectedTask?.id === taskId) setCourierSelectedTask({ ...courierSelectedTask, ...updates } as Task);
    if (sendModalTask?.id === taskId) setSendModalTask({ ...sendModalTask, ...updates });
  };

  const completionFieldsFor = (task: Task, newStatus: TaskWorkflowStatus): Partial<Task> => {
    if (newStatus === 'completed') return { completionType: task.completionType || 'visited', completedAt: task.completedAt || new Date().toISOString() };
    if (task.completionType || task.completedAt || task.noVisitReason) return { completionType: undefined, noVisitReason: undefined, completedAt: undefined };
    return {};
  };

  // 🆕 Обновлённый handleDragEnd: между колонками И внутри колонок
  const handleDragEnd = (event: DragEndEvent) => {
    const { active, over } = event;
    setActiveTask(null);
    if (!over) return;
    if (!canAction('editTask')) return;
    const draggedTask = active.data.current?.task as Task;
    if (!draggedTask) return;
    const overTask = over.data.current?.task as Task | undefined;
    const overStatus = over.data.current?.status as string | undefined;
    if (overStatus && draggedTask.status !== overStatus) {
      setTasks(prev => prev.map(t => (t.id === draggedTask.id ? { ...t, status: overStatus } : t)));
      if (selectedTask?.id === draggedTask.id) setSelectedTask({ ...selectedTask, status: overStatus });
      return;
    }
    if (overTask && overTask.status !== draggedTask.status) {
      setTasks(prev => prev.map(t => (t.id === draggedTask.id ? { ...t, status: overTask.status } : t)));
      if (selectedTask?.id === draggedTask.id) setSelectedTask({ ...selectedTask, status: overTask.status });
      return;
    }
    if (overTask && overTask.id !== draggedTask.id && overTask.status === draggedTask.status && overTask.date === draggedTask.date) {
      const columnTasks = tasks.filter(t => t.date === draggedTask.date && t.status === draggedTask.status).sort(boardComparator);
      const oldIndex = columnTasks.findIndex(t => t.id === draggedTask.id);
      const newIndex = columnTasks.findIndex(t => t.id === overTask.id);
      if (oldIndex < 0 || newIndex < 0) return;
      const newOrder = [...columnTasks];
      const [movedTask] = newOrder.splice(oldIndex, 1);
      newOrder.splice(newIndex, 0, movedTask);
      const idToOrder = new Map<number, number>();
      newOrder.forEach((t, i) => idToOrder.set(t.id, i));
      const seriesOrder = new Map<string, number>();
      newOrder.forEach((t, i) => { if (t.recurrenceGroupId) seriesOrder.set(t.recurrenceGroupId, i); });
      setTasks(prev => prev.map(t => {
        if (t.date === draggedTask.date && t.status === draggedTask.status && idToOrder.has(t.id)) return { ...t, sortOrder: idToOrder.get(t.id) };
        if (t.recurrenceGroupId && seriesOrder.has(t.recurrenceGroupId)) return { ...t, sortOrder: seriesOrder.get(t.recurrenceGroupId) };
        return t;
      }));
    }
  };

  const handleTaskClick = (task: Task) => { if (!canAction('editTask')) return; setSelectedTask(task); };

  const handleDeleteTask = (deleteSeries: boolean = false) => {
    if (!selectedTask) return;
    if (deleteSeries && selectedTask.recurrenceGroupId) {
      if (confirm('⚠️ Удалить ВСЮ СЕРИЮ (' + tasks.filter(t => t.recurrenceGroupId === selectedTask.recurrenceGroupId).length + ' задач)?')) {
        setTasks(prev => prev.filter(t => t.recurrenceGroupId !== selectedTask.recurrenceGroupId));
        setSelectedTask(null);
      }
    } else {
      if (confirm('⚠️ Удалить задачу "' + selectedTask.title + '"?')) {
        setTasks(prev => prev.filter(t => t.id !== selectedTask.id));
        setSelectedTask(null);
      }
    }
  };

  const handleWorkflowStatusChange = (newStatus: TaskWorkflowStatus) => {
    if (!selectedTask) return;
    if (newStatus === 'completed' && selectedTask.workflowStatus !== 'completed') {
      if (selectedTask.type === 'post' || selectedTask.type === 'complex') {
        setPendingTaskForConfirm(selectedTask);
        setPreviousStatus(selectedTask.workflowStatus);
        const initialCounts: Record<string, number> = {};
        if (selectedTask.type === 'post') normalizeCompanies(selectedTask.companies).forEach((c, idx) => { initialCounts['post-' + idx] = 0; });
        else if (selectedTask.type === 'complex' && selectedTask.postPoints) selectedTask.postPoints.forEach((point, pIdx) => { normalizeCompanies(point.companies).forEach((c, cIdx) => { initialCounts['point-' + pIdx + '-comp-' + cIdx] = 0; }); });
        setConfirmReceivedCounts(initialCounts);
        setIsConfirmModalOpen(true);
        return;
      }
    }
    handleUpdateTask(selectedTask.id, { workflowStatus: newStatus, ...completionFieldsFor(selectedTask, newStatus) });
  };

  const handleConfirmReceived = () => {
    if (!pendingTaskForConfirm) return;
    const updates: Partial<Task> = { workflowStatus: 'completed', completionType: pendingTaskForConfirm.completionType || 'visited', completedAt: pendingTaskForConfirm.completedAt || new Date().toISOString() };
    if (pendingTaskForConfirm.type === 'post') {
      updates.companies = normalizeCompanies(pendingTaskForConfirm.companies).map((c, idx) => ({ ...c, receivedCount: confirmReceivedCounts['post-' + idx] ?? 0, operatorConfirmed: false }));
    } else if (pendingTaskForConfirm.type === 'complex' && pendingTaskForConfirm.postPoints) {
      updates.postPoints = pendingTaskForConfirm.postPoints.map((point, pIdx) => ({ ...point, companies: normalizeCompanies(point.companies).map((c, cIdx) => ({ ...c, receivedCount: confirmReceivedCounts['point-' + pIdx + '-comp-' + cIdx] ?? 0, operatorConfirmed: false })) }));
    }
    handleUpdateTask(pendingTaskForConfirm.id, updates);
    setIsConfirmModalOpen(false);
    setPendingTaskForConfirm(null);
  };

  const handleCancelConfirm = () => {
    if (pendingTaskForConfirm) handleUpdateTask(pendingTaskForConfirm.id, { workflowStatus: previousStatus });
    setIsConfirmModalOpen(false);
    setPendingTaskForConfirm(null);
  };

  const handleConfirmCompany = (task: Task, companyKey: string, count: number) => {
    const nowIso = new Date().toISOString();
    if (task.type === 'post') {
      const idx = parseInt(companyKey.split('-')[1]);
      handleUpdateTask(task.id, { companies: normalizeCompanies(task.companies).map((c, i) => i === idx ? { ...c, receivedCount: count, operatorConfirmed: true, confirmedAt: nowIso } : c) });
    } else if (task.type === 'complex' && task.postPoints) {
      const parts = companyKey.split('-');
      const pIdx = parseInt(parts[1]);
      const cIdx = parseInt(parts[3]);
      handleUpdateTask(task.id, { postPoints: task.postPoints.map((point, pi) => pi !== pIdx ? point : { ...point, companies: normalizeCompanies(point.companies).map((c, ci) => ci === cIdx ? { ...c, receivedCount: count, operatorConfirmed: true, confirmedAt: nowIso } : c) }) });
    }
    setLocalReceivedCounts(prev => { const n = { ...prev }; delete n[companyKey]; return n; });
  };

  const handleUnconfirmCompany = (task: Task, companyKey: string) => {
    if (!confirm('↩️ Отменить подтверждение?')) return;
    if (task.type === 'post') {
      const idx = parseInt(companyKey.split('-')[1]);
      handleUpdateTask(task.id, { companies: normalizeCompanies(task.companies).map((c, i) => i === idx ? { ...c, operatorConfirmed: false, confirmedAt: undefined } : c) });
    } else if (task.type === 'complex' && task.postPoints) {
      const parts = companyKey.split('-');
      const pIdx = parseInt(parts[1]);
      const cIdx = parseInt(parts[3]);
      handleUpdateTask(task.id, { postPoints: task.postPoints.map((point, pi) => pi !== pIdx ? point : { ...point, companies: normalizeCompanies(point.companies).map((c, ci) => ci === cIdx ? { ...c, operatorConfirmed: false, confirmedAt: undefined } : c) }) });
    }
  };

  const setLocalReceivedCount = (taskId: number, companyKey: string, value: number) => {
    setLocalReceivedCounts(prev => ({ ...prev, [taskId]: { ...(prev[taskId] || {}), [companyKey]: value } }));
  };

  const addOrganizationToTask = () => {
    if (!newOrgName.trim() || !selectedTask) return;
    if (!isValidCompany(newOrgName.trim())) { alert('Название организации не должно содержать скобок ( или )'); return; }
    handleUpdateTask(selectedTask.id, { companies: [...normalizeCompanies(selectedTask.companies), { name: newOrgName.trim(), letterCount: 0 }] });
    setNewOrgName('');
  };

  const removeOrganizationFromTask = (index: number) => {
    if (!selectedTask) return;
    handleUpdateTask(selectedTask.id, { companies: normalizeCompanies(selectedTask.companies).filter((_, i) => i !== index) });
  };

  const updateCompanyCount = (index: number, count: number) => {
    if (!selectedTask) return;
    const currentCompanies = normalizeCompanies(selectedTask.companies);
    currentCompanies[index] = { ...currentCompanies[index], letterCount: count };
    handleUpdateTask(selectedTask.id, { companies: currentCompanies });
  };

  const addPostPointToTask = () => {
    if (!selectedTask || !newPointPostOfficeFolder.trim() || !newPointCompanies.trim()) return;
    const selectedOffice = postOffices.find(po => po.folderName === newPointPostOfficeFolder);
    if (!selectedOffice) return;
    const companiesArray = newPointCompanies.split('\n').map(c => c.trim()).filter(c => c.length > 0 && isValidCompany(c)).map(name => ({ name, letterCount: 0 }));
    const newPoint: PostPoint = { id: Date.now(), postAddress: selectedOffice.address, postIndex: selectedOffice.index, companies: companiesArray, postOfficeFolder: selectedOffice.folderName };
    handleUpdateTask(selectedTask.id, { postPoints: [...(selectedTask.postPoints || []), newPoint] });
    setNewPointPostOfficeFolder(''); setNewPointCompanies('');
  };

  const removePostPointFromTask = (pointId: number) => {
    if (!selectedTask) return;
    handleUpdateTask(selectedTask.id, { postPoints: (selectedTask.postPoints || []).filter(p => p.id !== pointId) });
  };

  const addPointToNewComplexTask = () => {
    if (!newPointPostOfficeFolder.trim() || !newPointCompanies.trim()) { alert('Выберите почтовое отделение и добавьте организации'); return; }
    const selectedOffice = postOffices.find(po => po.folderName === newPointPostOfficeFolder);
    if (!selectedOffice) { alert('Почтовое отделение не найдено'); return; }
    const companiesArray = newPointCompanies.split('\n').map(c => c.trim()).filter(c => c.length > 0 && isValidCompany(c)).map(name => ({ name, letterCount: 0 }));
    const newPoint: PostPoint = { id: Date.now(), postAddress: selectedOffice.address, postIndex: selectedOffice.index, companies: companiesArray, postOfficeFolder: selectedOffice.folderName };
    setNewComplexData(prev => ({ ...prev, postPoints: [...prev.postPoints, newPoint] }));
    setNewPointPostOfficeFolder(''); setNewPointCompanies('');
  };

  const removePointFromNewComplexTask = (pointId: number) => {
    setNewComplexData(prev => ({ ...prev, postPoints: prev.postPoints.filter(p => p.id !== pointId) }));
  };

  const handleTaskTypeChange = (newType: TaskType) => {
    if (!selectedTask) return;
    if (!confirm('При смене типа задачи данные могут быть потеряны. Продолжить?')) return;
    handleUpdateTask(selectedTask.id, { type: newType });
  };

  const handlePostOfficeSelect = (folderName: string) => {
    const selectedOffice = postOffices.find(po => po.folderName === folderName);
    if (selectedOffice) {
      const companiesFromClients = getCompaniesFromClientsByPostOffice(folderName);
      setNewPostData({ postOfficeFolder: selectedOffice.folderName, postIndex: selectedOffice.index, postAddress: selectedOffice.address, companiesText: companiesFromClients.map(c => c.name).join('\n') });
      setNewLogistComment(getOfficeNotesMap()[folderName] || '');
    } else {
      setNewPostData({ postOfficeFolder: '', postIndex: '', postAddress: '', companiesText: '' });
    }
  };

  const handlePostOfficeChangeInTask = (folderName: string) => {
    if (!selectedTask) return;
    if (!folderName) { handleUpdateTask(selectedTask.id, { postOfficeFolder: '', postIndex: '', postAddress: '' }); return; }
    const selectedOffice = postOffices.find(po => po.folderName === folderName);
    if (selectedOffice) {
      const companiesFromClients = getCompaniesFromClientsByPostOffice(folderName);
      handleUpdateTask(selectedTask.id, { postOfficeFolder: selectedOffice.folderName, postIndex: selectedOffice.index, postAddress: selectedOffice.address, title: selectedOffice.index + ', ' + selectedOffice.address, companies: companiesFromClients });
    }
  };

  const handlePointPostOfficeSelect = (folderName: string) => {
    setNewPointPostOfficeFolder(folderName);
    const companiesFromClients = getCompaniesFromClientsByPostOffice(folderName);
    if (companiesFromClients.length > 0) setNewPointCompanies(companiesFromClients.map(c => c.name).join('\n'));
    else setNewPointCompanies('');
  };

  const handleClientSelect = (clientIdStr: string) => {
    if (!clientIdStr) { setSelectedClientId(null); return; }
    const client = clients.find(c => c.id === Number(clientIdStr));
    if (client) {
      setSelectedClientId(client.id);
      setNewClientData({ clientCompany: client.companyName, clientAddress: client.address, contactPerson: client.contactPerson, contactPhone: client.phone, clientNote: client.note, timeWindow: newClientData.timeWindow });
      setNewLogistComment(getClientTaskNotesMap()[clientKeyForNote(client.id, client.companyName)] || '');
    }
  };

  const handleComplexClientSelect = (clientIdStr: string) => {
    if (!clientIdStr) { setSelectedComplexClientId(null); return; }
    const client = clients.find(c => c.id === Number(clientIdStr));
    if (client) {
      setSelectedComplexClientId(client.id);
      setNewComplexData(prev => ({ ...prev, officeCompany: client.companyName, officeAddress: client.address, officeContactPerson: client.contactPerson, officeContactPhone: client.phone, clientNote: client.note }));
      setNewLogistComment(getClientTaskNotesMap()[clientKeyForNote(client.id, client.companyName)] || '');
    }
  };

  // 🆕 При выборе клиента в задачу подставляется его тариф
  const handleTaskClientSelect = (clientIdStr: string) => {
    if (!selectedTask) return;
    if (!clientIdStr) { handleUpdateTask(selectedTask.id, { clientId: undefined }); return; }
    const client = clients.find(c => c.id === Number(clientIdStr));
    if (client) {
      const savedNote = getClientTaskNotesMap()[clientKeyForNote(client.id, client.companyName)] || '';
      handleUpdateTask(selectedTask.id, { clientId: client.id, officeCompany: client.companyName, officeAddress: client.address, officeContactPerson: client.contactPerson, officeContactPhone: client.phone, comments: selectedTask.comments || savedNote, taskRate: (client as any).deliveryPickupRate || '' } as any);
    }
  };

  const handleCreateTask = () => {
    const now = new Date();
    const timeString = String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0');
    const currentDate = getTodayString();
    let datesToCreate: string[] = [currentDate];
    let recurrenceGroupId: string | undefined;
    let isRecurring = false;
    if (recurrenceType !== 'none') {
      const generatedDates = generateRecurrenceDates(currentDate, recurrenceEndDate || null, recurrenceType, recurrenceType === 'weekly' ? recurrenceDays : undefined, recurrenceType === 'monthly' ? recurrenceDayOfMonth : undefined);
      if (generatedDates.length === 0) return alert('Не удалось сгенерировать даты повторений.');
      if (generatedDates.length > 100 && !confirm('Будет создано ' + generatedDates.length + ' задач. Продолжить?')) return;
      datesToCreate = generatedDates;
      recurrenceGroupId = 'rec_' + Date.now();
      isRecurring = true;
    }
    const logistComment = newLogistComment.trim();
    const newTasks: Task[] = [];
    datesToCreate.forEach((date, index) => {
      const baseId = Date.now() + index;
      if (newTaskType === 'post') {
        if (!newPostData.postOfficeFolder.trim() || !newPostData.companiesText.trim()) return alert('Выберите почтовое отделение и добавьте организации');
        const selectedOffice = postOffices.find(po => po.folderName === newPostData.postOfficeFolder);
        const companiesArray = newPostData.companiesText.split('\n').map(c => c.trim()).filter(c => c.length > 0 && isValidCompany(c)).map(name => ({ name, letterCount: 0 }));
        const savedNotes = getOfficeNotesMap();
        const finalComment = logistComment || savedNotes[newPostData.postOfficeFolder] || '';
        newTasks.push({ id: baseId, type: 'post', title: newPostData.postIndex + ', ' + newPostData.postAddress, time: timeString, date: date, status: newTaskCourier, workflowStatus: 'new', comments: finalComment, postIndex: selectedOffice?.index || newPostData.postIndex, postAddress: selectedOffice?.address || newPostData.postAddress, postOfficeFolder: newPostData.postOfficeFolder, indexAutoDetected: true, companies: companiesArray, isRecurring, recurrenceType, recurrenceDays: recurrenceType === 'weekly' ? [...recurrenceDays] : undefined, recurrenceDayOfMonth: recurrenceType === 'monthly' ? recurrenceDayOfMonth : undefined, recurrenceEndDate: recurrenceEndDate || undefined, recurrenceGroupId });
      } else if (newTaskType === 'complex') {
        if (!newComplexData.officeCompany.trim() || !newComplexData.postPoints.length) return alert('Заполните данные офиса и добавьте хотя бы одну почтовую точку');
        newTasks.push({ id: baseId, type: 'complex', title: 'Сборная: ' + newComplexData.officeCompany.trim(), time: timeString, date: date, status: newTaskCourier, workflowStatus: 'new', comments: logistComment, officeCompany: newComplexData.officeCompany.trim(), officeAddress: newComplexData.officeAddress.trim(), officeContactPerson: newComplexData.officeContactPerson.trim(), officeContactPhone: newComplexData.officeContactPhone.trim(), timeWindow: newComplexData.timeWindow, clientNote: newComplexData.clientNote.trim(), postPoints: JSON.parse(JSON.stringify(newComplexData.postPoints)), clientId: selectedComplexClientId || undefined, isRecurring, recurrenceType, recurrenceDays: recurrenceType === 'weekly' ? [...recurrenceDays] : undefined, recurrenceDayOfMonth: recurrenceType === 'monthly' ? recurrenceDayOfMonth : undefined, recurrenceEndDate: recurrenceEndDate || undefined, recurrenceGroupId });
      } else if (newTaskType === 'legal_address') {
        if (!newClientData.clientAddress.trim() || !newClientData.clientCompany.trim()) return alert('Заполните юридический адрес и наименование организации');
        newTasks.push({ id: baseId, type: 'legal_address', title: 'Юр. адрес: ' + newClientData.clientCompany.trim(), time: timeString, date: date, status: newTaskCourier, workflowStatus: 'new', comments: logistComment, legalCompanyName: newClientData.clientCompany.trim(), legalAddress: newClientData.clientAddress.trim(), legalContactPerson: newClientData.contactPerson.trim(), legalContactPhone: newClientData.contactPhone.trim(), clientNote: newClientData.clientNote.trim(), clientId: selectedClientId || undefined, isRecurring, recurrenceType, recurrenceDays: recurrenceType === 'weekly' ? [...recurrenceDays] : undefined, recurrenceDayOfMonth: recurrenceType === 'monthly' ? recurrenceDayOfMonth : undefined, recurrenceEndDate: recurrenceEndDate || undefined, recurrenceGroupId });
      } else {
        if (!newClientData.clientAddress.trim() || !newClientData.clientCompany.trim()) return alert('Заполните адрес и наименование организации');
        newTasks.push({ id: baseId, type: newTaskType, title: newClientData.clientAddress.trim(), time: timeString, date: date, status: newTaskCourier, workflowStatus: 'new', comments: logistComment, clientAddress: newClientData.clientAddress.trim(), clientCompany: newClientData.clientCompany.trim(), timeWindow: newClientData.timeWindow, clientNote: newClientData.clientNote.trim(), contactPerson: newClientData.contactPerson.trim(), contactPhone: newClientData.contactPhone.trim(), clientId: selectedClientId || undefined, isRecurring, recurrenceType, recurrenceDays: recurrenceType === 'weekly' ? [...recurrenceDays] : undefined, recurrenceDayOfMonth: recurrenceType === 'monthly' ? recurrenceDayOfMonth : undefined, recurrenceEndDate: recurrenceEndDate || undefined, recurrenceGroupId });
      }
    });
    if (newTasks.length === 0) return;
    if (newTaskType === 'post') {
      if (newPostData.postOfficeFolder) saveOfficeNote(newPostData.postOfficeFolder, logistComment);
    } else if (newTaskType === 'complex') {
      const ck = clientKeyForNote(selectedComplexClientId || undefined, newComplexData.officeCompany);
      if (ck) saveClientTaskNote(ck, logistComment);
    } else if (newTaskType === 'legal_address') {
      const ck = clientKeyForNote(selectedClientId || undefined, newClientData.clientCompany);
      if (ck) saveClientTaskNote(ck, logistComment);
    } else {
      const ck = clientKeyForNote(selectedClientId || undefined, newClientData.clientCompany);
      if (ck) saveClientTaskNote(ck, logistComment);
    }
    setTasks(prev => [...prev, ...newTasks]);
    setNewPostData({ postOfficeFolder: '', postIndex: '', postAddress: '', companiesText: '' });
    setNewClientData({ clientAddress: '', clientCompany: '', timeWindow: '9:00-14:00', clientNote: '', contactPerson: '', contactPhone: '' });
    setNewComplexData({ officeCompany: '', officeAddress: '', officeContactPerson: '', officeContactPhone: '', timeWindow: '9:00-14:00', clientNote: '', postPoints: [] });
    setNewTaskType('post'); setSelectedClientId(null); setSelectedComplexClientId(null); setNewTaskCourier('unassigned');
    setNewLogistComment('');
    setRecurrenceType('none'); setRecurrenceDays([]); setRecurrenceDayOfMonth(1); setRecurrenceEndDate('');
    setIsModalOpen(false);
    if (newTasks.length > 1) alert('✅ Создано ' + newTasks.length + ' задач');
  };

  const resetAllForms = () => {
    setIsModalOpen(false); setNewTaskType('post');
    setNewPostData({ postOfficeFolder: '', postIndex: '', postAddress: '', companiesText: '' });
    setNewClientData({ clientAddress: '', clientCompany: '', timeWindow: '9:00-14:00', clientNote: '', contactPerson: '', contactPhone: '' });
    setNewComplexData({ officeCompany: '', officeAddress: '', officeContactPerson: '', officeContactPhone: '', timeWindow: '9:00-14:00', clientNote: '', postPoints: [] });
    setNewPointPostOfficeFolder(''); setNewPointCompanies(''); setNewOrgName('');
    setSelectedClientId(null); setSelectedComplexClientId(null); setNewTaskCourier('unassigned');
    setNewLogistComment('');
    setRecurrenceType('none'); setRecurrenceDays([]); setRecurrenceDayOfMonth(1); setRecurrenceEndDate('');
  };

  const handleSaveCourier = () => {
    if (!courierForm.name.trim()) return alert('Введите короткое имя курьера');
    if (editingCourier) { setCouriers(couriers.map(c => c.id === editingCourier.id ? { ...c, ...courierForm } : c)); }
    else { setCouriers([...couriers, { id: 'courier_' + Date.now(), ...courierForm }]); }
    setIsCourierModalOpen(false);
  };

  const handleDeleteCourier = (courierId: string) => {
    if (courierId === 'unassigned') return alert('Нельзя удалить системную колонку "Не назначены"');
    const tasksCount = tasks.filter(t => t.status === courierId).length;
    const courier = couriers.find(c => c.id === courierId);
    if (tasksCount > 0 && !confirm('⚠️ У курьера "' + (courier?.name || '') + '" есть ' + tasksCount + ' задач. Продолжить?')) return;
    if (tasksCount > 0) setTasks(prev => prev.map(t => t.status === courierId ? { ...t, status: 'unassigned' } : t));
    setCouriers(couriers.filter(c => c.id !== courierId));
  };

  const handleSaveClient = () => {
    if (!clientForm.companyName.trim()) return alert('Введите наименование организации');
    if (editingClient) { setClients(clients.map(c => c.id === editingClient.id ? { ...c, ...clientForm } : c)); }
    else { setClients([...clients, { id: Date.now(), ...clientForm }]); }
    setIsClientModalOpen(false);
  };

  const handleDeleteClient = (clientId: number) => {
    if (confirm('Удалить клиента "' + (clients.find(c => c.id === clientId)?.companyName || '') + '"?')) setClients(clients.filter(c => c.id !== clientId));
  };

  const filteredClients = clients.filter(c => {
    const q = clientSearch.toLowerCase().trim();
    if (!q) return true;
    return c.companyName.toLowerCase().includes(q) || c.contactPerson.toLowerCase().includes(q) || c.phone.toLowerCase().includes(q) || c.address.toLowerCase().includes(q) || (c.postOffice || '').toLowerCase().includes(q) || (c.holding || '').toLowerCase().includes(q);
  });

  const filteredOffices = (() => {
    const q = officeSearch.toLowerCase().trim();
    if (!q) return postOffices;
    return postOffices.filter(po => {
      const meta = officeMeta[po.folderName];
      if (po.index.toLowerCase().includes(q)) return true;
      if (po.address.toLowerCase().includes(q)) return true;
      if (po.folderName.toLowerCase().includes(q)) return true;
      if (meta && (meta.postmanName || '').toLowerCase().includes(q)) return true;
      if (meta && (meta.comment || '').toLowerCase().includes(q)) return true;
      return false;
    });
  })();

  const totalOfficeClients = filteredOffices.reduce((s, po) => s + getClientsByPostOffice(po.folderName).length, 0);
  const totalOfficeBonus = filteredOffices.reduce((s, po) => s + (parseFloat(officeMeta[po.folderName]?.bonus || '0') || 0), 0);

  const openOfficeEdit = (office: PostOffice) => {
    setEditingOffice(office);
    const meta = officeMeta[office.folderName] || { comment: '', postmanName: '', postmanPhone: '', bonus: '', courierId: '' };
    setOfficeForm({ ...meta, visitDays: (meta as any).visitDays || [] });
    setIsOfficeModalOpen(true);
  };

  const handleSaveOfficeMeta = () => {
    if (!editingOffice) return;
    setOfficeMeta(prev => ({ ...prev, [editingOffice.folderName]: { ...officeForm } }));
    setIsOfficeModalOpen(false);
  };

  // 🆕 Оператор: получение писем (с учётом режима дата/период)
  const operatorTasks = (() => {
    let filtered = tasks.filter(t => {
      if (!matchesOperatorDate(t.date)) return false;
      if (t.type !== 'post' && t.type !== 'complex') return false;
      if (t.completionType === 'no_visit') return false;
      if (t.type === 'post') return normalizeCompanies(t.companies).some(c => !c.operatorConfirmed && (c.receivedCount ?? 0) > 0);
      else if (t.type === 'complex' && t.postPoints) return t.postPoints.some(p => normalizeCompanies(p.companies).some(c => !c.operatorConfirmed && (c.receivedCount ?? 0) > 0));
      return false;
    });
    if (operatorCourierFilter) filtered = filtered.filter(t => t.status === operatorCourierFilter);
    if (operatorSearch.trim()) {
      const q = operatorSearch.toLowerCase().trim();
      filtered = filtered.filter(t => {
        if (t.title.toLowerCase().includes(q)) return true;
        if (t.officeCompany?.toLowerCase().includes(q)) return true;
        const courier = couriers.find(c => c.id === t.status);
        if (courier && ((courier.name + ' ' + (courier.fullName || '')).toLowerCase().includes(q))) return true;
        const allComps = t.type === 'post' ? normalizeCompanies(t.companies) : (t.postPoints || []).flatMap(p => normalizeCompanies(p.companies));
        return allComps.some(c => c.name.toLowerCase().includes(q));
      });
    }
    return sortTasksByStatus(filtered);
  })();

  // 🆕 Оператор: отправка писем (с учётом режима дата/период)
  const operatorSendTasks = (() => {
    let filtered = tasks.filter(t => t.type === 'pickup' && t.sentLetterCount != null);
    filtered = filtered.filter(t => matchesOperatorDate(t.date));
    if (operatorCourierFilter) filtered = filtered.filter(t => t.status === operatorCourierFilter);
    if (operatorSearch.trim()) {
      const q = operatorSearch.toLowerCase().trim();
      filtered = filtered.filter(t => {
        if (t.title.toLowerCase().includes(q)) return true;
        if (t.clientCompany?.toLowerCase().includes(q)) return true;
        if ((t.sendMethod || '').toLowerCase().includes(q)) return true;
        const courier = couriers.find(c => c.id === t.status);
        if (courier && ((courier.name + ' ' + (courier.fullName || '')).toLowerCase().includes(q))) return true;
        return false;
      });
    }
    return filtered.sort((a, b) => (b.sentAt || '').localeCompare(a.sentAt || ''));
  })();

  const operatorSendSummary = (() => {
    const totalLetters = operatorSendTasks.reduce((s, t) => s + (t.sentLetterCount || 0), 0);
    const abs = operatorSendTasks.filter(t => t.sendMethod === 'ABS');
    const ops = operatorSendTasks.filter(t => t.sendMethod === 'OPS');
    return { total: operatorSendTasks.length, totalLetters, absCount: abs.length, absLetters: abs.reduce((s, t) => s + (t.sentLetterCount || 0), 0), opsCount: ops.length, opsLetters: ops.reduce((s, t) => s + (t.sentLetterCount || 0), 0) };
  })();

  // 🆕 Возвраты с учётом режима дата/период + поиск по компании
  const returnsPending = useMemo(() => cashOperations.filter(op => {
    if (op.type !== 'return' || op.compensated) return false;
    if (!matchesOperatorDate(op.date)) return false;
    if (returnCompanySearch.trim()) {
      const q = returnCompanySearch.toLowerCase().trim();
      if (!(op.clientName || '').toLowerCase().includes(q)) return false;
    }
    return true;
  }).sort((a, b) => b.date.localeCompare(a.date)), [cashOperations, operatorDateMode, operatorDate, operatorDateFrom, operatorDateTo, returnCompanySearch]);

  const returnsDone = useMemo(() => cashOperations.filter(op => {
    if (op.type !== 'return' || !op.compensated) return false;
    if (!matchesOperatorDate(op.date)) return false;
    if (returnCompanySearch.trim()) {
      const q = returnCompanySearch.toLowerCase().trim();
      if (!(op.clientName || '').toLowerCase().includes(q)) return false;
    }
    return true;
  }).sort((a, b) => (b.compensated?.at || '').localeCompare(a.compensated?.at || '')), [cashOperations, operatorDateMode, operatorDate, operatorDateFrom, operatorDateTo, returnCompanySearch]);

  const returnsPendingSum = returnsPending.reduce((s, op) => s + op.amount, 0);
  const returnsDoneSum = returnsDone.reduce((s, op) => s + (op.compensated?.amount || 0), 0);

  const handleProcessReturns = () => {
    const selected = returnsPending.filter(op => returnSelected[op.id]);
    if (selected.length === 0) { alert('⚠️ Отметьте хотя бы один возврат'); return; }
    const entries = selected.map(op => ({ op, amt: parseFloat((returnAmounts[op.id] ?? String(op.amount)).replace(',', '.')) }));
    const bad = entries.find(e => isNaN(e.amt) || e.amt <= 0);
    if (bad) { alert('⚠️ Укажите корректную сумму'); return; }
    const nowIso = new Date().toISOString();
    const todayStr = getTodayString();
    const incomeOps: CashOperation[] = entries.map((e, i) => ({ id: Date.now() + i, type: 'income', date: todayStr, amount: e.amt, description: 'Оплата возврата писем (возврат от ' + formatDateShort(e.op.date) + (e.op.letterCount ? ', ' + e.op.letterCount + ' шт.' : '') + ')', clientId: e.op.clientId, clientName: e.op.clientName, paymentMethod: 'cash', createdAt: nowIso }));
    const compMap = new Map<number, { amount: number; at: string; incomeOperationId: number }>();
    entries.forEach((e, i) => compMap.set(e.op.id, { amount: incomeOps[i].amount, at: nowIso, incomeOperationId: incomeOps[i].id }));
    setCashOperations(prev => [...incomeOps, ...prev.map(op => compMap.has(op.id) ? { ...op, compensated: compMap.get(op.id) } : op)]);
    const total = incomeOps.reduce((s, o) => s + o.amount, 0);
    setReturnSelected({});
    setReturnAmounts({});
    alert('✅ Создано приходов в кассе: ' + incomeOps.length + ' на сумму ' + formatMoney(total));
  };

  const archivedData = (() => {
    const result: { task: Task; courier: Courier | undefined; companies: { company: CompanyItem; companyKey: string; pointTitle?: string }[] }[] = [];
    tasks.forEach(task => {
      if (task.type !== 'post' && task.type !== 'complex') return;
      const companies: { company: CompanyItem; companyKey: string; pointTitle?: string }[] = [];
      if (task.type === 'post') { normalizeCompanies(task.companies).forEach((c, idx) => { if (c.operatorConfirmed) companies.push({ company: c, companyKey: 'post-' + idx, pointTitle: task.postIndex + ', ' + task.postAddress }); }); }
      else if (task.type === 'complex' && task.postPoints) { task.postPoints.forEach((point, pIdx) => { normalizeCompanies(point.companies).forEach((c, cIdx) => { if (c.operatorConfirmed) companies.push({ company: c, companyKey: 'point-' + pIdx + '-comp-' + cIdx, pointTitle: point.postIndex + ', ' + point.postAddress }); }); }); }
      if (companies.length > 0) result.push({ task, courier: couriers.find(c => c.id === task.status), companies });
    });
    let filtered = result;
    if (archiveSearch.trim()) {
      const q = archiveSearch.toLowerCase().trim();
      filtered = filtered.filter(item => {
        if (item.task.title.toLowerCase().includes(q)) return true;
        if (item.courier && (item.courier.name + ' ' + (item.courier.fullName || '')).toLowerCase().includes(q)) return true;
        return item.companies.some(c => c.company.name.toLowerCase().includes(q));
      });
    }
    return filtered.sort((a, b) => {
      const dateA = a.companies.map(c => c.company.confirmedAt || '').sort().reverse()[0] || a.task.date;
      const dateB = b.companies.map(c => c.company.confirmedAt || '').sort().reverse()[0] || b.task.date;
      return dateB.localeCompare(dateA);
    });
  })();

  const refreshAllScans = async () => { try { setAllScans(await idbGetAllScans()); } catch (e) { console.error(e); } };

  useEffect(() => {
    if (isLoaded && currentPage === 'operator') refreshAllScans();
  }, [currentPage, operatorTab, isLoaded]);

  const scansFor = (taskId: number, key: string) => allScans.filter(s => s.taskId === taskId && s.companyKey === key).sort((a, b) => a.id.localeCompare(b.id));

  const handleSaveScanApiUrl = (url: string) => { setScanApiUrl(url); localStorage.setItem('logistics_scan_api_url', url); };

  const handleSendScansApi = async (task: Task, key: string, companyName: string, count: number) => {
    const url = scanApiUrl.trim();
    if (!url) { alert('⚠️ Укажите адрес API'); return; }
    const list = scansFor(task.id, key);
    if (list.length === 0) { alert('⚠️ Нет сканов'); return; }
    const mapKey = task.id + '|' + key;
    setScanSendStatus(prev => ({ ...prev, [mapKey]: '⏳ Отправка...' }));
    try {
      const courier = couriers.find(c => c.id === task.status);
      const sentAt = new Date().toISOString();
      const payload = { source: 'logistics-board', sentAt, task: { id: task.id, title: task.title, date: task.date, type: task.type, courier: courier ? (courier.fullName || courier.name) : null }, company: { key, name: companyName, letterCount: count }, scans: list.map(s => ({ id: s.id, createdAt: s.createdAt, width: s.width, height: s.height, mimeType: 'image/jpeg', imageBase64: s.dataUrl.split(',')[1] })) };
      const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const marked = list.map(s => ({ ...s, sentAt }));
      for (const m of marked) await idbPutScan(m);
      setAllScans(prev => prev.map(s => marked.find(mm => mm.id === s.id) || s));
      setScanSendStatus(prev => ({ ...prev, [mapKey]: '✅ Отправлено (' + marked.length + ')' }));
    } catch (e) {
      setScanSendStatus(prev => ({ ...prev, [mapKey]: '❌ Ошибка отправки' }));
      alert('⚠️ Ошибка: ' + (e as Error).message);
    }
  };

  const handleOperatorDeleteScan = async (rec: ScanRecord) => {
    if (!confirm('Удалить этот скан?')) return;
    try { await idbDeleteScan(rec.id); setAllScans(prev => prev.filter(s => s.id !== rec.id)); if (lightboxScan?.id === rec.id) setLightboxScan(null); } catch (e) { console.error(e); }
  };

  const handleOperatorRotateScan = (rec: ScanRecord) => {
    const img = new Image();
    img.onload = async () => {
      const canvas = document.createElement('canvas');
      canvas.width = img.height; canvas.height = img.width;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      ctx.translate(canvas.width / 2, canvas.height / 2);
      ctx.rotate(Math.PI / 2);
      ctx.drawImage(img, -img.width / 2, -img.height / 2);
      const updated: ScanRecord = { ...rec, dataUrl: canvas.toDataURL('image/jpeg', 0.85), width: canvas.width, height: canvas.height };
      try { await idbPutScan(updated); setAllScans(prev => prev.map(s => s.id === rec.id ? updated : s)); if (lightboxScan?.id === rec.id) setLightboxScan(updated); } catch (e) { console.error(e); }
    };
    img.src = rec.dataUrl;
  };

  const handleOperatorAddScanFile = (taskId: number, key: string, file: File) => {
    const reader = new FileReader();
    reader.onload = () => {
      const dataUrl = String(reader.result);
      const img = new Image();
      img.onload = async () => {
        const rec: ScanRecord = { id: taskId + '|' + key + '|op' + Date.now(), taskId, companyKey: key, dataUrl, width: img.naturalWidth, height: img.naturalHeight, createdAt: new Date().toISOString() };
        try { await idbPutScan(rec); setAllScans(prev => [...prev, rec]); } catch (e) { console.error(e); }
      };
      img.src = dataUrl;
    };
    reader.readAsDataURL(file);
  };

  const courierTasks = (() => {
    if (!courierViewId || !today) return [];
    let filtered = tasks.filter(t => t.date === today && t.status === courierViewId);
    if (courierFilter !== 'all') filtered = filtered.filter(t => t.workflowStatus === courierFilter);
    return filtered.sort(boardComparator);
  })();

  const courierStats = (() => {
    if (!courierViewId || !today) return { all: 0, new: 0, in_progress: 0, completed: 0 };
    const myTasks = tasks.filter(t => t.date === today && t.status === courierViewId);
    return { all: myTasks.length, new: myTasks.filter(t => t.workflowStatus === 'new').length, in_progress: myTasks.filter(t => t.workflowStatus === 'in_progress').length, completed: myTasks.filter(t => t.workflowStatus === 'completed').length };
  })();

  const courierPostmen = useMemo(() => {
    if (!courierViewId) return [];
    return postOffices
      .map(po => {
        const meta = officeMeta[po.folderName];
        if (!meta || meta.courierId !== courierViewId) return null;
        if (!meta.postmanName?.trim() && !meta.postmanPhone?.trim()) return null;
        const clientsCount = getClientsByPostOffice(po.folderName).length;
        return {
          folderName: po.folderName,
          index: po.index,
          address: po.address,
          postmanName: meta.postmanName || '',
          postmanPhone: meta.postmanPhone || '',
          bonus: meta.bonus || '',
          comment: meta.comment || '',
          clientsCount,
          visitDays: (meta as any).visitDays || [],
        };
      })
      .filter((x): x is NonNullable<typeof x> => x !== null)
      .sort((a, b) => a.index.localeCompare(b.index));
  }, [courierViewId, postOffices, officeMeta, clients]);

  const handleCourierTaskStatusChange = (task: Task, newStatus: TaskWorkflowStatus) => {
    if (newStatus === 'completed' && task.workflowStatus !== 'completed') {
      if (task.type === 'post' || task.type === 'complex') {
        setCourierSelectedTask(task);
        const initialCounts: Record<string, number> = {};
        if (task.type === 'post') { normalizeCompanies(task.companies).forEach((c, idx) => { initialCounts['post-' + idx] = 0; }); }
        else if (task.type === 'complex' && task.postPoints) { task.postPoints.forEach((point, pIdx) => { normalizeCompanies(point.companies).forEach((c, cIdx) => { initialCounts['point-' + pIdx + '-comp-' + cIdx] = 0; }); }); }
        setCourierLocalCounts(initialCounts);
        setTaskScans({});
        sessionScanIdsRef.current = [];
        setIsCourierConfirmModalOpen(true);
        return;
      }
    }
    const extra = completionFieldsFor(task, newStatus);
    handleUpdateTask(task.id, { workflowStatus: newStatus, ...extra });
    if (courierSelectedTask?.id === task.id) setCourierSelectedTask({ ...task, workflowStatus: newStatus, ...extra });
  };

  const handleOpenNoVisit = (task: Task) => { setNoVisitTask(task); setNoVisitComment(''); setIsNoVisitModalOpen(true); };

  const handleConfirmNoVisit = () => {
    if (!noVisitTask) return;
    const reason = noVisitComment.trim();
    if (!reason) { alert('⚠️ Обязательно укажите причину'); return; }
    handleUpdateTask(noVisitTask.id, { workflowStatus: 'completed', completionType: 'no_visit', noVisitReason: reason, completedAt: new Date().toISOString() });
    setIsNoVisitModalOpen(false);
    setNoVisitTask(null);
    setNoVisitComment('');
  };

  const handleCourierCancelReceived = async () => {
    const ids = sessionScanIdsRef.current;
    sessionScanIdsRef.current = [];
    for (const id of ids) { try { await idbDeleteScan(id); } catch (e) { console.error(e); } }
    setIsCourierConfirmModalOpen(false);
    setCourierSelectedTask(null);
    setCourierLocalCounts({});
    setTaskScans({});
  };

  const handleCourierConfirmReceived = () => {
    if (!courierSelectedTask) return;
    const updates: Partial<Task> = { workflowStatus: 'completed', completionType: 'visited', completedAt: new Date().toISOString() };
    if (courierSelectedTask.type === 'post') { updates.companies = normalizeCompanies(courierSelectedTask.companies).map((c, idx) => ({ ...c, receivedCount: courierLocalCounts['post-' + idx] ?? 0, operatorConfirmed: false })); }
    else if (courierSelectedTask.type === 'complex' && courierSelectedTask.postPoints) { updates.postPoints = courierSelectedTask.postPoints.map((point, pIdx) => ({ ...point, companies: normalizeCompanies(point.companies).map((c, cIdx) => ({ ...c, receivedCount: courierLocalCounts['point-' + pIdx + '-comp-' + cIdx] ?? 0, operatorConfirmed: false })) })); }
    handleUpdateTask(courierSelectedTask.id, updates);
    sessionScanIdsRef.current = [];
    setIsCourierConfirmModalOpen(false); setCourierSelectedTask(null); setCourierLocalCounts({}); setTaskScans({});
  };

  const handleCourierOpenSendModal = (task: Task) => { setSendModalTask(task); setSendLetterCount(''); setSendMethod(''); setIsCourierSendModalOpen(true); };

  const handleCourierConfirmSend = () => {
    if (!sendModalTask) return;
    if (sendLetterCount.trim() === '') { alert('⚠️ Укажите количество писем'); return; }
    const count = parseInt(sendLetterCount);
    if (isNaN(count) || count < 0) { alert('⚠️ Некорректное количество'); return; }
    if (!sendMethod) { alert('⚠️ Выберите способ отправки'); return; }
    const nowIso = new Date().toISOString();
    handleUpdateTask(sendModalTask.id, { workflowStatus: 'completed', completionType: 'visited', completedAt: nowIso, sentLetterCount: count, sendMethod: sendMethod, sentAt: nowIso });
    setIsCourierSendModalOpen(false);
    setSendModalTask(null);
    setSendLetterCount('');
    setSendMethod('');
  };

  const getTaskReceivedLetters = (t: Task): number => {
    if (t.type === 'post') return normalizeCompanies(t.companies).reduce((s, c) => s + (c.receivedCount ?? 0), 0);
    if (t.type === 'complex') return (t.postPoints || []).flatMap(p => normalizeCompanies(p.companies)).reduce((s, c) => s + (c.receivedCount ?? 0), 0);
    return 0;
  };

  const clientsWithNoLetters = useMemo(() => {
    type Row = { client: Client; tasks: Task[] };
    const q = reportSearch.toLowerCase().trim();
    const result: Row[] = [];
    clients.forEach(client => {
      const clientName = client.companyName.toLowerCase().trim();
      if (!clientName) return;
      const clientTasks = tasks.filter(t => {
        if (reportDateFrom && t.date < reportDateFrom) return false;
        if (reportDateTo && t.date > reportDateTo) return false;
        if (reportCourierFilter && t.status !== reportCourierFilter) return false;
        if (t.clientId === client.id) return true;
        if (t.clientCompany && t.clientCompany.toLowerCase().trim() === clientName) return true;
        if (t.officeCompany && t.officeCompany.toLowerCase().trim() === clientName) return true;
        if (t.type === 'post' && t.companies) {
          if (t.companies.some(c => { const n = typeof c === 'string' ? c : c.name; return n.toLowerCase().trim() === clientName; })) return true;
        }
        if (t.type === 'complex' && t.postPoints) {
          for (const p of t.postPoints) {
            if (p.companies.some(c => { const n = typeof c === 'string' ? c : c.name; return n.toLowerCase().trim() === clientName; })) return true;
          }
        }
        return false;
      });
      if (clientTasks.length === 0) return;
      const allZero = clientTasks.every(t => {
        if (t.type === 'post') {
          const comps = (t.companies || []).filter(c => { const n = typeof c === 'string' ? c : c.name; return n.toLowerCase().trim() === clientName; });
          return comps.length === 0 || comps.every(c => (c.receivedCount ?? 0) === 0);
        }
        if (t.type === 'complex' && t.postPoints) {
          for (const p of t.postPoints) {
            const comps = p.companies.filter(c => { const n = typeof c === 'string' ? c : c.name; return n.toLowerCase().trim() === clientName; });
            if (comps.length > 0 && !comps.every(c => (c.receivedCount ?? 0) === 0)) return false;
          }
          return true;
        }
        if (t.type === 'pickup') return (t.sentLetterCount ?? 0) === 0;
        return true;
      });
      if (!allZero) return;
      if (q) {
        if (!client.companyName.toLowerCase().includes(q) &&
          !client.address.toLowerCase().includes(q) &&
          !(client.postOffice || '').toLowerCase().includes(q) &&
          !(client.holding || '').toLowerCase().includes(q)) return;
      }
      result.push({ client, tasks: clientTasks });
    });
    return result.sort((a, b) => a.client.companyName.localeCompare(b.client.companyName));
  }, [clients, tasks, reportDateFrom, reportDateTo, reportCourierFilter, reportSearch]);

  const reportTasks = useMemo(() => {
    const q = reportSearch.toLowerCase().trim();
    return tasks.filter(t => {
      if (reportDateFrom && t.date < reportDateFrom) return false;
      if (reportDateTo && t.date > reportDateTo) return false;
      if (reportCourierFilter && t.status !== reportCourierFilter) return false;
      if (reportTypeFilter && t.type !== reportTypeFilter) return false;
      if (reportStatusFilter && t.workflowStatus !== reportStatusFilter) return false;
      if (reportCompletionFilter === 'visited' && !(t.workflowStatus === 'completed' && t.completionType !== 'no_visit')) return false;
      if (reportCompletionFilter === 'no_visit' && t.completionType !== 'no_visit') return false;
      if (q) {
        const courier = couriers.find(c => c.id === t.status);
        const parts: (string | undefined)[] = [t.title, t.clientCompany, t.clientAddress, t.officeCompany, t.officeAddress, t.comments, t.courierComments, t.noVisitReason, t.postIndex, t.postAddress, courier?.name, courier?.fullName];
        if (t.companies) t.companies.forEach(c => parts.push(typeof c === 'string' ? c : c.name));
        if (t.postPoints) t.postPoints.forEach(p => {
          parts.push(p.postIndex, p.postAddress);
          p.companies.forEach(c => parts.push(typeof c === 'string' ? c : c.name));
        });
        if (!parts.filter(Boolean).join(' ').toLowerCase().includes(q)) return false;
      }
      return true;
    }).sort((a, b) => { const d = b.date.localeCompare(a.date); if (d !== 0) return d; return b.id - a.id; });
  }, [tasks, couriers, reportDateFrom, reportDateTo, reportCourierFilter, reportTypeFilter, reportStatusFilter, reportCompletionFilter, reportSearch]);

  const reportSummary = useMemo(() => {
    let completedVisited = 0, completedNoVisit = 0, inProgress = 0, newTasks = 0, lettersReceived = 0, lettersSent = 0;
    reportTasks.forEach(t => {
      if (t.workflowStatus === 'completed') {
        if (t.completionType === 'no_visit') { completedNoVisit++; }
        else { completedVisited++; lettersReceived += getTaskReceivedLetters(t); lettersSent += t.sentLetterCount ?? 0; }
      } else if (t.workflowStatus === 'in_progress') inProgress++;
      else newTasks++;
    });
    return { total: reportTasks.length, completedVisited, completedNoVisit, inProgress, newTasks, lettersReceived, lettersSent };
  }, [reportTasks]);

  const reportByCourier = useMemo(() => {
    const map = new Map<string, { id: string; name: string; total: number; completedVisited: number; completedNoVisit: number; inProgress: number; newCount: number; lettersReceived: number; lettersSent: number }>();
    reportTasks.forEach(t => {
      const courier = couriers.find(c => c.id === t.status);
      const key = t.status;
      if (!map.has(key)) map.set(key, { id: key, name: courier?.fullName || courier?.name || 'Не назначен', total: 0, completedVisited: 0, completedNoVisit: 0, inProgress: 0, newCount: 0, lettersReceived: 0, lettersSent: 0 });
      const row = map.get(key)!;
      row.total++;
      if (t.workflowStatus === 'completed') {
        if (t.completionType === 'no_visit') row.completedNoVisit++;
        else { row.completedVisited++; row.lettersReceived += getTaskReceivedLetters(t); row.lettersSent += t.sentLetterCount ?? 0; }
      } else if (t.workflowStatus === 'in_progress') row.inProgress++;
      else row.newCount++;
    });
    return Array.from(map.values()).sort((a, b) => b.total - a.total);
  }, [reportTasks, couriers]);

  const setReportPeriod = (preset: 'today' | 'week' | 'month' | 'all') => {
    const fmt = (d: Date) => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    const now = new Date();
    if (preset === 'today') { setReportDateFrom(fmt(now)); setReportDateTo(fmt(now)); }
    else if (preset === 'week') { const start = new Date(now); start.setDate(now.getDate() - 6); setReportDateFrom(fmt(start)); setReportDateTo(fmt(now)); }
    else if (preset === 'month') { const start = new Date(now.getFullYear(), now.getMonth(), 1); setReportDateFrom(fmt(start)); setReportDateTo(fmt(now)); }
    else { setReportDateFrom(''); setReportDateTo(''); }
  };

  const handleExportReport = () => {
    if (reportTasks.length === 0) { alert('⚠️ Нет данных для экспорта'); return; }
    const typeLabels: Record<TaskType, string> = { post: 'Почта', delivery: 'Доставка', pickup: 'Отправка', complex: 'Сборная', legal_address: 'Юр. адрес' };
    const statusLabels: Record<TaskWorkflowStatus, string> = { new: 'Новая', in_progress: 'В работе', completed: 'Завершена' };
    const wb = XLSX.utils.book_new();
    const detailRows = [
      ['Дата', 'Курьер', 'Тип', 'Задача', 'Писем получено', 'Писем отправлено', 'Статус', 'Способ завершения', 'Причина / комментарий', 'Время завершения'],
      ...reportTasks.map(t => {
        const courier = couriers.find(c => c.id === t.status);
        return [
          formatDateShort(t.date), courier?.fullName || courier?.name || 'Не назначен', typeLabels[t.type], t.title,
          getTaskReceivedLetters(t) || '', t.sentLetterCount ?? '', statusLabels[t.workflowStatus],
          t.workflowStatus === 'completed' ? (t.completionType === 'no_visit' ? 'БЕЗ ПОСЕЩЕНИЯ' : 'С посещением') : '',
          t.noVisitReason || t.courierComments || t.comments || '',
          t.completedAt ? new Date(t.completedAt).toLocaleString('ru-RU') : '',
        ];
      }),
    ];
    XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(detailRows), 'Отчёт');
    const summaryRows = [
      ['Курьер', 'Всего задач', 'Завершено (с посещением)', 'Завершено (без посещения)', 'В работе', 'Новые', 'Писем получено', 'Писем отправлено'],
      ...reportByCourier.map(r => [r.name, r.total, r.completedVisited, r.completedNoVisit, r.inProgress, r.newCount, r.lettersReceived, r.lettersSent]),
    ];
    XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(summaryRows), 'По курьерам');
    XLSX.writeFile(wb, 'Отчёт_курьеры_' + (reportDateFrom || 'все_даты') + '_' + (reportDateTo || 'по_сейчас') + '.xlsx');
  };

  const openYandexRoute = () => {
    const addresses: string[] = [];
    courierTasks.forEach(t => {
      if (t.type === 'post' && t.postAddress) addresses.push(t.postAddress);
      else if (t.type === 'delivery' || t.type === 'pickup') {
        if (t.clientAddress) addresses.push(t.clientAddress);
      } else if (t.type === 'complex') {
        if (t.postPoints) t.postPoints.forEach(p => { if (p.postAddress) addresses.push(p.postAddress); });
        if (t.officeAddress) addresses.push(t.officeAddress);
      }
    });
    if (addresses.length === 0) { alert('⚠️ Нет адресов для построения маршрута'); return; }
    const seen = new Set<string>();
    const unique: string[] = [];
    addresses.forEach(a => {
      const key = a.trim().toLowerCase();
      if (!seen.has(key)) { seen.add(key); unique.push(a); }
    });
    const rtext = unique.map(a => encodeURIComponent(a)).join('~');
    const url = 'https://yandex.ru/maps/?rtext=' + rtext + '&rtt=auto';
    window.open(url, '_blank');
  };

  const getActiveVideo = () => (scannerMode === 'modal' ? videoModalRef.current : videoTabRef.current);

  const captureScan = () => {
    const video = getActiveVideo();
    if (!video || video.videoWidth === 0) return;
    const maxW = 1600;
    const scale = Math.min(1, maxW / video.videoWidth);
    const w = Math.round(video.videoWidth * scale);
    const h = Math.round(video.videoHeight * scale);
    const canvas = document.createElement('canvas');
    canvas.width = w; canvas.height = h;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    ctx.drawImage(video, 0, 0, w, h);
    const dataUrl = canvas.toDataURL('image/jpeg', 0.85);
    if (scannerMode === 'modal' && scanTargetKey && courierSelectedTask) {
      const key = scanTargetKey;
      const rec: ScanRecord = { id: courierSelectedTask.id + '|' + key + '|' + (scanIdRef.current++), taskId: courierSelectedTask.id, companyKey: key, dataUrl, width: w, height: h, createdAt: new Date().toISOString() };
      idbPutScan(rec).catch(e => console.error(e));
      sessionScanIdsRef.current.push(rec.id);
      const arr = [...(taskScans[key] || []), rec];
      setTaskScans(prev => ({ ...prev, [key]: [...(prev[key] || []), rec] }));
      setCourierLocalCounts(prev => ({ ...prev, [key]: arr.length }));
    } else {
      setScans(prev => [...prev, { id: scanIdRef.current++, dataUrl, width: w, height: h }]);
    }
    setScannerStatus('✅ Кадр захвачен (' + w + '×' + h + ')');
  };

  const removeTaskScan = (key: string, id: string) => {
    idbDeleteScan(id).catch(e => console.error(e));
    sessionScanIdsRef.current = sessionScanIdsRef.current.filter(x => x !== id);
    const arr = (taskScans[key] || []).filter(s => s.id !== id);
    setTaskScans(prev => ({ ...prev, [key]: arr }));
    setCourierLocalCounts(prev => ({ ...prev, [key]: arr.length }));
  };

  const startScanner = async (mode: 'tab' | 'modal', targetKey?: string, targetLabel?: string) => {
    try {
      setScannerStatus('⏳ Запуск камеры...');
      const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' }, audio: false });
      streamRef.current = stream;
      setScannerMode(mode);
      if (mode === 'modal') { setScanTargetKey(targetKey || null); setScanTargetLabel(targetLabel || ''); }
      setScannerStatus('📷 Камера активна');
      setTimeout(() => {
        const v = mode === 'modal' ? videoModalRef.current : videoTabRef.current;
        if (v) { v.srcObject = stream; v.play().catch(() => {}); }
      }, 60);
    } catch (e) {
      setScannerMode(null);
      setScannerStatus('⚠️ Камера недоступна');
      alert('⚠️ Не удалось получить доступ к камере: ' + (e as Error).message);
    }
  };

  const stopScanner = () => {
    streamRef.current?.getTracks().forEach(t => t.stop());
    streamRef.current = null;
    setScannerMode(null);
    setScanTargetKey(null);
    setScanTargetLabel('');
    prevFrameRef.current = null;
    stableCountRef.current = 0;
    setScannerStatus('');
  };

  const toggleModalScan = (key: string, label: string) => {
    if (scannerMode === 'modal' && scanTargetKey === key) { stopScanner(); return; }
    stopScanner();
    startScanner('modal', key, label);
  };

  useEffect(() => {
    if (!scannerMode || !autoCapture) return;
    const interval = setInterval(() => {
      const video = getActiveVideo();
      if (!video || video.readyState < 2) return;
      const W = 48, H = 36;
      const off = document.createElement('canvas');
      off.width = W; off.height = H;
      const ctx = off.getContext('2d', { willReadFrequently: true });
      if (!ctx) return;
      ctx.drawImage(video, 0, 0, W, H);
      const frame = ctx.getImageData(0, 0, W, H);
      const gray = new Float32Array(W * H);
      let mean = 0;
      let diff = 0;
      const prev = prevFrameRef.current;
      for (let i = 0; i < W * H; i++) {
        gray[i] = 0.299 * frame.data[i * 4] + 0.587 * frame.data[i * 4 + 1] + 0.114 * frame.data[i * 4 + 2];
        mean += gray[i];
        if (prev) diff += Math.abs(gray[i] - prev[i]);
      }
      mean /= W * H;
      let variance = 0;
      for (let i = 0; i < W * H; i++) variance += (gray[i] - mean) * (gray[i] - mean);
      const std = Math.sqrt(variance / (W * H));
      const avgDiff = prev ? diff / (W * H) : 999;
      prevFrameRef.current = gray;
      if (avgDiff < 2.2 && std > 18) stableCountRef.current += 1;
      else stableCountRef.current = 0;
      if (stableCountRef.current >= 8 && Date.now() - lastAutoCaptureRef.current > 3000) {
        stableCountRef.current = 0;
        lastAutoCaptureRef.current = Date.now();
        captureScan();
      }
    }, 180);
    return () => clearInterval(interval);
  }, [scannerMode, autoCapture, scanTargetKey]);

  useEffect(() => {
    if (scannerMode === 'tab' && (courierSubTab !== 'scanner' || currentPage !== 'courier')) stopScanner();
  }, [courierSubTab, currentPage, scannerMode]);

  useEffect(() => () => { streamRef.current?.getTracks().forEach(t => t.stop()); }, []);

  const saveScansList = (list: ScanImage[], nameBase: string) => {
    if (list.length === 0) { alert('⚠️ Нет сканов'); return; }
    if (scannerFormat === 'jpeg') {
      list.forEach((s, i) => {
        const a = document.createElement('a');
        a.href = s.dataUrl;
        a.download = nameBase + '_' + (i + 1) + '.jpg';
        a.click();
      });
    } else {
      const blob = buildPdfFromScans(list);
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = nameBase + '.pdf';
      a.click();
      setTimeout(() => URL.revokeObjectURL(url), 5000);
    }
  };

  const saveScans = () => {
    saveScansList(scans, 'scans_' + getTodayString());
    alert('✅ Сохранено ' + scans.length + ' скан(ов) в формате ' + scannerFormat.toUpperCase());
  };

  const resetCashForm = () => {
    setCashForm({ type: 'income', date: getTodayString(), amount: '', description: '', clientId: '', employeeName: '', expenseArticle: '', letterCount: '', paymentMethod: 'cash' });
  };

  const handleOpenCashModal = () => { resetCashForm(); setIsCashModalOpen(true); };

  const handleSaveCashOperation = () => {
    const amount = parseFloat(cashForm.amount.replace(',', '.'));
    if (isNaN(amount) || amount <= 0) { alert('⚠️ Укажите корректную сумму'); return; }
    if (!cashForm.date) { alert('⚠️ Укажите дату'); return; }
    const finalPaymentMethod = cashForm.type === 'other' ? 'cash' : cashForm.paymentMethod;
    const operation: CashOperation = { id: Date.now(), type: cashForm.type, date: cashForm.date, amount: amount, description: cashForm.description.trim(), paymentMethod: finalPaymentMethod, createdAt: new Date().toISOString() };
    if (cashForm.type === 'income' || cashForm.type === 'return') {
      if (!cashForm.clientId) { alert('⚠️ Выберите клиента'); return; }
      const client = clients.find(c => c.id === Number(cashForm.clientId));
      if (!client) { alert('⚠️ Клиент не найден'); return; }
      operation.clientId = client.id;
      operation.clientName = client.companyName;
      if (cashForm.type === 'return') {
        const lc = parseInt(cashForm.letterCount);
        operation.letterCount = isNaN(lc) || lc < 0 ? 0 : lc;
      }
    } else if (cashForm.type === 'travel' || cashForm.type === 'power_of_attorney') {
      if (!cashForm.employeeName.trim()) { alert('⚠️ Укажите ФИО'); return; }
      operation.employeeName = cashForm.employeeName.trim();
    } else if (cashForm.type === 'other') {
      if (!cashForm.expenseArticle.trim()) { alert('⚠️ Укажите статью'); return; }
      operation.expenseArticle = cashForm.expenseArticle.trim();
    }
    setCashOperations(prev => [operation, ...prev]);
    setIsCashModalOpen(false);
    resetCashForm();
  };

  const handleDeleteCashOperation = (id: number) => {
    const op = cashOperations.find(o => o.id === id);
    if (!op) return;
    if (!confirm('Удалить операцию "' + CASH_OPERATION_META[op.type].label + '" на сумму ' + formatMoney(op.amount) + '?')) return;
    setCashOperations(prev => prev.filter(o => o.id !== id));
  };

  const filteredCashOperations = useMemo(() => {
    return cashOperations.filter(op => {
      if (op.date < cashDateFrom || op.date > cashDateTo) return false;
      if (cashTypeFilter && op.type !== cashTypeFilter) return false;
      if (cashPaymentFilter && op.paymentMethod !== cashPaymentFilter) return false;
      if (cashClientFilter && String(op.clientId) !== cashClientFilter) return false;
      return true;
    }).sort((a, b) => { const d = b.date.localeCompare(a.date); if (d !== 0) return d; return b.id - a.id; });
  }, [cashOperations, cashDateFrom, cashDateTo, cashTypeFilter, cashPaymentFilter, cashClientFilter]);

  const cashSummary = useMemo(() => {
    let income = 0, cashExpense = 0, invoiceExpense = 0;
    const byPaymentMethod: Record<PaymentMethod, { count: number; total: number }> = {
      cash: { count: 0, total: 0 }, invoice_104: { count: 0, total: 0 }, corporate_card: { count: 0, total: 0 },
    };
    filteredCashOperations.forEach(op => {
      if (op.paymentMethod) { byPaymentMethod[op.paymentMethod].count++; byPaymentMethod[op.paymentMethod].total += op.amount; }
      if (CASH_OPERATION_META[op.type].flow === 'in') income += op.amount;
      else if (op.paymentMethod === 'cash') cashExpense += op.amount;
      else invoiceExpense += op.amount;
    });
    return { income, cashExpense, invoiceExpense, balance: income - cashExpense, byPaymentMethod, totalOperations: filteredCashOperations.length };
  }, [filteredCashOperations]);

  const handleExportCash = () => {
    if (filteredCashOperations.length === 0) { alert('Нет данных для экспорта'); return; }
    const wb = XLSX.utils.book_new();
    const rows = [
      ['Дата', 'Тип операции', 'Приход', 'Расход (наличные)', 'Расход (по счетам)', 'Способ оплаты', 'Клиент', 'Сотрудник', 'Статья расходов', 'Кол-во писем', 'Описание'],
      ...filteredCashOperations.map(op => {
        const isIn = CASH_OPERATION_META[op.type].flow === 'in';
        const isCashExp = !isIn && op.paymentMethod === 'cash';
        const isInvExp = !isIn && op.paymentMethod !== 'cash';
        return [formatDateShort(op.date), CASH_OPERATION_META[op.type].label, isIn ? op.amount : '', isCashExp ? op.amount : '', isInvExp ? op.amount : '', op.paymentMethod ? PAYMENT_METHOD_META[op.paymentMethod].label : '', op.clientName || '', op.employeeName || '', op.expenseArticle || '', op.letterCount ?? '', op.description || ''];
      }),
      [],
      ['ИТОГО:', '', cashSummary.income, cashSummary.cashExpense, cashSummary.invoiceExpense, '', '', '', '', '', 'Баланс (наличные): ' + formatMoney(cashSummary.balance)],
    ];
    XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(rows), 'Касса');
    XLSX.writeFile(wb, 'Касса_' + cashDateFrom + '_' + cashDateTo + '.xlsx');
  };
if (!isLoaded) {
  return <div className="app" data-theme={theme} suppressHydrationWarning><div className="empty" style={{ margin: 40 }}>Загрузка панели...</div></div>;
}

  const currentCourier = couriers.find(c => c.id === courierViewId);
  const toggleTheme = () => setTheme(t => t === 'light' ? 'dark' : 'light');

  return (
    <div className="app" data-theme={theme} suppressHydrationWarning>
      {/* ================= ШАПКА ================= */}
      <header className="topbar">
        <div className="topbar-left">
          <div className="brand">
            <div className="brand-logo">📦</div>
            <span>Логистика</span>
          </div>

          <nav className="nav">
            {canPage('board') && <button onClick={() => { setCurrentPage('board'); setCourierWeekView(null); }} className={`nav-btn ${currentPage === 'board' && !courierWeekView ? 'active' : ''}`}>📋 Задачи</button>}
            {canPage('courier') && <button onClick={() => setCurrentPage('courier')} className={`nav-btn ${currentPage === 'courier' ? 'active' : ''}`}>🚚 Курьер</button>}
            {canPage('operator') && <button onClick={() => setCurrentPage('operator')} className={`nav-btn ${currentPage === 'operator' ? 'active' : ''}`}>👨 Оператор</button>}
            {canPage('admin') && <button onClick={() => setCurrentPage('admin')} className={`nav-btn ${currentPage === 'admin' ? 'active' : ''}`}>⚙️ Админ</button>}
            <a href="/map" className="nav-btn">🗺️ Карта</a>
          </nav>

          {currentPage === 'board' && !courierWeekView && (
            <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
              <input type="date" value={selectedDate} onChange={(e) => setSelectedDate(e.target.value)} className="date-input" />
              <span className="muted" style={{ fontSize: 12 }} suppressHydrationWarning>({formatDateLong(selectedDate)})</span>
            </div>
          )}

          {currentPage === 'board' && courierWeekView && (
            <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
              <button onClick={() => setCourierWeekView(null)} className="btn btn-sm">← Назад</button>
              <span style={{ color: 'var(--accent)', fontWeight: 600, fontSize: 13 }}>📅 Неделя: {courierWeekView.fullName || courierWeekView.name}</span>
              <span className="muted" style={{ fontSize: 12 }}>({formatDateShort(weekDates[0])} — {formatDateShort(weekDates[5])})</span>
            </div>
          )}

          {currentPage === 'courier' && currentCourier && (
            <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
              <span style={{ color: 'var(--accent)', fontWeight: 600, fontSize: 13 }}>👤 {currentCourier.fullName || currentCourier.name}</span>
              <span className="muted" style={{ fontSize: 12 }}>📅 {formatDateShort(today)}</span>
            </div>
          )}

          {currentPage === 'admin' && (
            <div className="tabs">
              {canAdminTab('couriers') && <button onClick={() => setAdminTab('couriers')} className={`tab ${adminTab === 'couriers' ? 'active' : ''}`}>👥 Курьеры</button>}
              {canAdminTab('clients') && <button onClick={() => setAdminTab('clients')} className={`tab ${adminTab === 'clients' ? 'active' : ''}`}>🏢 Клиенты</button>}
              {canAdminTab('offices') && <button onClick={() => setAdminTab('offices')} className={`tab ${adminTab === 'offices' ? 'active' : ''}`}>📮 Отделения</button>}
              {canAdminTab('reports') && <button onClick={() => setAdminTab('reports')} className={`tab ${adminTab === 'reports' ? 'active' : ''}`}>📊 Отчёты</button>}
              {canAdminTab('staff') && <button onClick={() => setAdminTab('staff')} className={`tab ${adminTab === 'staff' ? 'active' : ''}`}>🔐 Сотрудники</button>}
              {canAdminTab('cash') && <button onClick={() => setAdminTab('cash')} className={`tab ${adminTab === 'cash' ? 'active' : ''}`}>💰 Касса</button>}
            </div>
          )}

          {currentPage === 'operator' && (
            <div className="tabs">
              <button onClick={() => setOperatorTab('receive')} className={`tab ${operatorTab === 'receive' ? 'active' : ''}`}>📥 Получение</button>
              <button onClick={() => setOperatorTab('send')} className={`tab ${operatorTab === 'send' ? 'active' : ''}`}>📤 Отправка</button>
              <button onClick={() => setOperatorTab('returns')} className={`tab ${operatorTab === 'returns' ? 'active' : ''}`}>📨 Возвраты</button>
              <button onClick={() => setOperatorTab('archive')} className={`tab ${operatorTab === 'archive' ? 'active' : ''}`}>📦 Архив</button>
            </div>
          )}
        </div>

        <div className="topbar-right">
          <div ref={globalSearchRef} style={{ position: 'relative' }}>
            <div className="search-box">
              <span>🔍</span>
              <input type="text" value={globalSearch} onChange={(e) => { setGlobalSearch(e.target.value); setShowGlobalSearch(true); }} onFocus={() => setShowGlobalSearch(true)} placeholder="Поиск..." />
              {globalSearch && <button onClick={() => { setGlobalSearch(''); setShowGlobalSearch(false); }} style={{ border: 0, background: 'none', color: 'var(--muted)', cursor: 'pointer' }}>&times;</button>}
            </div>
            {showGlobalSearch && globalSearchQuery.length >= 2 && globalSearchResults && (
              <div style={{ position: 'absolute', right: 0, top: '100%', marginTop: 8, width: 380, maxWidth: '92vw', background: 'var(--panel)', border: '1px solid var(--border)', borderRadius: 12, boxShadow: 'var(--shadow-lg)', zIndex: 50, maxHeight: '70vh', overflowY: 'auto' }}>
                {!hasGlobalSearchResults ? (
                  <div style={{ padding: 16, textAlign: 'center', color: 'var(--muted)' }}>Ничего не найдено</div>
                ) : (
                  <>
                    {globalSearchResults.matchedClients.length > 0 && (
                      <div>
                        <div style={{ padding: '8px 12px', fontSize: 11, fontWeight: 700, color: 'var(--accent)', background: 'var(--panel-3)', borderBottom: '1px solid var(--border)', position: 'sticky', top: 0 }}>👥 КЛИЕНТЫ ({globalSearchResults.matchedClients.length})</div>
                        {globalSearchResults.matchedClients.map(client => (
                          <div key={client.id} onClick={() => handleGlobalSearchSelectClient(client)} style={{ padding: '8px 12px', cursor: 'pointer', borderBottom: '1px solid var(--border)' }} onMouseOver={(e) => (e.currentTarget.style.background = 'var(--panel-2)')} onMouseOut={(e) => (e.currentTarget.style.background = '')}>
                            <div style={{ fontSize: 13, fontWeight: 600 }}>{client.companyName}{(client as any).active === false && <span style={{ color: 'var(--red)', fontSize: 11, marginLeft: 4 }}>🚫</span>}</div>
                            <div style={{ fontSize: 11, color: 'var(--muted)' }}>📍 {client.address || '—'}{client.holding ? ' · 🏗️ ' + client.holding : ''}{client.postOffice ? ' · 📮 ' + client.postOffice : ''}</div>
                          </div>
                        ))}
                      </div>
                    )}
                    {globalSearchResults.matchedTasks.length > 0 && (
                      <div>
                        <div style={{ padding: '8px 12px', fontSize: 11, fontWeight: 700, color: 'var(--yellow)', background: 'var(--panel-3)', borderBottom: '1px solid var(--border)', position: 'sticky', top: 0 }}>📋 ЗАДАЧИ ({globalSearchResults.matchedTasks.length})</div>
                        {globalSearchResults.matchedTasks.map(task => {
                          const courier = couriers.find(c => c.id === task.status);
                          return (
                            <div key={task.id} onClick={() => handleGlobalSearchSelectTask(task)} style={{ padding: '8px 12px', cursor: 'pointer', borderBottom: '1px solid var(--border)' }} onMouseOver={(e) => (e.currentTarget.style.background = 'var(--panel-2)')} onMouseOut={(e) => (e.currentTarget.style.background = '')}>
                              <div style={{ display: 'flex', gap: 6, alignItems: 'center' }}>
                                <span className="badge badge-gray">{TYPE_LABELS[task.type] || task.type}</span>
                                <span style={{ fontSize: 13, fontWeight: 600, flex: 1, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{task.title}</span>
                              </div>
                              <div style={{ fontSize: 11, color: 'var(--muted)', marginTop: 3 }}>
                                📅 {formatDateShort(task.date)}{task.date === today ? ' (сегодня)' : ''} · 🕐 {task.time} · 👤 {courier ? (courier.fullName || courier.name) : 'Не назначен'}
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    )}
                    {globalSearchResults.matchedPostOffices.length > 0 && (
                      <div>
                        <div style={{ padding: '8px 12px', fontSize: 11, fontWeight: 700, color: 'var(--purple)', background: 'var(--panel-3)', borderBottom: '1px solid var(--border)', position: 'sticky', top: 0 }}>📮 ОТДЕЛЕНИЯ ({globalSearchResults.matchedPostOffices.length})</div>
                        {globalSearchResults.matchedPostOffices.map(office => (
                          <div key={office.folderName} onClick={() => handleGlobalSearchSelectPostOffice(office)} style={{ padding: '8px 12px', cursor: 'pointer', borderBottom: '1px solid var(--border)' }} onMouseOver={(e) => (e.currentTarget.style.background = 'var(--panel-2)')} onMouseOut={(e) => (e.currentTarget.style.background = '')}>
                            <div style={{ fontSize: 13, fontWeight: 600 }}>📮 {office.index}, {office.address}</div>
                            <div style={{ fontSize: 11, color: 'var(--muted)' }}>🖨️ {office.companies.length} доверенностей</div>
                          </div>
                        ))}
                      </div>
                    )}
                  </>
                )}
              </div>
            )}
          </div>

          <button onClick={toggleTheme} className="icon-btn" title={theme === 'light' ? 'Тёмная тема' : 'Светлая тема'}>
            {theme === 'light' ? '🌙' : '☀️'}
          </button>

          {currentPage === 'operator' && (
            <button onClick={() => setIsOperatorScannerOpen(true)} className="btn btn-primary btn-sm">📷 Сканер</button>
          )}

          {currentUser ? (
            <div className="user-chip">
              <span style={{ color: 'var(--green)', fontWeight: 700 }}>👤 {currentUser.name}</span>
              <span className="muted" style={{ fontSize: 11 }}>{ROLE_PRESETS[currentUser.role]?.label || 'Произвольные права'}</span>
              <button onClick={handleLogout} style={{ border: 0, background: 'none', color: 'var(--red)', cursor: 'pointer', fontSize: 11, fontWeight: 600 }}>Выйти</button>
            </div>
          ) : (
            staff.length > 0 && (
              <button onClick={() => setIsLoginModalOpen(true)} className="btn btn-primary btn-sm">🔐 Войти</button>
            )
          )}

          {currentPage === 'board' && canAction('createTask') && !courierWeekView && (
            <button onClick={() => setIsModalOpen(true)} className="btn btn-primary">+ Новая задача</button>
          )}
        </div>
      </header>

      {/* ================= СТРАНИЦА: ЗАДАЧИ (КАНБАН) ================= */}
      {currentPage === 'board' && !courierWeekView && (
        <div className="page" style={{ padding: 0 }}>
          <div style={{ padding: '16px 20px 0' }}>
            <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', alignItems: 'center' }}>
              <h2 className="panel-title">📋 Задачи на {formatDateLong(selectedDate)}</h2>
              <span className="badge badge-gray">Всего: {tasks.filter(t => t.date === selectedDate).length}</span>
            </div>
          </div>
          <div style={{ padding: '12px 20px 20px', height: 'calc(100% - 80px)' }}>
            <DndContext sensors={sensors} onDragStart={(e) => canAction('editTask') && setActiveTask(e.active.data.current?.task as Task)} onDragEnd={handleDragEnd}>
              <div className="board">
                {couriers.map((column, index) => (
                  <Column
                    key={column.id}
                    column={column}
                    tasks={tasks.filter(t => t.date === selectedDate && t.status === column.id)}
                    onTaskClick={handleTaskClick}
                    canReorder={canAction('editTask')}
                    onReorder={moveTaskInColumn}
                    colorIndex={index}
                    {...({ onCourierNameClick: (col: Courier) => setCourierWeekView(col) } as any)}
                  />
                ))}
              </div>
              <DragOverlay>{activeTask ? <TaskCard task={activeTask} isOverlay /> : null}</DragOverlay>
            </DndContext>
          </div>
        </div>
      )}

      {/* ================= НЕДЕЛЬНЫЙ ОБЗОР КУРЬЕРА ================= */}
      {currentPage === 'board' && courierWeekView && (
        <div className="page" style={{ padding: 0 }}>
          <div style={{ padding: '16px 20px 0' }}>
            <h2 className="panel-title">📅 Неделя: {courierWeekView.fullName || courierWeekView.name}</h2>
            <p className="muted" style={{ marginTop: 4, fontSize: 12 }}>
              {formatDateShort(weekDates[0])} — {formatDateShort(weekDates[5])} · Всего задач: {tasks.filter(t => t.status === courierWeekView.id && weekDates.includes(t.date)).length}
            </p>
          </div>
          <div style={{ padding: '12px 20px 20px', height: 'calc(100% - 100px)' }}>
            <div className="board">
              {weekDates.map((dateStr, dayIdx) => {
                const dayTasks = tasks.filter(t => t.status === courierWeekView.id && t.date === dateStr).sort(boardComparator);
                const isToday = dateStr === today;
                const bg = WEEK_COLUMN_COLORS[dayIdx % WEEK_COLUMN_COLORS.length];
                const tx = WEEK_TEXT_COLORS[dayIdx % WEEK_TEXT_COLORS.length];
                return (
                  <div key={dateStr} className="col" style={{ '--hdr': bg, '--hdr-text': tx } as React.CSSProperties}>
                    <div className="col-head">
                      <div className="col-name">
                        <span>{DAY_LABELS_SHORT[dayIdx]}</span>
                        {isToday && <span className="badge badge-red" style={{ marginLeft: 6 }}>сегодня</span>}
                      </div>
                      <div style={{ fontSize: 11, color: 'var(--muted)', marginTop: 4 }}>{formatDateShort(dateStr)}</div>
                      <div className="col-meta">
                        <span className="muted" style={{ fontSize: 11 }}>
                          🟢 {dayTasks.filter(t => t.workflowStatus === 'new').length} · 🟡 {dayTasks.filter(t => t.workflowStatus === 'in_progress').length} · ✅ {dayTasks.filter(t => t.workflowStatus === 'completed').length}
                        </span>
                        <b style={{ color: tx }}>{dayTasks.length}</b>
                      </div>
                    </div>
                    <div className="col-body">
                      {dayTasks.length === 0 ? (
                        <div className="col-empty">Нет задач</div>
                      ) : (
                        dayTasks.map(task => {
                          const rate = (task as any).taskRate || getTaskRate(task);
                          const address = task.type === 'post'
                            ? `${task.postIndex}, ${task.postAddress}`
                            : task.type === 'complex' ? (task.officeAddress || task.title)
                            : task.type === 'legal_address' ? (task as any).legalAddress
                            : task.clientAddress || task.title;
                          const clientName = task.type !== 'post' ? (task.clientCompany || task.officeCompany || (task as any).legalCompanyName || '') : '';
                          return (
                            <div key={task.id} onClick={() => handleTaskClick(task)} className="task-card" style={{ cursor: 'pointer', '--st': task.workflowStatus === 'completed' ? 'var(--green)' : task.workflowStatus === 'in_progress' ? 'var(--yellow)' : 'var(--accent)' } as React.CSSProperties}>
                              <div className="task-top">
                                <span className="task-type">{TYPE_LABELS[task.type] || task.type}</span>
                                <span className="task-time">{task.time}</span>
                              </div>
                              <div className="task-address">{address}</div>
                              {clientName && <div className="task-client">🏢 <span>{clientName}</span></div>}
                              {task.completionType === 'no_visit' && <span className="badge badge-red">🚫 Без посещения</span>}
                              <div className="task-bottom">
                                <span className={`badge ${task.workflowStatus === 'completed' ? 'badge-done' : task.workflowStatus === 'in_progress' ? 'badge-progress' : 'badge-new'}`}>
                                  {task.workflowStatus === 'completed' ? '✅ Завершена' : task.workflowStatus === 'in_progress' ? '🟡 В работе' : '🟢 Новая'}
                                </span>
                                {task.type !== 'post' && rate && <span className="task-rate">💰 {rate} ₽</span>}
                              </div>
                              {task.completedAt && (
                                <div className="task-time" style={{ marginTop: 8, color: 'var(--green)' }}>
                                  ✅ Завершена: {formatCompletedAt(task.completedAt)}
                                </div>
                              )}
                            </div>
                          );
                        })
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      )}

      {/* ================= СТРАНИЦА: КУРЬЕР ================= */}
      {currentPage === 'courier' && (
        <div className="page">
          <div className="page-wide">
            {!courierViewId ? (
              <div className="panel" style={{ maxWidth: 440, margin: '40px auto', textAlign: 'center' }}>
                <div style={{ fontSize: 56, marginBottom: 12 }}>🚚</div>
                <h2 style={{ margin: '0 0 8px' }}>Интерфейс курьера</h2>
                <p className="muted" style={{ marginBottom: 20 }}>Выберите своё имя, чтобы увидеть задачи на сегодня</p>
                <div className="field">
                  <label className="label">Ваше имя:</label>
                  <SearchableSelect value={courierViewId} onChange={setCourierViewId} options={courierViewOptions} placeholder="-- Выберите курьера --" searchPlaceholder="Поиск..." />
                </div>
                <div className="notice blue">💡 Этот выбор сохранится в браузере</div>
              </div>
            ) : currentCourier && (
              <>
                <div className="panel">
                  <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', gap: 12, marginBottom: 12, flexWrap: 'wrap' }}>
                    <div>
                      <div className="muted" style={{ fontSize: 11, fontWeight: 600 }}>👤 КУРЬЕР</div>
                      <h2 style={{ margin: '4px 0' }}>{currentCourier.fullName || currentCourier.name}</h2>
                      {currentCourier.phone && <div className="muted" style={{ fontSize: 12 }}>📞 {currentCourier.phone}</div>}
                    </div>
                    <button onClick={() => setCourierViewId('')} className="btn btn-sm">↩️ Сменить</button>
                  </div>
                  <GeolocationToggle courierId={courierViewId} courierName={currentCourier.fullName || currentCourier.name} />
                  <div className="tabs" style={{ marginTop: 12 }}>
                    <button onClick={() => setCourierSubTab('tasks')} className={`tab ${courierSubTab === 'tasks' ? 'active' : ''}`}>📋 Задачи</button>
                    <button onClick={() => setCourierSubTab('doverennosti')} className={`tab ${courierSubTab === 'doverennosti' ? 'active' : ''}`}>🔍 Доверенности</button>
                    <button onClick={() => setCourierSubTab('scanner')} className={`tab ${courierSubTab === 'scanner' ? 'active' : ''}`}>📷 Сканер</button>
                    <button onClick={() => setCourierSubTab('postmen')} className={`tab ${courierSubTab === 'postmen' ? 'active' : ''}`}>📮 Почтальоны</button>
                  </div>
                </div>

                {courierSubTab === 'tasks' && (
                  <>
                    {courierTasks.length > 0 && (
                      <button onClick={openYandexRoute} className="btn btn-primary" style={{ width: '100%', marginBottom: 12 }}>
                        🗺️ Построить маршрут в Яндекс.Картах ({courierTasks.length} адресов)
                      </button>
                    )}
                    <div className="stats">
                      <div className="stat"><div className="stat-label">Всего</div><div className="stat-value">{courierStats.all}</div></div>
                      <div className="stat"><div className="stat-label">🟢 Новые</div><div className="stat-value blue">{courierStats.new}</div></div>
                      <div className="stat"><div className="stat-label">🟡 В работе</div><div className="stat-value yellow">{courierStats.in_progress}</div></div>
                      <div className="stat"><div className="stat-label">✅ Готово</div><div className="stat-value green">{courierStats.completed}</div></div>
                    </div>
                    <div className="tabs" style={{ marginBottom: 12 }}>
                      {([{ value: 'all' as CourierFilter, label: 'Все', count: courierStats.all }, { value: 'new' as CourierFilter, label: '🟢 Новые', count: courierStats.new }, { value: 'in_progress' as CourierFilter, label: '🟡 В работе', count: courierStats.in_progress }, { value: 'completed' as CourierFilter, label: '✅ Готово', count: courierStats.completed }]).map(f => (
                        <button key={f.value} onClick={() => setCourierFilter(f.value)} className={`tab ${courierFilter === f.value ? 'active' : ''}`}>
                          {f.label} <span className="muted">({f.count})</span>
                        </button>
                      ))}
                    </div>
                    {courierTasks.length === 0 ? (
                      <div className="empty"><div className="empty-icon">📭</div>Нет задач на сегодня</div>
                    ) : (
                      <div style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>
                        {courierTasks.map(task => {
                          const wf = task.workflowStatus;
                          const stColor = wf === 'completed' ? 'var(--green)' : wf === 'in_progress' ? 'var(--yellow)' : 'var(--accent)';
                          const taskRate = (task as any).taskRate || getTaskRate(task);
                          const address = task.type === 'post'
                            ? `📮 ${task.postIndex}, ${task.postAddress}`
                            : task.type === 'complex' ? (task.officeAddress || task.title)
                            : task.type === 'legal_address' ? (task as any).legalAddress
                            : task.clientAddress || task.title;
                          const clientName = task.type !== 'post' ? (task.clientCompany || task.officeCompany || (task as any).legalCompanyName || '') : '';
                          return (
                            <div key={task.id} className="card" style={{ borderLeft: `4px solid ${stColor}` }}>
                              <div className="card-head">
                                <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap', marginBottom: 6 }}>
                                  <span className={`badge ${task.type === 'post' ? 'badge-post' : 'badge-other'}`}>{TYPE_LABELS[task.type]}</span>
                                  <span className={`badge ${wf === 'completed' ? 'badge-done' : wf === 'in_progress' ? 'badge-progress' : 'badge-new'}`}>
                                    {wf === 'completed' ? '✅ Завершена' : wf === 'in_progress' ? '🟡 В работе' : '🟢 Новая'}
                                  </span>
                                  {task.completionType === 'no_visit' && <span className="badge badge-red">🚫 Без посещения</span>}
                                  <span className="muted" style={{ fontSize: 11 }}>🕐 {task.time}</span>
                                  {task.type !== 'post' && taskRate && <span className="badge badge-done">💰 {taskRate} ₽</span>}
                                  {task.type === 'pickup' && task.sentLetterCount != null && task.sendMethod && (
                                    <span className={`badge ${task.sendMethod === 'ABS' ? 'badge-new' : 'badge-post'}`}>
                                      {SEND_METHOD_META[task.sendMethod].icon} {task.sentLetterCount} писем
                                    </span>
                                  )}
                                </div>
                                <div style={{ fontSize: 15, fontWeight: 700 }}>{address}</div>
                                {clientName && <div className="muted" style={{ fontSize: 12, marginTop: 4 }}>🏢 {clientName}</div>}
                              </div>
                              <div className="card-body">
                                {task.type === 'post' && (
                                  <>
                                    <div style={{ fontSize: 12, color: 'var(--purple)', fontWeight: 600, marginBottom: 8 }}>📮 {task.postIndex}, {task.postAddress}</div>
                                    <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
                                      {normalizeCompanies(task.companies).filter(c => !isCompanyInactive(c.name)).map((comp, idx) => {
                                        const note = getClientNoteForCompany(comp.name);
                                        return (
                                          <div key={idx} style={{ padding: '8px 10px', borderRadius: 8, background: comp.operatorConfirmed ? 'var(--green-soft)' : 'var(--panel-2)', border: `1px solid ${comp.operatorConfirmed ? 'var(--green)' : 'var(--border)'}`, fontSize: 13 }}>
                                            <div style={{ display: 'flex', justifyContent: 'space-between', gap: 8, alignItems: 'center' }}>
                                              <span style={{ flex: 1, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>
                                                {comp.operatorConfirmed ? '✓ ' : '• '}{comp.name}
                                              </span>
                                              <div style={{ display: 'flex', gap: 6, fontSize: 11, flexShrink: 0 }}>
                                                {comp.letterCount > 0 && <span style={{ color: 'var(--accent)', fontFamily: 'monospace' }}>({comp.letterCount})</span>}
                                                {(comp.receivedCount ?? 0) > 0 && <span style={{ color: 'var(--green)', fontFamily: 'monospace', fontWeight: 700 }}>✓{comp.receivedCount}</span>}
                                              </div>
                                            </div>
                                            {note && <div style={{ fontSize: 11, color: 'var(--yellow)', background: 'var(--yellow-soft)', padding: '4px 8px', borderRadius: 6, marginTop: 4 }}>💬 {note}</div>}
                                          </div>
                                        );
                                      })}
                                    </div>
                                  </>
                                )}
                                {task.type === 'complex' && task.postPoints && (
                                  <div style={{ display: 'flex', flexDirection: 'column', gap: 10 }}>
                                    {task.postPoints.map((point, pIdx) => (
                                      <div key={point.id} style={{ padding: 10, borderRadius: 10, background: 'var(--purple-soft)', border: '1px solid var(--purple)' }}>
                                        <div style={{ fontSize: 11, color: 'var(--purple)', fontWeight: 700, marginBottom: 6 }}>📮 #{pIdx + 1}: {point.postIndex}, {point.postAddress}</div>
                                        <div style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
                                          {normalizeCompanies(point.companies).filter(c => !isCompanyInactive(c.name)).map((comp, cIdx) => {
                                            const note = getClientNoteForCompany(comp.name);
                                            return (
                                              <div key={cIdx} style={{ padding: '6px 8px', borderRadius: 6, background: comp.operatorConfirmed ? 'var(--green-soft)' : 'var(--panel-2)', border: `1px solid ${comp.operatorConfirmed ? 'var(--green)' : 'var(--border)'}`, fontSize: 12 }}>
                                                <div style={{ display: 'flex', justifyContent: 'space-between', gap: 6 }}>
                                                  <span style={{ flex: 1, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{comp.operatorConfirmed ? '✓ ' : '• '}{comp.name}</span>
                                                  <div style={{ display: 'flex', gap: 6, fontSize: 11, fontFamily: 'monospace', flexShrink: 0 }}>
                                                    {comp.letterCount > 0 && <span style={{ color: 'var(--accent)' }}>({comp.letterCount})</span>}
                                                    {(comp.receivedCount ?? 0) > 0 && <span style={{ color: 'var(--green)', fontWeight: 700 }}>✓{comp.receivedCount}</span>}
                                                  </div>
                                                </div>
                                                {note && <div style={{ fontSize: 10, color: 'var(--yellow)', marginTop: 2 }}>💬 {note}</div>}
                                              </div>
                                            );
                                          })}
                                        </div>
                                      </div>
                                    ))}
                                  </div>
                                )}
                                {(task.type === 'delivery' || task.type === 'pickup') && (
                                  <div style={{ fontSize: 13, display: 'flex', flexDirection: 'column', gap: 3 }}>
                                    <div>🏢 <b>{task.clientCompany}</b></div>
                                    <div>📍 {task.clientAddress}</div>
                                    {task.contactPerson && <div>👤 {task.contactPerson}</div>}
                                    {task.contactPhone && <div>📞 {task.contactPhone}</div>}
                                    {task.timeWindow && <div>🕐 {task.timeWindow}</div>}
                                    {task.clientNote && <div className="muted" style={{ fontStyle: 'italic', fontSize: 12, marginTop: 4 }}>💬 {task.clientNote}</div>}
                                  </div>
                                )}
                                {task.type === 'legal_address' && (
                                  <div style={{ fontSize: 13, display: 'flex', flexDirection: 'column', gap: 3 }}>
                                    <div>⚖️ <b>{(task as any).legalCompanyName}</b></div>
                                    <div>📍 {(task as any).legalAddress}</div>
                                    {(task as any).legalContactPerson && <div>👤 {(task as any).legalContactPerson}</div>}
                                    {(task as any).legalContactPhone && <div>📞 {(task as any).legalContactPhone}</div>}
                                    {task.clientNote && <div className="muted" style={{ fontStyle: 'italic', fontSize: 12, marginTop: 4 }}>💬 {task.clientNote}</div>}
                                  </div>
                                )}
                                {task.type === 'pickup' && task.sentLetterCount != null && (
                                  <div style={{ padding: 10, borderRadius: 8, background: 'var(--accent-soft)', border: '1px solid var(--accent)', fontSize: 12 }}>
                                    <div style={{ fontSize: 11, color: 'var(--accent)', fontWeight: 600, marginBottom: 4 }}>📤 Данные отправки:</div>
                                    <div>Писем: <b style={{ fontFamily: 'monospace' }}>{task.sentLetterCount}</b> · Способ: <b>{task.sendMethod === 'ABS' ? 'АБС' : task.sendMethod === 'OPS' ? 'ОПС' : '—'}</b></div>
                                    {task.sentAt && <div className="muted" style={{ fontSize: 11 }}>📅 {new Date(task.sentAt).toLocaleString('ru-RU')}</div>}
                                  </div>
                                )}
                                {task.completionType === 'no_visit' && task.noVisitReason && (
                                  <div style={{ padding: 10, borderRadius: 8, background: 'var(--red-soft)', border: '1px solid var(--red)', fontSize: 12 }}>
                                    <div style={{ fontSize: 11, color: 'var(--red)', fontWeight: 600, marginBottom: 4 }}>🚫 Причина без посещения:</div>
                                    <div>{task.noVisitReason}</div>
                                  </div>
                                )}
                                {task.comments && (
                                  <div style={{ padding: 10, borderRadius: 8, background: 'var(--accent-soft)', border: '1px solid var(--accent)', fontSize: 12 }}>
                                    <div style={{ fontSize: 11, color: 'var(--accent)', fontWeight: 600, marginBottom: 4 }}>💬 Комментарий логиста:</div>
                                    <div>{task.comments}</div>
                                  </div>
                                )}
                                <div style={{ padding: 10, borderRadius: 8, background: 'var(--panel-2)', border: '1px solid var(--border)' }}>
                                  <div style={{ fontSize: 11, color: 'var(--yellow)', fontWeight: 600, marginBottom: 4 }}>📝 Комментарий курьера:</div>
                                  <textarea value={task.courierComments || ''} onChange={(e) => handleUpdateTask(task.id, { courierComments: e.target.value })} placeholder="Напишите комментарий..." rows={2} className="textarea" style={{ fontSize: 12 }} />
                                </div>
                                {task.type !== 'post' && taskRate && (
                                  <div style={{ padding: 10, borderRadius: 8, background: 'var(--green-soft)', border: '1px solid var(--green)', fontSize: 12 }}>
                                    <div style={{ fontSize: 11, color: 'var(--green)', fontWeight: 600, marginBottom: 4 }}>💰 Тариф за задачу:</div>
                                    <div style={{ fontSize: 15, fontWeight: 700 }}>{taskRate} ₽</div>
                                  </div>
                                )}
                                {task.completedAt && (
                                  <div style={{ padding: 10, borderRadius: 8, background: 'var(--green-soft)', border: '1px solid var(--green)', fontSize: 12 }}>
                                    <div style={{ fontSize: 11, color: 'var(--green)', fontWeight: 600, marginBottom: 4 }}>✅ Завершена курьером:</div>
                                    <div>{formatCompletedAt(task.completedAt)}</div>
                                  </div>
                                )}
                              </div>
                              <div className="card-foot">
                                {task.workflowStatus === 'new' && <button onClick={() => handleCourierTaskStatusChange(task, 'in_progress')} className="btn" style={{ flex: 1, background: 'var(--yellow-soft)', color: 'var(--yellow)', borderColor: 'var(--yellow)' }}>▶️ Взять в работу</button>}
                                {task.workflowStatus === 'in_progress' && (
                                  task.type === 'pickup' ? (
                                    <button onClick={() => handleCourierOpenSendModal(task)} className="btn btn-green" style={{ flex: 1 }}>✓ Завершить (отправка)</button>
                                  ) : (
                                    <button onClick={() => handleCourierTaskStatusChange(task, 'completed')} className="btn btn-green" style={{ flex: 1 }}>✓ Завершить</button>
                                  )
                                )}
                                {task.workflowStatus === 'completed' && <button onClick={() => handleCourierTaskStatusChange(task, 'in_progress')} className="btn" style={{ flex: 1 }}>↩️ Вернуть в работу</button>}
                                {(task.type === 'post' || task.type === 'complex') && task.workflowStatus !== 'completed' && (
                                  <button onClick={() => { setCourierSelectedTask(task); const ic: Record<string, number> = {}; if (task.type === 'post') { normalizeCompanies(task.companies).forEach((c, idx) => { ic['post-' + idx] = 0; }); } else if (task.type === 'complex' && task.postPoints) { task.postPoints.forEach((point, pIdx) => { normalizeCompanies(point.companies).forEach((c, cIdx) => { ic['point-' + pIdx + '-comp-' + cIdx] = 0; }); }); } setCourierLocalCounts(ic); setTaskScans({}); sessionScanIdsRef.current = []; setIsCourierConfirmModalOpen(true); }} className="btn btn-green">📬 Письма</button>
                                )}
                                {task.workflowStatus !== 'completed' && (
                                  <button onClick={() => handleOpenNoVisit(task)} className="btn btn-red">🚫 Без посещения</button>
                                )}
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    )}
                  </>
                )}

                {courierSubTab === 'doverennosti' && (
                  <div style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>
                    <div className="panel">
                      <h3 style={{ margin: '0 0 12px', color: 'var(--purple)' }}>📮 Доверенности по почтовым отделениям</h3>
                      <input type="text" value={courierDoverennostSearch} onChange={(e) => setCourierDoverennostSearch(e.target.value)} placeholder="🔍 Поиск по индексу, адресу или компании..." className="input" style={{ marginBottom: 12 }} />
                      <div style={{ display: 'flex', flexDirection: 'column', gap: 8, maxHeight: '50vh', overflowY: 'auto' }}>
                        {filteredPostOfficesForCourier.length === 0 ? (
                          <div className="muted" style={{ textAlign: 'center', padding: 20 }}>Отделения не найдены</div>
                        ) : (
                          filteredPostOfficesForCourier.map(office => (
                            <div key={office.folderName} style={{ padding: 12, borderRadius: 10, background: 'var(--panel-2)', border: '1px solid var(--border)', display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: 12 }}>
                              <div style={{ flex: 1, minWidth: 0 }}>
                                <div style={{ fontWeight: 600, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>📮 {office.index}, {office.address}</div>
                                <div className="muted" style={{ fontSize: 11, marginTop: 2 }}>{office.companies.length} доверенностей</div>
                              </div>
                              <button onClick={() => handleOpenAllDoverennostiForOffice(office.folderName)} className="btn btn-primary btn-sm">🖨️ Открыть все</button>
                            </div>
                          ))
                        )}
                      </div>
                    </div>
                    <div className="panel">
                      <h3 style={{ margin: '0 0 12px', color: 'var(--accent)' }}>🔍 Поиск доверенности по клиенту</h3>
                      <SearchableSelect value={courierSearchClient} onChange={handleCourierOpenPowerOfAttorney} options={clientOptions} placeholder="-- Выберите клиента --" searchPlaceholder="Поиск..." />
                      <p className="muted" style={{ fontSize: 11, marginTop: 8 }}>Выберите клиента — система найдёт и откроет его доверенность</p>
                    </div>
                  </div>
                )}

                {courierSubTab === 'scanner' && (
                  <div style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>
                    <div className="panel">
                      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 12, flexWrap: 'wrap', gap: 8 }}>
                        <h3 style={{ margin: 0, color: 'var(--cyan)' }}>📷 Сканирование документов</h3>
                        <span className="muted" style={{ fontSize: 12 }}>{scannerStatus}</span>
                      </div>
                      <div style={{ position: 'relative', background: '#000', borderRadius: 12, overflow: 'hidden', minHeight: 220 }}>
                        <video ref={videoTabRef} playsInline muted className="scanner-video" />
                        {scannerMode !== 'tab' && (
                          <div style={{ position: 'absolute', inset: 0, display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center', gap: 10, color: 'var(--muted)' }}>
                            <div style={{ fontSize: 48 }}>📷</div>
                            <div style={{ fontSize: 13, textAlign: 'center' }}>Камера выключена.<br />Нажмите «Включить камеру».</div>
                          </div>
                        )}
                        {scannerMode === 'tab' && autoCapture && (
                          <div style={{ position: 'absolute', top: 8, left: 8, background: 'var(--cyan-soft)', border: '1px solid var(--cyan)', color: 'var(--cyan)', fontSize: 10, padding: '3px 8px', borderRadius: 6 }}>🎯 Автозахват</div>
                        )}
                      </div>
                      <div className="grid-4" style={{ marginTop: 12 }}>
                        {scannerMode !== 'tab' ? (
                          <button onClick={() => startScanner('tab')} className="btn btn-primary" style={{ gridColumn: 'span 2' }}>📷 Включить камеру</button>
                        ) : (
                          <button onClick={stopScanner} className="btn btn-red" style={{ gridColumn: 'span 2' }}>⏹ Выключить</button>
                        )}
                        <button onClick={captureScan} disabled={scannerMode !== 'tab'} className="btn btn-primary">📸 Снять кадр</button>
                        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 6, padding: '6px 10px', borderRadius: 8, background: 'var(--panel-2)', border: '1px solid var(--border)', fontSize: 12 }}>
                          <span className="muted">Формат:</span>
                          <button onClick={() => setScannerFormat('jpeg')} className={`btn btn-sm ${scannerFormat === 'jpeg' ? 'btn-primary' : ''}`}>JPEG</button>
                          <button onClick={() => setScannerFormat('pdf')} className={`btn btn-sm ${scannerFormat === 'pdf' ? 'btn-primary' : ''}`}>PDF</button>
                        </div>
                      </div>
                    </div>
                    {scans.length > 0 && (
                      <div className="panel">
                        <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 12, flexWrap: 'wrap', gap: 8 }}>
                          <h3 style={{ margin: 0 }}>🗂 Отсканировано: {scans.length}</h3>
                          <div style={{ display: 'flex', gap: 8 }}>
                            <button onClick={() => setScans([])} className="btn btn-sm">🗑 Очистить</button>
                            <button onClick={saveScans} className="btn btn-green btn-sm">💾 Сохранить {scannerFormat.toUpperCase()}</button>
                          </div>
                        </div>
                        <div className="grid-4" style={{ maxHeight: '40vh', overflowY: 'auto' }}>
                          {scans.map((s, i) => (
                            <div key={s.id} style={{ position: 'relative', background: 'var(--panel-2)', border: '1px solid var(--border)', borderRadius: 8, overflow: 'hidden' }}>
                              <img src={s.dataUrl} alt={`Скан ${i + 1}`} style={{ width: '100%', height: 90, objectFit: 'cover' }} />
                              <div style={{ position: 'absolute', top: 4, left: 4, background: 'rgba(0,0,0,.7)', color: '#fff', fontSize: 10, padding: '2px 6px', borderRadius: 4 }}>#{i + 1}</div>
                              <button onClick={() => setScans(prev => prev.filter(x => x.id !== s.id))} style={{ position: 'absolute', top: 4, right: 4, background: 'var(--red)', color: '#fff', fontSize: 10, width: 20, height: 20, borderRadius: 4, border: 0, cursor: 'pointer' }}>&times;</button>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>
                )}

                {courierSubTab === 'postmen' && (
                  <div className="panel">
                    <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 12, flexWrap: 'wrap', gap: 8 }}>
                      <h3 style={{ margin: 0, color: 'var(--purple)' }}>📮 Ваши почтальоны</h3>
                      <span className="muted" style={{ fontSize: 12 }}>Закреплено отделений: <b style={{ color: 'var(--purple)' }}>{courierPostmen.length}</b></span>
                    </div>
                    <p className="muted" style={{ fontSize: 12, marginBottom: 12 }}>Почтальоны почтовых отделений, закреплённых за вами</p>
                    {courierPostmen.length === 0 ? (
                      <div className="empty">
                        <div className="empty-icon">📭</div>
                        <div>За вами не закреплено ни одного отделения</div>
                      </div>
                    ) : (
                      <div style={{ display: 'flex', flexDirection: 'column', gap: 10 }}>
                        {courierPostmen.map((p: any) => (
                          <div key={p.folderName} style={{ padding: 14, borderRadius: 12, background: 'var(--panel-2)', border: '1px solid var(--border)' }}>
                            <div style={{ display: 'flex', justifyContent: 'space-between', gap: 12, flexWrap: 'wrap', marginBottom: 10 }}>
                              <div style={{ flex: 1, minWidth: 200 }}>
                                <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap', marginBottom: 4, alignItems: 'center' }}>
                                  <span className="badge badge-new">📮 {p.index}</span>
                                  <span className="muted" style={{ fontSize: 11 }}>👥 {p.clientsCount} клиентов</span>
                                  {p.bonus && parseFloat(p.bonus) > 0 && <span className="badge badge-progress">💰 {formatMoney(parseFloat(p.bonus))}</span>}
                                </div>
                                <div style={{ fontWeight: 600 }}>{p.address}</div>
                                {p.visitDays && p.visitDays.length > 0 && (
                                  <div style={{ display: 'flex', gap: 3, marginTop: 6, flexWrap: 'wrap', alignItems: 'center' }}>
                                    <span className="muted" style={{ fontSize: 10 }}>📅 Посещение:</span>
                                    {p.visitDays.map((d: number) => (
                                      <span key={d} style={{ fontSize: 10, background: 'var(--accent-soft)', color: 'var(--accent)', padding: '2px 6px', borderRadius: 4, fontWeight: 600 }}>{DAY_LABELS_SHORT[d]}</span>
                                    ))}
                                  </div>
                                )}
                              </div>
                              {p.postmanPhone && (
                                <a href={`tel:${p.postmanPhone.replace(/[^+\d]/g, '')}`} className="btn btn-green btn-sm">📞 Позвонить</a>
                              )}
                            </div>
                            <div className="grid-2">
                              <div>
                                <div className="muted" style={{ fontSize: 10, textTransform: 'uppercase', letterSpacing: .4 }}>Почтальон</div>
                                <div style={{ fontWeight: 600 }}>{p.postmanName || <span className="muted" style={{ fontStyle: 'italic' }}>не указан</span>}</div>
                              </div>
                              <div>
                                <div className="muted" style={{ fontSize: 10, textTransform: 'uppercase', letterSpacing: .4 }}>Контакт</div>
                                <div style={{ fontWeight: 600 }}>
                                  {p.postmanPhone ? <a href={`tel:${p.postmanPhone.replace(/[^+\d]/g, '')}`} style={{ color: 'var(--green)' }}>{p.postmanPhone}</a> : <span className="muted" style={{ fontStyle: 'italic' }}>не указан</span>}
                                </div>
                              </div>
                            </div>
                            {p.comment && <div style={{ marginTop: 8, padding: '6px 10px', background: 'var(--yellow-soft)', border: '1px solid var(--yellow)', borderRadius: 6, fontSize: 12 }}>💬 {p.comment}</div>}
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                )}
              </>
            )}
          </div>
        </div>
      )}

      {/* ================= МОДАЛКА: БЕЗ ПОСЕЩЕНИЯ ================= */}
      {isNoVisitModalOpen && noVisitTask && (
        <div className="modal-backdrop">
          <div className="modal">
            <div className="modal-head">
              <h2 className="modal-title">🚫 Завершение без посещения</h2>
              <button onClick={() => { setIsNoVisitModalOpen(false); setNoVisitTask(null); setNoVisitComment(''); }} style={{ border: 0, background: 'none', fontSize: 24, color: 'var(--muted)', cursor: 'pointer' }}>&times;</button>
            </div>
            <div className="modal-body">
              <div className="notice red">⚠️ Задача: <b>{noVisitTask.title}</b>. Обязательно укажите причину.</div>
              <div className="field">
                <label className="label">Причина / комментарий <span style={{ color: 'var(--red)' }}>*</span></label>
                <textarea value={noVisitComment} onChange={(e) => setNoVisitComment(e.target.value)} placeholder="Например: офис закрыт, нет доступа..." rows={4} className="textarea" autoFocus />
              </div>
            </div>
            <div className="modal-foot">
              <button onClick={() => { setIsNoVisitModalOpen(false); setNoVisitTask(null); setNoVisitComment(''); }} className="btn">← Отмена</button>
              <button onClick={handleConfirmNoVisit} className="btn btn-red">🚫 Завершить без посещения</button>
            </div>
          </div>
        </div>
      )}

      {/* ================= МОДАЛКА КУРЬЕРА: ВВОД ПИСЕМ ================= */}
      {isCourierConfirmModalOpen && courierSelectedTask && (
        <div className="modal-backdrop">
          <div className="modal wide" style={{ maxHeight: '90vh' }}>
            <div className="modal-head">
              <h2 className="modal-title">📬 Получено писем</h2>
              <button onClick={() => { setIsCourierConfirmModalOpen(false); setCourierSelectedTask(null); setCourierLocalCounts({}); setTaskScans({}); }} style={{ border: 0, background: 'none', fontSize: 24, color: 'var(--muted)', cursor: 'pointer' }}>&times;</button>
            </div>
            <div className="modal-body" style={{ overflowY: 'auto' }}>
              <p className="muted" style={{ fontSize: 12, marginBottom: 12 }}>Нажмите 📷 напротив компании и сканируйте конверты</p>
              {courierSelectedTask.type === 'post' && (
                <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
                  <div style={{ fontSize: 12, color: 'var(--purple)', fontWeight: 600 }}>📮 {courierSelectedTask.postIndex}, {courierSelectedTask.postAddress}</div>
                  {normalizeCompanies(courierSelectedTask.companies).map((comp, idx) => {
                    const key = 'post-' + idx;
                    return (
                      <div key={key} style={{ padding: 12, borderRadius: 10, background: 'var(--panel-2)', border: '1px solid var(--border)', display: 'flex', alignItems: 'center', gap: 10 }}>
                        <div style={{ flex: 1, minWidth: 0 }}>
                          <div style={{ fontWeight: 600, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{comp.name}</div>
                        </div>
                        <div style={{ display: 'flex', alignItems: 'center', gap: 6, flexShrink: 0 }}>
                          <label className="muted" style={{ fontSize: 11 }}>Получено:</label>
                          <input type="number" min="0" value={courierLocalCounts[key] ?? 0} onChange={(e) => setCourierLocalCounts(prev => ({ ...prev, [key]: Math.max(0, Number(e.target.value) || 0) }))} className="input" style={{ width: 70, textAlign: 'center' }} />
                          <span className="muted" style={{ fontSize: 11 }}>шт.</span>
                        </div>
                      </div>
                    );
                  })}
                </div>
              )}
              {courierSelectedTask.type === 'complex' && courierSelectedTask.postPoints && (
                <div style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>
                  {courierSelectedTask.postPoints.map((point, pIdx) => (
                    <div key={point.id} style={{ padding: 12, borderRadius: 10, background: 'var(--purple-soft)', border: '1px solid var(--purple)' }}>
                      <div style={{ fontSize: 12, color: 'var(--purple)', fontWeight: 700, marginBottom: 8 }}>📮 #{pIdx + 1}: {point.postIndex}, {point.postAddress}</div>
                      <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
                        {normalizeCompanies(point.companies).map((comp, cIdx) => {
                          const key = `point-${pIdx}-comp-${cIdx}`;
                          return (
                            <div key={key} style={{ padding: 10, borderRadius: 8, background: 'var(--panel-2)', border: '1px solid var(--border)', display: 'flex', alignItems: 'center', gap: 10 }}>
                              <div style={{ flex: 1, minWidth: 0, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{comp.name}</div>
                              <div style={{ display: 'flex', alignItems: 'center', gap: 6, flexShrink: 0 }}>
                                <input type="number" min="0" value={courierLocalCounts[key] ?? 0} onChange={(e) => setCourierLocalCounts(prev => ({ ...prev, [key]: Math.max(0, Number(e.target.value) || 0) }))} className="input" style={{ width: 70, textAlign: 'center' }} />
                                <span className="muted" style={{ fontSize: 11 }}>шт.</span>
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    </div>
                  ))}
                </div>
              )}
              <div style={{ marginTop: 14, padding: 12, borderRadius: 10, background: 'var(--green-soft)', border: '1px solid var(--green)', display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                <span style={{ color: 'var(--green)', fontWeight: 700 }}>📊 Итого:</span>
                <span style={{ color: 'var(--green)', fontWeight: 800, fontSize: 18 }}>{Object.values(courierLocalCounts).reduce((s, v) => s + (v || 0), 0)} шт.</span>
              </div>
            </div>
            <div className="modal-foot">
              <button onClick={handleCourierCancelReceived} className="btn">← Отмена</button>
              <button onClick={handleCourierConfirmReceived} className="btn btn-green">✓ Завершить</button>
            </div>
          </div>
        </div>
      )}

      {/* ================= МОДАЛКА КУРЬЕРА: ОТПРАВКА ================= */}
      {isCourierSendModalOpen && sendModalTask && (
        <div className="modal-backdrop">
          <div className="modal">
            <div className="modal-head">
              <h2 className="modal-title">📤 Отправка писем</h2>
              <button onClick={() => { setIsCourierSendModalOpen(false); setSendModalTask(null); setSendLetterCount(''); setSendMethod(''); }} style={{ border: 0, background: 'none', fontSize: 24, color: 'var(--muted)', cursor: 'pointer' }}>&times;</button>
            </div>
            <div className="modal-body">
              <div className="info-line">Задача: <b>{sendModalTask.title}</b></div>
              {sendModalTask.clientCompany && <div className="info-line">🏢 <b>{sendModalTask.clientCompany}</b></div>}
              <div className="field" style={{ marginTop: 14 }}>
                <label className="label">📄 Количество писем <span style={{ color: 'var(--red)' }}>*</span></label>
                <input type="number" min="0" value={sendLetterCount} onChange={(e) => setSendLetterCount(e.target.value)} placeholder="0" className="input" />
              </div>
              <div className="field">
                <label className="label">🚚 Способ отправки <span style={{ color: 'var(--red)' }}>*</span></label>
                <div className="grid-2">
                  <button onClick={() => setSendMethod('ABS')} className={`btn ${sendMethod === 'ABS' ? 'btn-primary' : ''}`} style={{ padding: 14 }}>
                    <div style={{ fontSize: 22 }}>🏢</div><div>АБС</div>
                  </button>
                  <button onClick={() => setSendMethod('OPS')} className={`btn ${sendMethod === 'OPS' ? 'btn-primary' : ''}`} style={{ padding: 14 }}>
                    <div style={{ fontSize: 22 }}>📮</div><div>ОПС</div>
                  </button>
                </div>
              </div>
            </div>
            <div className="modal-foot">
              <button onClick={() => { setIsCourierSendModalOpen(false); setSendModalTask(null); setSendLetterCount(''); setSendMethod(''); }} className="btn">← Отмена</button>
              <button onClick={handleCourierConfirmSend} className="btn btn-green">✓ Завершить</button>
            </div>
          </div>
        </div>
      )}

      {/* ================= СТРАНИЦА: ОПЕРАТОР ================= */}
      {currentPage === 'operator' && (
        <div className="page">
          <div className="page-wide">
            {operatorTab === 'receive' && (
              <div className="panel">
                <h2 className="panel-title" style={{ marginBottom: 16 }}>📥 Получение писем</h2>
                <div className="grid-4">
                  {renderOperatorDateControls()}
                  <div className="field">
                    <label className="label">Курьер:</label>
                    <select value={operatorCourierFilter} onChange={(e) => setOperatorCourierFilter(e.target.value)} className="select">
                      <option value="">Все курьеры</option>
                      {couriers.map(c => <option key={c.id} value={c.id}>{c.fullName || c.name}</option>)}
                    </select>
                  </div>
                  <div className="field" style={{ gridColumn: 'span 2' }}>
                    <label className="label">🔍 Поиск:</label>
                    <input type="text" value={operatorSearch} onChange={(e) => setOperatorSearch(e.target.value)} placeholder="По названию, курьеру, компании..." className="input" />
                  </div>
                </div>
                <div className="notice blue" style={{ marginTop: 8 }}>
                  🔌 API для передачи сканов: <input type="text" value={scanApiUrl} onChange={(e) => handleSaveScanApiUrl(e.target.value)} placeholder="https://example.com/api/scans" className="input" style={{ display: 'inline-block', width: 300, marginLeft: 8, padding: '4px 8px' }} />
                  <span className="muted" style={{ fontSize: 11, marginLeft: 6 }}>адрес сохраняется автоматически</span>
                </div>
                {operatorTasks.length === 0 ? (
                  <div className="empty" style={{ marginTop: 16 }}><div className="empty-icon">📭</div>Нет задач для получения</div>
                ) : (
                  <div style={{ marginTop: 16, display: 'flex', flexDirection: 'column', gap: 14 }}>
                    {operatorTasks.map(task => {
                      const courier = couriers.find(c => c.id === task.status);
                      const courierDisplayName = courier?.fullName || courier?.name || 'Не назначен';
                      const taskCounts = localReceivedCounts[task.id] || {};
                      const pendingGroups: { key: string; comp: CompanyItem; pointTitle?: string }[] = [];
                      if (task.type === 'post') {
                        normalizeCompanies(task.companies).forEach((c, idx) => { if (!c.operatorConfirmed && (c.receivedCount ?? 0) > 0) pendingGroups.push({ key: 'post-' + idx, comp: c }); });
                      } else if (task.type === 'complex' && task.postPoints) {
                        task.postPoints.forEach((point, pIdx) => { normalizeCompanies(point.companies).forEach((c, cIdx) => { if (!c.operatorConfirmed && (c.receivedCount ?? 0) > 0) pendingGroups.push({ key: `point-${pIdx}-comp-${cIdx}`, comp: c, pointTitle: point.postIndex + ', ' + point.postAddress }); }); });
                      }
                      if (pendingGroups.length === 0) return null;
                      const renderCompanyRow = (key: string, comp: CompanyItem, pointTitle?: string) => {
                        const count = taskCounts[key] ?? comp.receivedCount ?? 0;
                        const mapKey = task.id + '|' + key;
                        const companyScans = scansFor(task.id, key);
                        const panelOpen = !!operatorScansOpen[mapKey];
                        return (
                          <div key={key} style={{ padding: 12, borderRadius: 10, background: 'var(--panel-2)', border: '1px solid var(--border)', display: 'flex', flexDirection: 'column', gap: 10 }}>
                            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: 10, flexWrap: 'wrap' }}>
                              <div style={{ flex: 1 }}>
                                {pointTitle && <div style={{ fontSize: 11, color: 'var(--purple)', marginBottom: 3 }}>📮 {pointTitle}</div>}
                                <div style={{ fontWeight: 600 }}>{comp.name}</div>
                                <div style={{ fontSize: 11, color: 'var(--accent)', marginTop: 2 }}>Курьер указал: <b style={{ fontFamily: 'monospace' }}>{comp.receivedCount}</b> шт.</div>
                              </div>
                              <div style={{ display: 'flex', alignItems: 'center', gap: 6, flexWrap: 'wrap' }}>
                                <label className="muted" style={{ fontSize: 11 }}>Получено:</label>
                                <input type="number" min="0" value={count} onChange={(e) => setLocalReceivedCount(task.id, key, Math.max(0, Number(e.target.value) || 0))} className="input" style={{ width: 70, textAlign: 'center' }} />
                                <span className="muted" style={{ fontSize: 11 }}>шт.</span>
                                <button onClick={() => setOperatorScansOpen(prev => ({ ...prev, [mapKey]: !panelOpen }))} className={`btn btn-sm ${companyScans.length > 0 ? 'btn-primary' : ''}`}>📷 Сканы: {companyScans.length}</button>
                                {canAction('operatorConfirm') ? (
                                  <button onClick={() => { if (confirm(`✓ Подтвердить ${count} писем для "${comp.name}"?`)) handleConfirmCompany(task, key, count); }} className="btn btn-green btn-sm">✓ Подтвердить</button>
                                ) : <span className="muted" style={{ fontSize: 11 }}>Нет прав</span>}
                              </div>
                            </div>
                            {panelOpen && (
                              <div style={{ padding: 10, borderRadius: 8, background: 'var(--panel-3)', border: '1px solid var(--border)' }}>
                                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 8, flexWrap: 'wrap', gap: 6 }}>
                                  <div style={{ fontSize: 11, color: 'var(--cyan)', fontWeight: 600 }}>📷 Сканы «{comp.name}» ({companyScans.length})</div>
                                  <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap' }}>
                                    <label className="btn btn-sm" style={{ cursor: 'pointer' }}>➕ Файл<input type="file" accept="image/*" className="hidden" onChange={(e) => { const f = e.target.files?.[0]; if (f) handleOperatorAddScanFile(task.id, key, f); e.target.value = ''; }} /></label>
                                    <button onClick={() => handleSendScansApi(task, key, comp.name, count)} className="btn btn-primary btn-sm">📤 API</button>
                                  </div>
                                </div>
                                {scanSendStatus[mapKey] && <div style={{ fontSize: 11, color: 'var(--muted)', marginBottom: 6 }}>{scanSendStatus[mapKey]}</div>}
                                {companyScans.length === 0 ? (
                                  <div className="muted" style={{ fontSize: 12 }}>Сканов нет</div>
                                ) : (
                                  <div className="grid-4" style={{ gap: 6 }}>
                                    {companyScans.map((s, si) => (
                                      <div key={s.id} style={{ position: 'relative', background: 'var(--panel-2)', border: '1px solid var(--border)', borderRadius: 8, overflow: 'hidden' }}>
                                        <img src={s.dataUrl} alt={`Скан ${si + 1}`} style={{ width: '100%', height: 90, objectFit: 'cover', cursor: 'pointer' }} onClick={() => setLightboxScan(s)} />
                                        <div style={{ position: 'absolute', top: 4, left: 4, background: 'rgba(0,0,0,.7)', color: '#fff', fontSize: 10, padding: '2px 6px', borderRadius: 4 }}>#{si + 1}</div>
                                        {s.sentAt && <div style={{ position: 'absolute', bottom: 4, left: 4, background: 'var(--accent-soft)', color: 'var(--accent)', fontSize: 10, padding: '2px 6px', borderRadius: 4 }}>📤</div>}
                                        <div style={{ position: 'absolute', top: 4, right: 4, display: 'flex', flexDirection: 'column', gap: 3 }}>
                                          <button onClick={() => handleOperatorRotateScan(s)} title="Повернуть" style={{ background: 'var(--panel)', color: 'var(--text)', fontSize: 10, width: 20, height: 20, borderRadius: 4, border: '1px solid var(--border)', cursor: 'pointer' }}>↻</button>
                                          <button onClick={() => handleOperatorDeleteScan(s)} title="Удалить" style={{ background: 'var(--red)', color: '#fff', fontSize: 10, width: 20, height: 20, borderRadius: 4, border: 0, cursor: 'pointer' }}>&times;</button>
                                        </div>
                                      </div>
                                    ))}
                                  </div>
                                )}
                              </div>
                            )}
                          </div>
                        );
                      };
                      return (
                        <div key={task.id} className="card">
                          <div className="card-head" style={{ background: 'var(--green-soft)', borderBottom: '1px solid var(--green)' }}>
                            <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', marginBottom: 4, alignItems: 'center' }}>
                              <span className="badge badge-new">👤 {courierDisplayName}</span>
                              <span className="muted" style={{ fontSize: 11 }}>🕐 {task.time}</span>
                            </div>
                            <div style={{ fontWeight: 700, fontSize: 15 }}>{task.title}</div>
                          </div>
                          <div className="card-body">
                            <div style={{ padding: 10, borderRadius: 10, background: 'var(--purple-soft)', border: '1px solid var(--purple)' }}>
                              <div style={{ fontSize: 12, color: 'var(--purple)', fontWeight: 700, marginBottom: 10 }}>
                                {task.type === 'post' ? `📮 ${task.postIndex}, ${task.postAddress}` : '📦 Сборная задача'}
                              </div>
                              <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
                                {pendingGroups.map(g => renderCompanyRow(g.key, g.comp, g.pointTitle))}
                              </div>
                            </div>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                )}
              </div>
            )}

            {operatorTab === 'send' && (
              <>
                <div className="panel">
                  <h2 className="panel-title" style={{ marginBottom: 16 }}>📤 Отправка писем</h2>
                  <div className="grid-4">
                    {renderOperatorDateControls()}
                    <div className="field">
                      <label className="label">Курьер:</label>
                      <select value={operatorCourierFilter} onChange={(e) => setOperatorCourierFilter(e.target.value)} className="select">
                        <option value="">Все курьеры</option>
                        {couriers.map(c => <option key={c.id} value={c.id}>{c.fullName || c.name}</option>)}
                      </select>
                    </div>
                    <div className="field" style={{ gridColumn: 'span 2' }}>
                      <label className="label">🔍 Поиск:</label>
                      <input type="text" value={operatorSearch} onChange={(e) => setOperatorSearch(e.target.value)} placeholder="По названию, клиенту, курьеру, способу..." className="input" />
                    </div>
                  </div>
                </div>
                <div className="stats">
                  <div className="stat"><div className="stat-label">📤 Задач на отправку</div><div className="stat-value">{operatorSendSummary.total}</div></div>
                  <div className="stat"><div className="stat-label">📄 Писем к отправке</div><div className="stat-value blue">{operatorSendSummary.totalLetters}</div></div>
                  <div className="stat"><div className="stat-label">🏢 АБС</div><div className="stat-value blue">{operatorSendSummary.absCount} <span style={{ fontSize: 12, fontWeight: 400 }}>({operatorSendSummary.absLetters})</span></div></div>
                  <div className="stat"><div className="stat-label">📮 ОПС</div><div className="stat-value" style={{ color: 'var(--purple)' }}>{operatorSendSummary.opsCount} <span style={{ fontSize: 12, fontWeight: 400 }}>({operatorSendSummary.opsLetters})</span></div></div>
                </div>
                {operatorSendTasks.length === 0 ? (
                  <div className="empty"><div className="empty-icon">📤</div>Нет данных об отправке</div>
                ) : (
                  <div style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>
                    {operatorSendTasks.map(task => {
                      const courier = couriers.find(c => c.id === task.status);
                      const courierDisplayName = courier?.fullName || courier?.name || 'Не назначен';
                      const methodMeta = task.sendMethod ? SEND_METHOD_META[task.sendMethod] : null;
                      return (
                        <div key={task.id} className="card">
                          <div className="card-head" style={{ background: 'var(--accent-soft)', borderBottom: '1px solid var(--accent)' }}>
                            <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap', marginBottom: 4, alignItems: 'center' }}>
                              <span className="badge badge-new">👤 {courierDisplayName}</span>
                              {methodMeta && <span className={`badge ${task.sendMethod === 'ABS' ? 'badge-new' : 'badge-post'}`}>{methodMeta.icon} {methodMeta.label} · {task.sentLetterCount} писем</span>}
                              <span className="muted" style={{ fontSize: 11 }}>🕐 {task.time}</span>
                            </div>
                            <div style={{ fontWeight: 700, fontSize: 15 }}>{task.title}</div>
                          </div>
                          <div className="card-body">
                            <div style={{ fontSize: 13, display: 'flex', flexDirection: 'column', gap: 3 }}>
                              <div>🏢 <b>{task.clientCompany || '—'}</b></div>
                              <div>📍 {task.clientAddress || '—'}</div>
                              <div>📄 Писем от клиента: <b style={{ fontFamily: 'monospace', color: 'var(--accent)' }}>{task.sentLetterCount}</b></div>
                              {task.courierComments && <div style={{ padding: 8, borderRadius: 6, background: 'var(--yellow-soft)', border: '1px solid var(--yellow)', fontSize: 12, marginTop: 4 }}>📝 {task.courierComments}</div>}
                            </div>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                )}
              </>
            )}

            {operatorTab === 'returns' && (
              <>
                <div className="panel">
                  <h2 className="panel-title" style={{ marginBottom: 4 }}>📨 Возвраты и оплата клиентов</h2>
                  <p className="muted" style={{ fontSize: 12, marginBottom: 12 }}>Отметьте возвраты, по которым клиент внёс оплату.</p>
                  {renderOperatorDateControls()}
                  <div className="field" style={{ marginTop: 12 }}>
                    <label className="label">🔍 Поиск по компании-клиенту:</label>
                    <input type="text" value={returnCompanySearch} onChange={(e) => setReturnCompanySearch(e.target.value)} placeholder="Начните вводить название компании..." className="input" />
                  </div>
                </div>
                <div className="stats">
                  <div className="stat"><div className="stat-label">📨 Возвратов ожидает оплаты</div><div className="stat-value red">{returnsPending.length}</div></div>
                  <div className="stat"><div className="stat-label">💰 Стоимость возвратов</div><div className="stat-value" style={{ color: 'var(--yellow)' }}>{formatMoney(returnsPendingSum)}</div></div>
                  <div className="stat"><div className="stat-label">✅ Оплачено возвратов</div><div className="stat-value green">{returnsDone.length}</div></div>
                  <div className="stat"><div className="stat-label">💵 Получено по возврату</div><div className="stat-value green">{formatMoney(returnsDoneSum)}</div></div>
                </div>
                {returnsPending.length === 0 ? (
                  <div className="empty"><div className="empty-icon">📨</div>Нет возвратов, ожидающих оплаты</div>
                ) : (
                  <div className="card">
                    <div className="card-head" style={{ background: 'var(--red-soft)', borderBottom: '1px solid var(--red)' }}>
                      <h3 style={{ margin: 0, color: 'var(--red)' }}>📨 Возвраты к оплате</h3>
                    </div>
                    <div className="table-wrap">
                      <table>
                        <thead>
                          <tr>
                            <th style={{ textAlign: 'center' }}>✓</th>
                            <th>Дата возврата</th>
                            <th>Клиент</th>
                            <th style={{ textAlign: 'center' }}>Писем</th>
                            <th style={{ textAlign: 'right' }}>Стоимость возврата</th>
                            <th style={{ textAlign: 'right' }}>Получено от клиента (₽)</th>
                          </tr>
                        </thead>
                        <tbody>
                          {returnsPending.map((op, idx) => (
                            <tr key={op.id} style={{ background: returnSelected[op.id] ? 'var(--green-soft)' : undefined }}>
                              <td style={{ textAlign: 'center' }}><input type="checkbox" checked={!!returnSelected[op.id]} onChange={() => setReturnSelected(prev => ({ ...prev, [op.id]: !prev[op.id] }))} style={{ width: 16, height: 16, accentColor: 'var(--green)', cursor: 'pointer' }} /></td>
                              <td className="nowrap">{formatDateShort(op.date)}</td>
                              <td><b>{op.clientName || '—'}</b></td>
                              <td style={{ textAlign: 'center', fontFamily: 'monospace' }}>{op.letterCount ?? '—'}</td>
                              <td style={{ textAlign: 'right', fontFamily: 'monospace', color: 'var(--red)', fontWeight: 700 }}>{formatMoney(op.amount)}</td>
                              <td style={{ textAlign: 'right' }}>
                                <input type="number" min="0" step="0.01" value={returnAmounts[op.id] ?? ''} onChange={(e) => setReturnAmounts(prev => ({ ...prev, [op.id]: e.target.value }))} placeholder={String(op.amount)} className="input" style={{ width: 110, textAlign: 'right' }} />
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                    <div className="card-foot" style={{ justifyContent: 'space-between' }}>
                      <div className="muted" style={{ fontSize: 12 }}>Выбрано: <b style={{ color: 'var(--text)' }}>{returnsPending.filter(op => returnSelected[op.id]).length}</b></div>
                      {canAction('operatorConfirm') ? (
                        <button onClick={handleProcessReturns} className="btn btn-green">💰 Провести полученные суммы в кассу</button>
                      ) : <span className="muted" style={{ fontSize: 12 }}>Нет прав</span>}
                    </div>
                  </div>
                )}
                {returnsDone.length > 0 && (
                  <div className="card">
                    <div className="card-head" style={{ background: 'var(--green-soft)', borderBottom: '1px solid var(--green)' }}>
                      <h3 style={{ margin: 0, color: 'var(--green)' }}>✅ Оплаченные возвраты</h3>
                    </div>
                    <div className="table-wrap">
                      <table>
                        <thead>
                          <tr>
                            <th>Дата возврата</th>
                            <th>Клиент</th>
                            <th style={{ textAlign: 'center' }}>Писем</th>
                            <th style={{ textAlign: 'right' }}>Стоимость</th>
                            <th style={{ textAlign: 'right' }}>Получено</th>
                            <th>Дата оплаты</th>
                          </tr>
                        </thead>
                        <tbody>
                          {returnsDone.map(op => (
                            <tr key={op.id}>
                              <td className="nowrap">{formatDateShort(op.date)}</td>
                              <td><b>{op.clientName || '—'}</b></td>
                              <td style={{ textAlign: 'center', fontFamily: 'monospace' }}>{op.letterCount ?? '—'}</td>
                              <td style={{ textAlign: 'right', fontFamily: 'monospace', color: 'var(--red)' }}>{formatMoney(op.amount)}</td>
                              <td style={{ textAlign: 'right', fontFamily: 'monospace', color: 'var(--green)', fontWeight: 700 }}>{formatMoney(op.compensated?.amount || 0)}</td>
                              <td className="nowrap">{op.compensated ? new Date(op.compensated.at).toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }) : '—'}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                )}
              </>
            )}

            {operatorTab === 'archive' && (
              <div className="panel">
                <h2 className="panel-title" style={{ marginBottom: 12 }}>📦 Архив подтверждённых компаний</h2>
                <input type="text" value={archiveSearch} onChange={(e) => setArchiveSearch(e.target.value)} placeholder="🔍 Поиск..." className="input" style={{ marginBottom: 16 }} />
                {archivedData.length === 0 ? (
                  <div className="empty"><div className="empty-icon">📦</div>Архив пуст</div>
                ) : (
                  <div style={{ display: 'flex', flexDirection: 'column', gap: 12 }}>
                    {archivedData.map((item, idx) => (
                      <div key={idx} className="card">
                        <div className="card-head" style={{ background: 'var(--green-soft)', borderBottom: '1px solid var(--green)' }}>
                          <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap', marginBottom: 4, alignItems: 'center' }}>
                            <span className="badge badge-new">👤 {item.courier?.fullName || item.courier?.name || 'Не назначен'}</span>
                            <span className="muted" style={{ fontSize: 11 }}>📅 {formatDateShort(item.task.date)}</span>
                          </div>
                          <div style={{ fontWeight: 700 }}>{item.task.title}</div>
                        </div>
                        <div className="card-body" style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
                          {item.companies.map((compItem, cIdx) => {
                            const confirmedDate = compItem.company.confirmedAt ? new Date(compItem.company.confirmedAt) : null;
                            const cell = getClientCell(compItem.company.name);
                            return (
                              <div key={cIdx} style={{ padding: 12, borderRadius: 10, background: 'var(--panel-2)', border: '1px solid var(--border)', display: 'flex', justifyContent: 'space-between', alignItems: 'center', gap: 12, flexWrap: 'wrap' }}>
                                <div style={{ flex: 1 }}>
                                  {compItem.pointTitle && <div style={{ fontSize: 11, color: 'var(--purple)', marginBottom: 3 }}>📮 {compItem.pointTitle}</div>}
                                  <div style={{ fontWeight: 600, display: 'flex', gap: 6, alignItems: 'center', flexWrap: 'wrap' }}>
                                    {compItem.company.name}
                                    {cell && <span style={{ fontSize: 11, background: 'var(--cyan-soft)', color: 'var(--cyan)', padding: '2px 7px', borderRadius: 5, fontFamily: 'monospace' }}>🗄️ {cell}</span>}
                                  </div>
                                  <div style={{ fontSize: 11, color: 'var(--muted)', marginTop: 3 }}>
                                    Получено: <b style={{ color: 'var(--green)', fontFamily: 'monospace' }}>{compItem.company.receivedCount ?? 0}</b>
                                    {confirmedDate && <span> · ✓ {confirmedDate.toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' })}</span>}
                                  </div>
                                </div>
                                {canAction('operatorConfirm') ? (
                                  <button onClick={() => handleUnconfirmCompany(item.task, compItem.companyKey)} className="btn btn-sm" style={{ background: 'var(--yellow-soft)', color: 'var(--yellow)', borderColor: 'var(--yellow)' }}>↩️ Отменить</button>
                                ) : <span className="muted" style={{ fontSize: 11 }}>Нет прав</span>}
                              </div>
                            );
                          })}
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            )}
          </div>
        </div>
      )}

      {/* ================= ЛАЙТБОКС ================= */}
      {lightboxScan && (
        <div className="lightbox" onClick={() => setLightboxScan(null)}>
          <div onClick={(e) => e.stopPropagation()} style={{ maxWidth: '92vw' }}>
            <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 8, alignItems: 'center', gap: 12 }}>
              <div style={{ fontSize: 12, color: '#fff', opacity: .8 }}>
                📷 {lightboxScan.width}×{lightboxScan.height} · {new Date(lightboxScan.createdAt).toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' })}
                {lightboxScan.sentAt && ` · 📤 ${new Date(lightboxScan.sentAt).toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' })}`}
              </div>
              <button onClick={() => setLightboxScan(null)} style={{ border: 0, background: 'none', fontSize: 28, color: '#fff', cursor: 'pointer' }}>&times;</button>
            </div>
            <img src={lightboxScan.dataUrl} alt="Скан" style={{ maxWidth: '92vw', maxHeight: '75vh', borderRadius: 12, border: '1px solid #333' }} />
            <div style={{ display: 'flex', gap: 8, marginTop: 12, justifyContent: 'center' }}>
              <button onClick={() => handleOperatorRotateScan(lightboxScan)} className="btn">↻ Повернуть</button>
              <button onClick={() => { const a = document.createElement('a'); a.href = lightboxScan.dataUrl; a.download = 'scan_' + lightboxScan.id.replace(/\|/g, '_') + '.jpg'; a.click(); }} className="btn btn-primary">💾 Скачать</button>
              <button onClick={() => handleOperatorDeleteScan(lightboxScan)} className="btn btn-red">🗑 Удалить</button>
            </div>
          </div>
        </div>
      )}
      {/* ================= СТРАНИЦА: АДМИН ================= */}
      {currentPage === 'admin' && (
        <div className="page">
          <div className="page-wide">
            {adminTab === 'couriers' && (
              <div className="panel">
                <h2 className="panel-title" style={{ marginBottom: 16 }}>👥 Управление курьерами</h2>
                {canAction('manageCouriers') && (
                  <div style={{ padding: 14, borderRadius: 10, background: 'var(--panel-2)', border: '1px solid var(--border)', marginBottom: 16, display: 'flex', gap: 8 }}>
                    <input type="text" value={newCourierName} onChange={(e) => setNewCourierName(e.target.value)} placeholder="Короткое имя" className="input" style={{ flex: 1 }} />
                    <button onClick={() => { setCourierForm({ name: newCourierName, fullName: '', phone: '', passport: '', comments: '' }); handleSaveCourier(); setNewCourierName(''); }} className="btn btn-primary">+ Добавить</button>
                  </div>
                )}
                <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
                  {couriers.filter(c => c.id !== 'unassigned').map(courier => (
                    <div key={courier.id} style={{ padding: 12, borderRadius: 10, background: 'var(--panel-2)', border: '1px solid var(--border)', display: 'flex', alignItems: 'center', gap: 12 }}>
                      <div style={{ flex: 1, cursor: canAction('manageCouriers') ? 'pointer' : 'default' }} onClick={() => { if (!canAction('manageCouriers')) return; setEditingCourier(courier); setCourierForm({ name: courier.name, fullName: courier.fullName || '', phone: courier.phone || '', passport: courier.passport || '', comments: courier.comments || '' }); setIsCourierModalOpen(true); }}>
                        <div style={{ fontWeight: 600 }}>{courier.name} {courier.fullName && <span className="muted" style={{ fontSize: 12, fontWeight: 400 }}>({courier.fullName})</span>}</div>
                        <div className="muted" style={{ fontSize: 12, marginTop: 2 }}>Задач сегодня: <b style={{ color: 'var(--accent)' }}>{tasks.filter(t => t.status === courier.id && t.date === today).length}</b></div>
                      </div>
                      {canAction('manageCouriers') && <button onClick={() => handleDeleteCourier(courier.id)} className="btn btn-red btn-sm">🗑️</button>}
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* 🆕 КЛИЕНТЫ: с ячейкой, тарифом и активностью */}
            {adminTab === 'clients' && (
              <div className="panel">
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 16, flexWrap: 'wrap', gap: 12 }}>
                  <h2 className="panel-title">🏢 База клиентов <span className="muted" style={{ fontSize: 13, fontWeight: 400 }}>({clients.length})</span></h2>
                  <div style={{ display: 'flex', gap: 8 }}>
                    {canAction('importClients') && (
                      <label className="btn btn-green" style={{ cursor: 'pointer' }}>
                        📥 Импорт Excel
                        <input type="file" accept=".xlsx,.xls" onChange={handleImportExcel} className="hidden" />
                      </label>
                    )}
                    {canAction('manageClients') && (
                      <button onClick={() => { setEditingClient(null); setClientForm({ companyName: '', contactPerson: '', phone: '', address: '', note: '', postOffice: '', holding: '', contractEndDate: '', powerOfAttorneyEndDate: '', deliveryPickupRate: '', cell: '', active: true }); setIsClientModalOpen(true); }} className="btn btn-primary">+ Добавить</button>
                    )}
                  </div>
                </div>
                {importExcelStatus && (
                  <div className={`notice ${importExcelStatus.type === 'success' ? 'green' : importExcelStatus.type === 'error' ? 'red' : 'blue'}`}>
                    {importExcelStatus.message}
                  </div>
                )}
                <input type="text" value={clientSearch} onChange={(e) => setClientSearch(e.target.value)} placeholder="🔍 Поиск по названию, адресу, отделению, холдингу..." className="input" style={{ marginBottom: 16 }} />
                {filteredClients.length === 0 ? (
                  <div className="empty">Клиенты не найдены</div>
                ) : (
                  <div className="table-wrap">
                    <table style={{ minWidth: 1100 }}>
                      <thead>
                        <tr>
                          <th>Наименование</th>
                          <th>Адрес</th>
                          <th>Почтовое отделение</th>
                          <th style={{ textAlign: 'center' }}>Ячейка</th>
                          <th style={{ textAlign: 'center' }}>Договор до</th>
                          <th style={{ textAlign: 'center' }}>Доверенность до</th>
                          <th style={{ textAlign: 'right' }}>Тариф</th>
                          <th style={{ textAlign: 'center' }}>Статус</th>
                        </tr>
                      </thead>
                      <tbody>
                        {filteredClients.map((client, idx) => {
                          const isActive = (client as any).active !== false;
                          return (
                            <tr key={client.id} style={{ opacity: isActive ? 1 : 0.5 }}>
                              <td style={{ maxWidth: 220 }}>
                                {canAction('manageClients') ? (
                                  <button
                                    onClick={() => { setEditingClient(client); setClientForm({ companyName: client.companyName, contactPerson: client.contactPerson, phone: client.phone, address: client.address, note: client.note, postOffice: client.postOffice || '', holding: client.holding || '', contractEndDate: (client as any).contractEndDate || '', powerOfAttorneyEndDate: (client as any).powerOfAttorneyEndDate || '', deliveryPickupRate: (client as any).deliveryPickupRate || '', cell: (client as any).cell || '', active: isActive }); setIsClientModalOpen(true); }}
                                    className="link-btn"
                                    title={client.companyName}
                                  >
                                    <span style={{ display: 'block', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap', maxWidth: 220 }}>{client.companyName}</span>
                                  </button>
                                ) : (
                                  <span style={{ display: 'block', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap', maxWidth: 220 }} title={client.companyName}>{client.companyName}</span>
                                )}
                                {client.holding && <div style={{ fontSize: 11, color: 'var(--accent)', marginTop: 2, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>🏗️ {client.holding}</div>}
                              </td>
                              <td style={{ maxWidth: 240 }}><div style={{ overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }} title={client.address}>{client.address || '—'}</div></td>
                              <td className="nowrap">
                                {client.postOffice ? (
                                  <span style={{ fontSize: 11, background: 'var(--purple-soft)', color: 'var(--purple)', padding: '3px 8px', borderRadius: 5, display: 'inline-block', maxWidth: 220, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }} title={client.postOffice}>
                                    📮 {client.postOffice.length > 28 ? client.postOffice.slice(0, 28) + '…' : client.postOffice}
                                  </span>
                                ) : <span className="muted">—</span>}
                              </td>
                              <td style={{ textAlign: 'center' }}>
                                {(client as any).cell ? (
                                  <span style={{ fontSize: 11, background: 'var(--cyan-soft)', color: 'var(--cyan)', padding: '3px 8px', borderRadius: 5, fontFamily: 'monospace', fontWeight: 600 }}>🗄️ {(client as any).cell}</span>
                                ) : <span className="muted">—</span>}
                              </td>
                              <td style={{ textAlign: 'center' }}>
                                {client.contractEndDate ? (
                                  <span style={{ fontSize: 11, fontFamily: 'monospace', padding: '3px 8px', borderRadius: 5, background: client.contractEndDate < getTodayString() ? 'var(--red-soft)' : 'var(--green-soft)', color: client.contractEndDate < getTodayString() ? 'var(--red)' : 'var(--green)' }}>
                                    {formatDateShort(client.contractEndDate)}{client.contractEndDate < getTodayString() ? ' ⚠' : ''}
                                  </span>
                                ) : <span className="muted">—</span>}
                              </td>
                              <td style={{ textAlign: 'center' }}>
                                {client.powerOfAttorneyEndDate ? (
                                  <span style={{ fontSize: 11, fontFamily: 'monospace', padding: '3px 8px', borderRadius: 5, background: client.powerOfAttorneyEndDate < getTodayString() ? 'var(--red-soft)' : 'var(--green-soft)', color: client.powerOfAttorneyEndDate < getTodayString() ? 'var(--red)' : 'var(--green)' }}>
                                    {formatDateShort(client.powerOfAttorneyEndDate)}{client.powerOfAttorneyEndDate < getTodayString() ? ' ⚠' : ''}
                                  </span>
                                ) : <span className="muted">—</span>}
                              </td>
                              <td style={{ textAlign: 'right' }}>
                                {client.deliveryPickupRate ? (
                                  <span style={{ color: 'var(--green)', fontFamily: 'monospace', fontWeight: 700 }}>{client.deliveryPickupRate} ₽</span>
                                ) : <span className="muted">—</span>}
                              </td>
                              <td style={{ textAlign: 'center' }}>
                                {canAction('manageClients') ? (
                                  <button
                                    onClick={() => toggleClientActive(client.id)}
                                    className={`btn btn-sm ${isActive ? 'btn-green' : 'btn-red'}`}
                                    title={isActive ? 'Нажмите, чтобы сделать неактивным' : 'Нажмите, чтобы активировать'}
                                  >
                                    {isActive ? '✅ Активен' : '🚫 Неактивен'}
                                  </button>
                                ) : (
                                  <span className={`badge ${isActive ? 'badge-done' : 'badge-red'}`}>
                                    {isActive ? '✅' : '🚫'}
                                  </span>
                                )}
                              </td>
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>
                )}
              </div>
            )}

            {/* 🆕 ОТДЕЛЕНИЯ: широкая таблица с днями посещения */}
            {adminTab === 'offices' && (
              <div className="panel">
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 16, flexWrap: 'wrap', gap: 12 }}>
                  <h2 className="panel-title">📮 Почтовые отделения <span className="muted" style={{ fontSize: 13, fontWeight: 400 }}>({postOffices.length})</span></h2>
                  <input type="text" value={officeSearch} onChange={(e) => setOfficeSearch(e.target.value)} placeholder="🔍 Поиск..." className="input" style={{ width: 360 }} />
                </div>
                {postOffices.length === 0 ? (
                  <div className="empty"><div className="empty-icon">📮</div>Отделения не найдены</div>
                ) : (
                  <div className="table-wrap">
                    <table style={{ minWidth: 1100 }}>
                      <thead>
                        <tr>
                          <th>Индекс</th>
                          <th>Адрес отделения</th>
                          <th>Курьер</th>
                          <th>Комментарий</th>
                          <th>Почтальон</th>
                          <th>Контакт</th>
                          <th style={{ textAlign: 'center' }}>Клиентов</th>
                          <th style={{ textAlign: 'center' }}>Дни посещения</th>
                          <th style={{ textAlign: 'right' }}>Премия</th>
                          <th style={{ textAlign: 'center' }}>Действия</th>
                        </tr>
                      </thead>
                      <tbody>
                        {filteredOffices.map((office, idx) => {
                          const meta = (officeMeta[office.folderName] || { comment: '', postmanName: '', postmanPhone: '', bonus: '', courierId: '' }) as any;
                          const clientsCount = getClientsByPostOffice(office.folderName).length;
                          const bonusNum = parseFloat(meta.bonus) || 0;
                          const assignedCourier = couriers.find(c => c.id === meta.courierId);
                          const visitDays: number[] = meta.visitDays || [];
                          return (
                            <tr key={office.folderName}>
                              <td style={{ color: 'var(--accent)', fontFamily: 'monospace' }}>{office.index}</td>
                              <td>{office.address}</td>
                              <td className="nowrap">
                                {assignedCourier ? (
                                  <span style={{ fontSize: 11, background: 'var(--yellow-soft)', color: 'var(--yellow)', padding: '3px 8px', borderRadius: 5, display: 'inline-flex', alignItems: 'center', gap: 4 }}>🚚 {assignedCourier.fullName || assignedCourier.name}</span>
                                ) : <span className="muted">— не назначен</span>}
                              </td>
                              <td style={{ maxWidth: 200 }}><div style={{ overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }} title={meta.comment}>{meta.comment || '—'}</div></td>
                              <td className="nowrap">{meta.postmanName || '—'}</td>
                              <td className="nowrap">{meta.postmanPhone || '—'}</td>
                              <td style={{ textAlign: 'center' }}><span style={{ color: 'var(--green)', fontFamily: 'monospace', fontWeight: 700 }}>{clientsCount}</span></td>
                              <td style={{ textAlign: 'center' }}>
                                {visitDays.length > 0 ? (
                                  <div style={{ display: 'flex', gap: 3, justifyContent: 'center', flexWrap: 'wrap' }}>
                                    {visitDays.map((d: number) => (
                                      <span key={d} style={{ fontSize: 10, background: 'var(--accent-soft)', color: 'var(--accent)', padding: '2px 6px', borderRadius: 4, fontWeight: 600 }}>{DAY_LABELS_SHORT[d]}</span>
                                    ))}
                                  </div>
                                ) : <span className="muted" style={{ fontSize: 11 }}>—</span>}
                              </td>
                              <td style={{ textAlign: 'right', color: 'var(--yellow)', fontFamily: 'monospace', fontWeight: 700 }}>{bonusNum > 0 ? formatMoney(bonusNum) : '—'}</td>
                              <td style={{ textAlign: 'center' }}><button onClick={() => openOfficeEdit(office)} className="btn btn-primary btn-sm">✏️ Изменить</button></td>
                            </tr>
                          );
                        })}
                      </tbody>
                      <tfoot>
                        <tr>
                          <td colSpan={6} style={{ textAlign: 'right' }}>ИТОГО по {filteredOffices.length} отделениям:</td>
                          <td style={{ textAlign: 'center', color: 'var(--green)', fontFamily: 'monospace', fontWeight: 700 }}>{totalOfficeClients}</td>
                          <td colSpan={2} style={{ textAlign: 'right', color: 'var(--yellow)', fontFamily: 'monospace', fontWeight: 700 }}>{formatMoney(totalOfficeBonus)}</td>
                          <td></td>
                        </tr>
                      </tfoot>
                    </table>
                  </div>
                )}
              </div>
            )}

            {adminTab === 'reports' && (
              <>
                <div className="panel">
                  <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 16, flexWrap: 'wrap', gap: 12 }}>
                    <h2 className="panel-title">📊 Отчёты по работе курьеров</h2>
                    <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap' }}>
                      <div className="tabs">
                        <button onClick={() => setReportMode('tasks')} className={`tab ${reportMode === 'tasks' ? 'active' : ''}`}>📋 Задачи</button>
                        <button onClick={() => setReportMode('no_letters')} className={`tab ${reportMode === 'no_letters' ? 'active' : ''}`}>📭 Без писем ({clientsWithNoLetters.length})</button>
                      </div>
                      <button onClick={handleExportReport} className="btn btn-green">📥 Экспорт в Excel</button>
                    </div>
                  </div>
                  <div className="grid-4">
                    <div className="field">
                      <label className="label">📅 Период с:</label>
                      <input type="date" value={reportDateFrom} onChange={(e) => setReportDateFrom(e.target.value)} className="input" />
                    </div>
                    <div className="field">
                      <label className="label">📅 Период по:</label>
                      <input type="date" value={reportDateTo} onChange={(e) => setReportDateTo(e.target.value)} className="input" />
                    </div>
                    <div className="field">
                      <label className="label">👤 Курьер:</label>
                      <select value={reportCourierFilter} onChange={(e) => setReportCourierFilter(e.target.value)} className="select">
                        <option value="">Все курьеры</option>
                        {couriers.map(c => <option key={c.id} value={c.id}>{c.fullName || c.name}</option>)}
                      </select>
                    </div>
                    {reportMode === 'tasks' && (
                      <>
                        <div className="field">
                          <label className="label">🏷️ Тип задачи:</label>
                          <select value={reportTypeFilter} onChange={(e) => setReportTypeFilter(e.target.value)} className="select">
                            <option value="">Все типы</option>
                            <option value="post">📮 Почта</option>
                            <option value="delivery">🚚 Доставка</option>
                            <option value="pickup">📤 Отправка</option>
                            <option value="complex">📦 Сборная</option>
                          </select>
                        </div>
                        <div className="field">
                          <label className="label">📋 Статус:</label>
                          <select value={reportStatusFilter} onChange={(e) => setReportStatusFilter(e.target.value)} className="select">
                            <option value="">Все статусы</option>
                            <option value="new">🟢 Новые</option>
                            <option value="in_progress">🟡 В работе</option>
                            <option value="completed">✅ Завершённые</option>
                          </select>
                        </div>
                        <div className="field">
                          <label className="label">✅ Способ завершения:</label>
                          <select value={reportCompletionFilter} onChange={(e) => setReportCompletionFilter(e.target.value)} className="select">
                            <option value="">Любой</option>
                            <option value="visited">👣 С посещением</option>
                            <option value="no_visit">🚫 Без посещения</option>
                          </select>
                        </div>
                      </>
                    )}
                    <div className="field" style={{ gridColumn: reportMode === 'tasks' ? 'span 2' : 'span 3' }}>
                      <label className="label">🔍 Поиск:</label>
                      <input type="text" value={reportSearch} onChange={(e) => setReportSearch(e.target.value)} placeholder="Задача, клиент, адрес, организация, курьер..." className="input" />
                    </div>
                  </div>
                  <div style={{ display: 'flex', gap: 8, marginTop: 12, flexWrap: 'wrap', alignItems: 'center' }}>
                    <span className="muted" style={{ fontSize: 12 }}>Быстрый период:</span>
                    <button onClick={() => setReportPeriod('today')} className="btn btn-sm">Сегодня</button>
                    <button onClick={() => setReportPeriod('week')} className="btn btn-sm">7 дней</button>
                    <button onClick={() => setReportPeriod('month')} className="btn btn-sm">Месяц</button>
                    <button onClick={() => setReportPeriod('all')} className="btn btn-sm">Всё время</button>
                  </div>
                </div>

                {reportMode === 'tasks' && (
                  <>
                    <div className="stats">
                      <div className="stat"><div className="stat-label">📋 Всего задач</div><div className="stat-value">{reportSummary.total}</div></div>
                      <div className="stat"><div className="stat-label">✅ С посещением</div><div className="stat-value green">{reportSummary.completedVisited}</div></div>
                      <div className="stat"><div className="stat-label">🚫 Без посещения</div><div className="stat-value red">{reportSummary.completedNoVisit}</div></div>
                      <div className="stat"><div className="stat-label">🟡 В работе</div><div className="stat-value yellow">{reportSummary.inProgress}</div></div>
                      <div className="stat"><div className="stat-label">🟢 Новые</div><div className="stat-value blue">{reportSummary.newTasks}</div></div>
                      <div className="stat"><div className="stat-label">📬 / 📤 Письма</div><div style={{ fontSize: 16, fontWeight: 700, color: 'var(--purple)' }}>↓ {reportSummary.lettersReceived}</div><div style={{ fontSize: 16, fontWeight: 700, color: 'var(--accent)' }}>↑ {reportSummary.lettersSent}</div></div>
                    </div>
                    {reportByCourier.length > 0 && (
                      <div className="card">
                        <div className="card-head" style={{ background: 'var(--yellow-soft)', borderBottom: '1px solid var(--yellow)' }}>
                          <h3 style={{ margin: 0, color: 'var(--yellow)' }}>👥 Сводка по курьерам</h3>
                        </div>
                        <div className="table-wrap" style={{ border: 0, borderRadius: 0 }}>
                          <table>
                            <thead>
                              <tr>
                                <th>Курьер</th>
                                <th style={{ textAlign: 'center' }}>Всего</th>
                                <th style={{ textAlign: 'center' }}>✅ С посещением</th>
                                <th style={{ textAlign: 'center' }}>🚫 Без посещения</th>
                                <th style={{ textAlign: 'center' }}>🟡 В работе</th>
                                <th style={{ textAlign: 'center' }}>🟢 Новые</th>
                                <th style={{ textAlign: 'center' }}>📬 Получено</th>
                                <th style={{ textAlign: 'center' }}>📤 Отправлено</th>
                              </tr>
                            </thead>
                            <tbody>
                              {reportByCourier.map(row => (
                                <tr key={row.id}>
                                  <td style={{ fontWeight: 600 }}>{row.name}</td>
                                  <td style={{ textAlign: 'center', fontFamily: 'monospace', fontWeight: 700 }}>{row.total}</td>
                                  <td style={{ textAlign: 'center', fontFamily: 'monospace', color: 'var(--green)' }}>{row.completedVisited}</td>
                                  <td style={{ textAlign: 'center', fontFamily: 'monospace', color: 'var(--red)', fontWeight: 700 }}>{row.completedNoVisit}</td>
                                  <td style={{ textAlign: 'center', fontFamily: 'monospace', color: 'var(--yellow)' }}>{row.inProgress}</td>
                                  <td style={{ textAlign: 'center', fontFamily: 'monospace', color: 'var(--accent)' }}>{row.newCount}</td>
                                  <td style={{ textAlign: 'center', fontFamily: 'monospace', color: 'var(--purple)' }}>{row.lettersReceived}</td>
                                  <td style={{ textAlign: 'center', fontFamily: 'monospace', color: 'var(--accent)' }}>{row.lettersSent}</td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                      </div>
                    )}
                    <div className="card">
                      <div className="card-head" style={{ background: 'var(--yellow-soft)', borderBottom: '1px solid var(--yellow)' }}>
                        <h3 style={{ margin: 0, color: 'var(--yellow)' }}>📋 Детальный отчёт</h3>
                        {reportTasks.length > REPORT_MAX_ROWS && <p className="muted" style={{ fontSize: 11, marginTop: 4 }}>Показаны первые {REPORT_MAX_ROWS} из {reportTasks.length} задач.</p>}
                      </div>
                      {reportTasks.length === 0 ? (
                        <div className="empty"><div className="empty-icon">📊</div>Нет задач по выбранным фильтрам</div>
                      ) : (
                        <div className="table-wrap" style={{ border: 0, borderRadius: 0 }}>
                          <table>
                            <thead>
                              <tr>
                                <th>Дата</th>
                                <th>Курьер</th>
                                <th>Тип</th>
                                <th>Задача</th>
                                <th style={{ textAlign: 'center' }}>Писем</th>
                                <th>Статус</th>
                                <th>Завершение</th>
                                <th>Комментарий</th>
                              </tr>
                            </thead>
                            <tbody>
                              {reportTasks.slice(0, REPORT_MAX_ROWS).map(t => {
                                const courier = couriers.find(c => c.id === t.status);
                                const received = getTaskReceivedLetters(t);
                                const typeLabels: Record<TaskType, string> = { post: '📮 Почта', delivery: '🚚 Доставка', pickup: '📤 Отправка', complex: '📦 Сборная' };
                                const statusConfig: Record<string, { label: string; cls: string }> = { new: { label: '🟢 Новая', cls: 'badge-new' }, in_progress: { label: '🟡 В работе', cls: 'badge-progress' }, completed: { label: '✅ Завершена', cls: 'badge-done' } };
                                const st = statusConfig[t.workflowStatus] || { label: t.workflowStatus, cls: 'badge-gray' };
                                const comment = t.noVisitReason || t.courierComments || t.comments || '';
                                return (
                                  <tr key={t.id}>
                                    <td className="nowrap">{formatDateShort(t.date)}</td>
                                    <td className="nowrap">{courier?.fullName || courier?.name || 'Не назначен'}</td>
                                    <td className="nowrap">{typeLabels[t.type] || t.type}</td>
                                    <td style={{ maxWidth: 260 }}><div style={{ overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }} title={t.title}>{t.title}</div></td>
                                    <td style={{ textAlign: 'center', fontFamily: 'monospace' }}>{t.type === 'pickup' && t.sentLetterCount != null ? <span style={{ color: 'var(--accent)' }}>📤 {t.sentLetterCount}</span> : received > 0 ? <span style={{ color: 'var(--purple)' }}>📬 {received}</span> : '—'}</td>
                                    <td><span className={`badge ${st.cls}`}>{st.label}</span></td>
                                    <td>{t.workflowStatus === 'completed' ? (t.completionType === 'no_visit' ? <span className="badge badge-red">🚫 Без посещения</span> : <span className="badge badge-done">👣 С посещением</span>) : <span className="muted">—</span>}</td>
                                    <td style={{ maxWidth: 240 }}><div style={{ overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap', fontSize: 12 }} title={comment}>{comment || '—'}</div></td>
                                  </tr>
                                );
                              })}
                            </tbody>
                          </table>
                        </div>
                      )}
                    </div>
                  </>
                )}

                {reportMode === 'no_letters' && (
                  <div className="card">
                    <div className="card-head" style={{ background: 'var(--red-soft)', borderBottom: '1px solid var(--red)' }}>
                      <h3 style={{ margin: 0, color: 'var(--red)' }}>📭 Клиенты без полученных писем</h3>
                      <p className="muted" style={{ fontSize: 11, marginTop: 4 }}>Клиенты, по которым за выбранный период не было получено ни одного письма. Всего: <b style={{ color: 'var(--red)' }}>{clientsWithNoLetters.length}</b></p>
                    </div>
                    {clientsWithNoLetters.length === 0 ? (
                      <div className="empty"><div className="empty-icon">✅</div>Все клиенты получили письма</div>
                    ) : (
                      <div>
                        {clientsWithNoLetters.map(row => {
                          const isExpanded = expandedClientId === row.client.id;
                          return (
                            <div key={row.client.id} style={{ borderBottom: '1px solid var(--border)' }}>
                              <button onClick={() => setExpandedClientId(isExpanded ? null : row.client.id)} style={{ width: '100%', textAlign: 'left', padding: '12px 16px', background: 'none', border: 0, cursor: 'pointer', display: 'flex', alignItems: 'center', gap: 12, color: 'var(--text)' }}>
                                <span style={{ color: 'var(--muted)', transition: 'transform .2s', transform: isExpanded ? 'rotate(90deg)' : 'none' }}>▶</span>
                                <div style={{ flex: 1, minWidth: 0 }}>
                                  <div style={{ fontWeight: 600, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{row.client.companyName}</div>
                                  <div className="muted" style={{ fontSize: 11, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>📍 {row.client.address || '—'}{row.client.postOffice ? ' · 📮 ' + row.client.postOffice : ''}{row.client.holding ? ' · 🏗️ ' + row.client.holding : ''}</div>
                                </div>
                                <div style={{ fontSize: 11, color: 'var(--red)', whiteSpace: 'nowrap' }}>📭 {row.tasks.length} {row.tasks.length === 1 ? 'задача' : row.tasks.length < 5 ? 'задачи' : 'задач'} без писем</div>
                              </button>
                              {isExpanded && (
                                <div style={{ padding: '12px 16px', background: 'var(--panel-2)' }}>
                                  <div className="muted" style={{ fontSize: 11, marginBottom: 8 }}>Задачи этого клиента с 0 полученных писем:</div>
                                  <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
                                    {row.tasks.map(t => {
                                      const courier = couriers.find(c => c.id === t.status);
                                      const typeLabels: Record<TaskType, string> = { post: '📮 Почта', delivery: '🚚 Доставка', pickup: '📤 Отправка', complex: '📦 Сборная', legal_address: '⚖️ Юр. адрес' };
                                      return (
                                        <button key={t.id} onClick={() => { setSelectedDate(t.date); setSelectedTask(t); setCurrentPage('board'); setCourierWeekView(null); }} style={{ textAlign: 'left', padding: 10, borderRadius: 8, background: 'var(--panel)', border: '1px solid var(--border)', cursor: 'pointer', color: 'var(--text)' }}>
                                          <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap', alignItems: 'center' }}>
                                            <span className="badge badge-gray">{typeLabels[t.type]}</span>
                                            <span className="muted" style={{ fontSize: 11 }}>📅 {formatDateShort(t.date)} {t.time}</span>
                                            <span className="muted" style={{ fontSize: 11 }}>👤 {courier?.fullName || courier?.name || '—'}</span>
                                          </div>
                                          <div style={{ fontWeight: 600, marginTop: 4, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{t.title}</div>
                                          {t.type === 'post' && <div style={{ fontSize: 11, color: 'var(--purple)', marginTop: 2, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>📮 {t.postIndex}, {t.postAddress}</div>}
                                          {t.type === 'complex' && t.officeCompany && <div style={{ fontSize: 11, color: 'var(--green)', marginTop: 2, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>🏢 {t.officeCompany}</div>}
                                        </button>
                                      );
                                    })}
                                  </div>
                                </div>
                              )}
                            </div>
                          );
                        })}
                      </div>
                    )}
                  </div>
                )}
              </>
            )}

            {adminTab === 'staff' && (
              <div className="panel">
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 16, flexWrap: 'wrap', gap: 12 }}>
                  <h2 className="panel-title">🔐 Сотрудники и доступ</h2>
                  {canAction('manageStaff') && <button onClick={openStaffCreate} className="btn btn-primary">+ Добавить сотрудника</button>}
                </div>
                {!currentUser && <div className="notice blue">💡 Сейчас включён режим владельца (вход не выполнен) — доступны все разделы.</div>}
                {staff.length === 0 ? (
                  <div className="empty"><div className="empty-icon">🔐</div>Сотрудники не добавлены</div>
                ) : (
                  <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
                    {staff.map(s => (
                      <div key={s.id} style={{ padding: 14, borderRadius: 10, background: 'var(--panel-2)', border: '1px solid var(--border)', display: 'flex', alignItems: 'flex-start', gap: 12, flexWrap: 'wrap' }}>
                        <div style={{ flex: 1, minWidth: 240 }}>
                          <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap', alignItems: 'center' }}>
                            <span style={{ fontWeight: 600 }}>{s.name}</span>
                            <span className="badge badge-post">{ROLE_PRESETS[s.role]?.label || s.role}</span>
                            <span className={`badge ${s.active ? 'badge-done' : 'badge-red'}`}>{s.active ? 'Активен' : 'Отключён'}</span>
                            {s.id === currentStaffId && <span className="badge badge-new">Это вы</span>}
                          </div>
                          <div className="muted" style={{ fontSize: 12, marginTop: 4 }}>Логин: <b style={{ color: 'var(--text)', fontFamily: 'monospace' }}>{s.login}</b> · Пароль: <b style={{ color: 'var(--text)', fontFamily: 'monospace' }}>••••••••</b></div>
                          <div style={{ display: 'flex', flexWrap: 'wrap', gap: 4, marginTop: 8 }}>
                            {PAGE_LABELS.filter(p => s.permissions.pages[p.key]).map(p => <span key={p.key} style={{ fontSize: 10, background: 'var(--panel-3)', color: 'var(--text)', padding: '2px 7px', borderRadius: 4 }}>{p.label}</span>)}
                            {s.permissions.pages.admin && ADMIN_TAB_LABELS.filter(t => s.permissions.adminTabs[t.key]).map(t => <span key={t.key} style={{ fontSize: 10, background: 'var(--panel-3)', color: 'var(--muted)', padding: '2px 7px', borderRadius: 4 }}>Админ: {t.label}</span>)}
                          </div>
                        </div>
                        {canAction('manageStaff') && (
                          <div style={{ display: 'flex', gap: 6 }}>
                            <button onClick={() => toggleStaffActive(s)} className="btn btn-sm">{s.active ? '🔒' : '🔓'}</button>
                            <button onClick={() => openStaffEdit(s)} className="btn btn-sm btn-primary">✏️</button>
                            <button onClick={() => handleDeleteStaff(s.id)} className="btn btn-sm btn-red">🗑️</button>
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                )}
              </div>
            )}

            {/* 🆕 ИСПРАВЛЕННАЯ КАССА — журнал операций, не дубликат отделений */}
            {adminTab === 'cash' && (
              <>
                <div className="panel">
                  <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 16, flexWrap: 'wrap', gap: 12 }}>
                    <h2 className="panel-title">💰 Касса</h2>
                    <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap' }}>
                      <button onClick={handleExportCash} className="btn btn-green">📥 Экспорт в Excel</button>
                      <button onClick={handleOpenCashModal} className="btn btn-primary">+ Новая операция</button>
                    </div>
                  </div>
                  <div className="grid-4">
                    <div className="field">
                      <label className="label">📅 Период с:</label>
                      <input type="date" value={cashDateFrom} onChange={(e) => setCashDateFrom(e.target.value)} className="input" />
                    </div>
                    <div className="field">
                      <label className="label">📅 Период по:</label>
                      <input type="date" value={cashDateTo} onChange={(e) => setCashDateTo(e.target.value)} className="input" />
                    </div>
                    <div className="field">
                      <label className="label">🏷️ Тип операции:</label>
                      <select value={cashTypeFilter} onChange={(e) => setCashTypeFilter(e.target.value)} className="select">
                        <option value="">Все типы</option>
                        {(Object.keys(CASH_OPERATION_META) as CashOperationType[]).map(t => <option key={t} value={t}>{CASH_OPERATION_META[t].icon} {CASH_OPERATION_META[t].label}</option>)}
                      </select>
                    </div>
                    <div className="field">
                      <label className="label">💳 Способ оплаты:</label>
                      <select value={cashPaymentFilter} onChange={(e) => setCashPaymentFilter(e.target.value)} className="select">
                        <option value="">Все способы</option>
                        {(Object.keys(PAYMENT_METHOD_META) as PaymentMethod[]).map(t => <option key={t} value={t}>{PAYMENT_METHOD_META[t].icon} {PAYMENT_METHOD_META[t].label}</option>)}
                      </select>
                    </div>
                    <div className="field" style={{ gridColumn: 'span 2' }}>
                      <label className="label">🏢 Клиент:</label>
                      <SearchableSelect value={cashClientFilter} onChange={setCashClientFilter} options={cashClientFilterOptions} placeholder="Все клиенты" searchPlaceholder="🔍 Поиск клиента..." />
                    </div>
                  </div>
                  <div className="muted" style={{ fontSize: 12, marginTop: 8 }}>Найдено операций: <b style={{ color: 'var(--text)' }}>{cashSummary.totalOperations}</b></div>
                </div>
                <div className="stats">
                  <div className="stat"><div className="stat-label">📥 Приход</div><div className="stat-value green">{formatMoney(cashSummary.income)}</div></div>
                  <div className="stat"><div className="stat-label">💵 Расход (наличные)</div><div className="stat-value" style={{ color: 'var(--yellow)' }}>{formatMoney(cashSummary.cashExpense)}</div></div>
                  <div className="stat"><div className="stat-label">📄 Расход (по счетам)</div><div className="stat-value blue">{formatMoney(cashSummary.invoiceExpense)}</div></div>
                  <div className="stat" style={{ background: cashSummary.balance >= 0 ? 'var(--green-soft)' : 'var(--red-soft)', borderColor: cashSummary.balance >= 0 ? 'var(--green)' : 'var(--red)' }}><div className="stat-label" style={{ color: cashSummary.balance >= 0 ? 'var(--green)' : 'var(--red)' }}>💼 Баланс (наличные)</div><div className="stat-value" style={{ color: cashSummary.balance >= 0 ? 'var(--green)' : 'var(--red)' }}>{formatMoney(cashSummary.balance)}</div></div>
                  <div className="stat"><div className="stat-label">💳 Корпоративная карта</div><div className="stat-value" style={{ color: 'var(--purple)' }}>{formatMoney(cashSummary.byPaymentMethod.corporate_card.total)}</div><div className="muted" style={{ fontSize: 11 }}>{cashSummary.byPaymentMethod.corporate_card.count} опер.</div></div>
                </div>
                <div className="card">
                  <div className="card-head" style={{ background: 'var(--green-soft)', borderBottom: '1px solid var(--green)' }}>
                    <h3 style={{ margin: 0, color: 'var(--green)' }}>📋 Журнал операций</h3>
                  </div>
                  {filteredCashOperations.length === 0 ? (
                    <div className="empty"><div className="empty-icon">💰</div>Нет операций за выбранный период<button onClick={handleOpenCashModal} className="btn btn-green" style={{ marginTop: 12 }}>+ Добавить первую операцию</button></div>
                  ) : (
                    <div className="table-wrap" style={{ border: 0, borderRadius: 0 }}>
                      <table>
                        <thead>
                          <tr>
                            <th>Дата</th>
                            <th>Тип</th>
                            <th style={{ textAlign: 'right' }}>Сумма</th>
                            <th>Способ</th>
                            <th>Клиент / Сотрудник</th>
                            <th>Описание</th>
                            <th style={{ textAlign: 'center' }}>Действия</th>
                          </tr>
                        </thead>
                        <tbody>
                          {filteredCashOperations.map(op => {
                            const meta = CASH_OPERATION_META[op.type];
                            const payMeta = op.paymentMethod ? PAYMENT_METHOD_META[op.paymentMethod] : null;
                            const isIn = meta.flow === 'in';
                            return (
                              <tr key={op.id}>
                                <td className="nowrap">{formatDateShort(op.date)}</td>
                                <td className="nowrap"><span className={`badge ${meta.bgColor} ${meta.color}`}>{meta.icon} {meta.label}</span></td>
                                <td style={{ textAlign: 'right', fontFamily: 'monospace', fontWeight: 700, color: isIn ? 'var(--green)' : 'var(--red)' }}>{isIn ? '+' : '−'}{formatMoney(op.amount)}</td>
                                <td className="nowrap">{payMeta ? <span style={{ fontSize: 12 }}>{payMeta.icon} {payMeta.label}</span> : <span className="muted">—</span>}</td>
                                <td style={{ maxWidth: 220 }}><div style={{ overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }} title={op.clientName || op.employeeName || ''}>{op.clientName || op.employeeName || '—'}</div></td>
                                <td style={{ maxWidth: 260 }}><div style={{ overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap', fontSize: 12 }} title={op.description}>{op.description || '—'}</div></td>
                                <td style={{ textAlign: 'center' }}><button onClick={() => handleDeleteCashOperation(op.id)} className="btn btn-red btn-sm">🗑️</button></td>
                              </tr>
                            );
                          })}
                        </tbody>
                        <tfoot>
                          <tr>
                            <td colSpan={2} style={{ textAlign: 'right' }}>ИТОГО ({filteredCashOperations.length} опер.):</td>
                            <td style={{ textAlign: 'right', fontFamily: 'monospace', fontWeight: 700, color: 'var(--green)' }}>{formatMoney(cashSummary.income)}</td>
                            <td colSpan={2} style={{ textAlign: 'right', fontFamily: 'monospace', fontWeight: 700, color: 'var(--red)' }}>−{formatMoney(cashSummary.cashExpense + cashSummary.invoiceExpense)}</td>
                            <td colSpan={2} style={{ textAlign: 'right', fontFamily: 'monospace', fontWeight: 700, color: 'var(--yellow)' }}>Баланс: {formatMoney(cashSummary.balance)}</td>
                          </tr>
                        </tfoot>
                      </table>
                    </div>
                  )}
                </div>
              </>
            )}
          </div>
        </div>
      )}

      {/* ================= МОДАЛКА: ОТДЕЛЕНИЕ (с днями посещения) ================= */}
      {isOfficeModalOpen && editingOffice && (
        <div className="modal-backdrop">
          <div className="modal" style={{ maxHeight: '90vh' }}>
            <div className="modal-head">
              <div>
                <h2 className="modal-title">📮 {editingOffice.index}, {editingOffice.address}</h2>
                <p className="muted" style={{ fontSize: 11, marginTop: 2 }}>Папка доверенностей: {editingOffice.folderName}</p>
              </div>
              <button onClick={() => setIsOfficeModalOpen(false)} style={{ border: 0, background: 'none', fontSize: 24, color: 'var(--muted)', cursor: 'pointer' }}>&times;</button>
            </div>
            <div className="modal-body">
              <div className="field">
                <label className="label">💬 Комментарий к отделению:</label>
                <textarea value={officeForm.comment} onChange={(e) => setOfficeForm({ ...officeForm, comment: e.target.value })} rows={3} placeholder="Особенности, режим работы..." className="textarea" />
              </div>
              <div className="field">
                <label className="label">📅 Дни посещения отделения:</label>
                <div style={{ display: 'grid', gridTemplateColumns: 'repeat(7, 1fr)', gap: 4 }}>
                  {DAY_LABELS_SHORT.map((label, idx) => (
                    <button
                      key={idx}
                      type="button"
                      onClick={() => {
                        const cur: number[] = officeForm.visitDays || [];
                        setOfficeForm({ ...officeForm, visitDays: cur.includes(idx) ? cur.filter((d: number) => d !== idx) : [...cur, idx].sort((a: number, b: number) => a - b) });
                      }}
                      className={`btn btn-sm ${(officeForm.visitDays || []).includes(idx) ? 'btn-primary' : ''}`}
                      style={{ padding: '8px 4px' }}
                    >
                      {label}
                    </button>
                  ))}
                </div>
                <p className="muted" style={{ fontSize: 11, marginTop: 4 }}>Отметьте дни недели, когда курьер посещает это отделение</p>
              </div>
              <div className="field">
                <label className="label">👤 Почтальон (ФИО):</label>
                <input type="text" value={officeForm.postmanName} onChange={(e) => setOfficeForm({ ...officeForm, postmanName: e.target.value })} placeholder="Иванова Мария Петровна" className="input" />
              </div>
              <div className="field">
                <label className="label">📞 Контакт почтальона:</label>
                <input type="tel" value={officeForm.postmanPhone} onChange={(e) => setOfficeForm({ ...officeForm, postmanPhone: e.target.value })} placeholder="+7 (___) ___-__-__" className="input" />
              </div>
              <div className="field">
                <label className="label">💰 Премия почтальона (₽):</label>
                <input type="number" min="0" step="0.01" value={officeForm.bonus} onChange={(e) => setOfficeForm({ ...officeForm, bonus: e.target.value })} placeholder="0" className="input" />
              </div>
              <div className="field">
                <label className="label">🚚 Закреплённый курьер:</label>
                <select value={officeForm.courierId || ''} onChange={(e) => setOfficeForm({ ...officeForm, courierId: e.target.value })} className="select">
                  <option value="">— не назначен —</option>
                  {couriers.filter(c => c.id !== 'unassigned').map(c => (
                    <option key={c.id} value={c.id}>{c.fullName || c.name}</option>
                  ))}
                </select>
                <p className="muted" style={{ fontSize: 11, marginTop: 4 }}>Почтальон этого отделения будет виден выбранному курьеру в разделе «Почтальоны»</p>
              </div>
              <div className="notice">
                👥 Клиентов: <b style={{ color: 'var(--green)' }}>{getClientsByPostOffice(editingOffice.folderName).length}</b><br />
                📄 Доверенностей: <b style={{ color: 'var(--accent)' }}>{editingOffice.companies.length}</b>
              </div>
            </div>
            <div className="modal-foot">
              <button onClick={() => setIsOfficeModalOpen(false)} className="btn">Отмена</button>
              <button onClick={handleSaveOfficeMeta} className="btn btn-primary">💾 Сохранить</button>
            </div>
          </div>
        </div>
      )}

      {/* ================= МОДАЛКА: ВХОД ================= */}
      {isLoginModalOpen && (
        <div className="modal-backdrop">
          <div className="modal">
            <div className="modal-head">
              <h2 className="modal-title">🔐 Вход в систему</h2>
              <button onClick={() => setIsLoginModalOpen(false)} style={{ border: 0, background: 'none', fontSize: 24, color: 'var(--muted)', cursor: 'pointer' }}>&times;</button>
            </div>
            <div className="modal-body">
              <div className="field">
                <label className="label">Логин:</label>
                <input type="text" value={loginForm.login} onChange={(e) => setLoginForm({ ...loginForm, login: e.target.value })} placeholder="Введите логин" className="input" onKeyDown={(e) => e.key === 'Enter' && handleLogin()} />
              </div>
              <div className="field">
                <label className="label">Пароль:</label>
                <input type="password" value={loginForm.password} onChange={(e) => setLoginForm({ ...loginForm, password: e.target.value })} placeholder="Введите пароль" className="input" onKeyDown={(e) => e.key === 'Enter' && handleLogin()} />
              </div>
            </div>
            <div className="modal-foot">
              <button onClick={() => setIsLoginModalOpen(false)} className="btn">Отмена</button>
              <button onClick={handleLogin} className="btn btn-primary">Войти</button>
            </div>
          </div>
        </div>
      )}

      {/* ================= МОДАЛКА: СОТРУДНИК ================= */}
      {isStaffModalOpen && (
        <div className="modal-backdrop">
          <div className="modal wide" style={{ maxHeight: '90vh' }}>
            <div className="modal-head">
              <h2 className="modal-title">{editingStaff ? '✏️ Редактировать сотрудника' : '➕ Новый сотрудник'}</h2>
              <button onClick={() => setIsStaffModalOpen(false)} style={{ border: 0, background: 'none', fontSize: 24, color: 'var(--muted)', cursor: 'pointer' }}>&times;</button>
            </div>
            <div className="modal-body" style={{ overflowY: 'auto' }}>
              <div className="grid-2">
                <div className="field">
                  <label className="label">Имя / ФИО <span style={{ color: 'var(--red)' }}>*</span></label>
                  <input type="text" value={staffForm.name} onChange={(e) => setStaffForm({ ...staffForm, name: e.target.value })} placeholder="Иванов Иван" className="input" />
                </div>
                <div className="field">
                  <label className="label">Логин <span style={{ color: 'var(--red)' }}>*</span></label>
                  <input type="text" value={staffForm.login} onChange={(e) => setStaffForm({ ...staffForm, login: e.target.value })} placeholder="ivanov" className="input" />
                </div>
                <div className="field" style={{ gridColumn: 'span 2' }}>
                  <label className="label">Пароль {editingStaff ? <span className="muted" style={{ fontWeight: 400 }}>(пусто = не менять)</span> : <span style={{ color: 'var(--red)' }}>*</span>}</label>
                  <div style={{ display: 'flex', gap: 6 }}>
                    <input type={staffForm.showPassword ? 'text' : 'password'} value={staffForm.password} onChange={(e) => setStaffForm({ ...staffForm, password: e.target.value })} placeholder="Минимум 4 символа" className="input" style={{ flex: 1 }} />
                    <button type="button" onClick={() => setStaffForm({ ...staffForm, showPassword: !staffForm.showPassword })} className="btn">👁️</button>
                    <button type="button" onClick={() => setStaffForm({ ...staffForm, password: generatePassword(), showPassword: true })} className="btn">🎲</button>
                  </div>
                </div>
                <div className="field" style={{ gridColumn: 'span 2' }}>
                  <label className="label">Роль (шаблон прав):</label>
                  <select value={staffForm.role} onChange={(e) => { const v = e.target.value; if (v === 'custom') setStaffForm({ ...staffForm, role: v }); else setStaffForm({ ...staffForm, role: v, permissions: ROLE_PRESETS[v].make() }); }} className="select">
                    {Object.keys(ROLE_PRESETS).map(k => <option key={k} value={k}>{ROLE_PRESETS[k].label}</option>)}
                  </select>
                </div>
              </div>
              <div style={{ display: 'flex', alignItems: 'center', gap: 10, padding: 12, borderRadius: 10, background: 'var(--panel-2)', border: '1px solid var(--border)', marginBottom: 14 }}>
                <input type="checkbox" id="staffActive" checked={staffForm.active} onChange={(e) => setStaffForm({ ...staffForm, active: e.target.checked })} style={{ width: 16, height: 16, accentColor: 'var(--green)' }} disabled={editingStaff?.id === currentStaffId} />
                <label htmlFor="staffActive" style={{ fontSize: 13, cursor: 'pointer' }}>Учётная запись активна{editingStaff?.id === currentStaffId && <span className="muted" style={{ fontSize: 11, marginLeft: 6 }}>(свою учётку отключить нельзя)</span>}</label>
              </div>
              <div style={{ marginBottom: 14 }}>
                <div style={{ fontSize: 13, fontWeight: 700, marginBottom: 8 }}>🖥️ Доступные интерфейсы:</div>
                <div className="grid-2">
                  {PAGE_LABELS.map(p => (
                    <label key={p.key} style={{ display: 'flex', alignItems: 'center', gap: 8, padding: 10, borderRadius: 8, border: '1px solid var(--border)', cursor: 'pointer', background: staffForm.permissions.pages[p.key] ? 'var(--green-soft)' : 'var(--panel-2)' }}>
                      <input type="checkbox" checked={staffForm.permissions.pages[p.key]} onChange={() => toggleStaffPage(p.key)} style={{ width: 16, height: 16, accentColor: 'var(--green)' }} />
                      <span style={{ fontSize: 13 }}>{p.label}</span>
                    </label>
                  ))}
                </div>
              </div>
              <div style={{ marginBottom: 14, opacity: staffForm.permissions.pages.admin ? 1 : 0.5, pointerEvents: staffForm.permissions.pages.admin ? 'auto' : 'none' }}>
                <div style={{ fontSize: 13, fontWeight: 700, marginBottom: 8 }}>⚙️ Разделы админ-панели:</div>
                <div className="grid-3">
                  {ADMIN_TAB_LABELS.map(t => (
                    <label key={t.key} style={{ display: 'flex', alignItems: 'center', gap: 8, padding: 10, borderRadius: 8, border: '1px solid var(--border)', cursor: 'pointer', background: staffForm.permissions.adminTabs[t.key] ? 'var(--green-soft)' : 'var(--panel-2)' }}>
                      <input type="checkbox" checked={staffForm.permissions.adminTabs[t.key]} onChange={() => toggleStaffAdminTab(t.key)} style={{ width: 16, height: 16, accentColor: 'var(--green)' }} />
                      <span style={{ fontSize: 13 }}>{t.label}</span>
                    </label>
                  ))}
                </div>
              </div>
              <div>
                <div style={{ fontSize: 13, fontWeight: 700, marginBottom: 8 }}>🛠️ Права на действия:</div>
                <div className="grid-2">
                  {ACTION_LABELS.map(a => (
                    <label key={a.key} style={{ display: 'flex', alignItems: 'center', gap: 8, padding: 10, borderRadius: 8, border: '1px solid var(--border)', cursor: 'pointer', background: staffForm.permissions.actions[a.key] ? 'var(--green-soft)' : 'var(--panel-2)' }}>
                      <input type="checkbox" checked={staffForm.permissions.actions[a.key]} onChange={() => toggleStaffAction(a.key)} style={{ width: 16, height: 16, accentColor: 'var(--green)' }} />
                      <span style={{ fontSize: 13 }}>{a.label}</span>
                    </label>
                  ))}
                </div>
              </div>
            </div>
            <div className="modal-foot">
              <button onClick={() => setIsStaffModalOpen(false)} className="btn">Отмена</button>
              <button onClick={handleSaveStaff} className="btn btn-primary">💾 Сохранить</button>
            </div>
          </div>
        </div>
      )}

      {/* ================= МОДАЛКА: КАССА ================= */}
      {isCashModalOpen && (
        <div className="modal-backdrop">
          <div className="modal" style={{ maxHeight: '90vh' }}>
            <div className="modal-head">
              <h2 className="modal-title">💰 Новая операция</h2>
              <button onClick={() => setIsCashModalOpen(false)} style={{ border: 0, background: 'none', fontSize: 28, color: 'var(--muted)', cursor: 'pointer', lineHeight: 1 }}>&times;</button>
            </div>
            <div className="modal-body" style={{ overflowY: 'auto' }}>
              <div className="field">
                <label className="label">Тип операции:</label>
                <div className="grid-2">
                  {(Object.keys(CASH_OPERATION_META) as CashOperationType[]).map(t => {
                    const meta = CASH_OPERATION_META[t];
                    const isActive = cashForm.type === t;
                    return (
                      <button key={t} type="button" onClick={() => setCashForm({ ...cashForm, type: t, clientId: '', employeeName: '', expenseArticle: '', letterCount: '', paymentMethod: t === 'other' ? 'cash' : cashForm.paymentMethod })} style={{ padding: '12px 10px', borderRadius: 10, border: `2px solid ${isActive ? 'var(--accent)' : 'var(--border)'}`, background: isActive ? 'var(--accent-soft)' : 'var(--panel-2)', color: isActive ? 'var(--accent)' : 'var(--text)', cursor: 'pointer', fontSize: 13, fontWeight: 600, textAlign: 'center' }}>
                        <div style={{ fontSize: 22, marginBottom: 4 }}>{meta.icon}</div>
                        <div>{meta.label}</div>
                        <div style={{ fontSize: 11, opacity: .7, marginTop: 2 }}>{meta.flow === 'in' ? '📥 Приход' : '📤 Расход'}</div>
                      </button>
                    );
                  })}
                </div>
              </div>
              <div className="grid-2">
                <div className="field">
                  <label className="label">📅 Дата:</label>
                  <input type="date" value={cashForm.date} onChange={(e) => setCashForm({ ...cashForm, date: e.target.value })} className="input" />
                </div>
                <div className="field">
                  <label className="label">💵 Сумма (₽):</label>
                  <input type="number" min="0" step="0.01" value={cashForm.amount} onChange={(e) => setCashForm({ ...cashForm, amount: e.target.value })} placeholder="0.00" className="input" />
                </div>
              </div>
              {cashForm.type !== 'other' && (
                <div className="field">
                  <label className="label">💳 Способ оплаты:</label>
                  <div className="grid-3">
                    {(Object.keys(PAYMENT_METHOD_META) as PaymentMethod[]).map(t => {
                      const meta = PAYMENT_METHOD_META[t];
                      const isActive = cashForm.paymentMethod === t;
                      return (
                        <button key={t} type="button" onClick={() => setCashForm({ ...cashForm, paymentMethod: t })} style={{ padding: '10px 8px', borderRadius: 8, border: `2px solid ${isActive ? 'var(--accent)' : 'var(--border)'}`, background: isActive ? 'var(--accent-soft)' : 'var(--panel-2)', color: isActive ? 'var(--accent)' : 'var(--text)', cursor: 'pointer', fontSize: 12, fontWeight: 600, textAlign: 'center' }}>
                          <div style={{ fontSize: 18, marginBottom: 2 }}>{meta.icon}</div>
                          <div>{meta.label}</div>
                        </button>
                      );
                    })}
                  </div>
                </div>
              )}
              {(cashForm.type === 'income' || cashForm.type === 'return') && (
                <div className="field">
                  <label className="label">🏢 Клиент <span style={{ color: 'var(--red)' }}>*</span></label>
                  <SearchableSelect value={cashForm.clientId} onChange={(v) => setCashForm({ ...cashForm, clientId: v })} options={clientOptions} placeholder="-- Выберите клиента --" searchPlaceholder="Поиск..." />
                </div>
              )}
              {cashForm.type === 'return' && (
                <div className="field">
                  <label className="label">📄 Количество писем (шт.):</label>
                  <input type="number" min="0" value={cashForm.letterCount} onChange={(e) => setCashForm({ ...cashForm, letterCount: e.target.value })} placeholder="0" className="input" />
                </div>
              )}
              {(cashForm.type === 'travel' || cashForm.type === 'power_of_attorney') && (
                <div className="field">
                  <label className="label">👤 ФИО сотрудника <span style={{ color: 'var(--red)' }}>*</span></label>
                  <input type="text" value={cashForm.employeeName} onChange={(e) => setCashForm({ ...cashForm, employeeName: e.target.value })} placeholder="Иванов Иван Иванович" className="input" />
                </div>
              )}
              {cashForm.type === 'other' && (
                <div className="field">
                  <label className="label">📝 Статья расходов <span style={{ color: 'var(--red)' }}>*</span></label>
                  <input type="text" value={cashForm.expenseArticle} onChange={(e) => setCashForm({ ...cashForm, expenseArticle: e.target.value })} placeholder="Канцелярия, ГСМ, связь..." className="input" />
                </div>
              )}
              <div className="field">
                <label className="label">💬 Описание / комментарий:</label>
                <textarea value={cashForm.description} onChange={(e) => setCashForm({ ...cashForm, description: e.target.value })} placeholder="Дополнительная информация..." rows={3} className="textarea" />
              </div>
            </div>
            <div className="modal-foot">
              <button onClick={() => setIsCashModalOpen(false)} className="btn">Отмена</button>
              <button onClick={handleSaveCashOperation} className="btn btn-green">💾 Сохранить операцию</button>
            </div>
          </div>
        </div>
      )}

      {/* ================= МОДАЛКА: ПОДТВЕРЖДЕНИЕ ПИСЕМ (ЛОГИСТ) ================= */}
      {isConfirmModalOpen && pendingTaskForConfirm && (
        <div className="modal-backdrop">
          <div className="modal wide" style={{ maxHeight: '90vh' }}>
            <div className="modal-head">
              <div>
                <h2 className="modal-title">📬 Подтверждение получения писем</h2>
                <p className="muted" style={{ fontSize: 12, marginTop: 2 }}>Задача: <b>{pendingTaskForConfirm.title}</b></p>
              </div>
              <button onClick={handleCancelConfirm} style={{ border: 0, background: 'none', fontSize: 24, color: 'var(--muted)', cursor: 'pointer' }}>&times;</button>
            </div>
            <div className="modal-body" style={{ overflowY: 'auto' }}>
              {pendingTaskForConfirm.type === 'post' && (
                <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
                  <div style={{ padding: 12, borderRadius: 10, background: 'var(--purple-soft)', border: '1px solid var(--purple)' }}>
                    <div style={{ fontSize: 13, color: 'var(--purple)', fontWeight: 600 }}>📮 {pendingTaskForConfirm.postIndex}, {pendingTaskForConfirm.postAddress}</div>
                  </div>
                  {normalizeCompanies(pendingTaskForConfirm.companies).map((comp, idx) => {
                    const key = 'post-' + idx;
                    return (
                      <div key={key} style={{ padding: 12, borderRadius: 10, background: 'var(--panel-2)', border: '1px solid var(--border)', display: 'flex', alignItems: 'center', gap: 10 }}>
                        <div style={{ flex: 1 }}><div style={{ fontWeight: 600 }}>{comp.name}</div></div>
                        <div style={{ display: 'flex', alignItems: 'center', gap: 6 }}>
                          <label className="muted" style={{ fontSize: 11 }}>Получено:</label>
                          <input type="number" min="0" value={confirmReceivedCounts[key] ?? 0} onChange={(e) => setConfirmReceivedCounts(prev => ({ ...prev, [key]: Math.max(0, Number(e.target.value) || 0) }))} className="input" style={{ width: 70, textAlign: 'center' }} />
                          <span className="muted" style={{ fontSize: 11 }}>шт.</span>
                        </div>
                      </div>
                    );
                  })}
                </div>
              )}
              {pendingTaskForConfirm.type === 'complex' && pendingTaskForConfirm.postPoints && (
                <div style={{ display: 'flex', flexDirection: 'column', gap: 14 }}>
                  {pendingTaskForConfirm.postPoints.map((point, pIdx) => (
                    <div key={point.id} style={{ padding: 12, borderRadius: 10, background: 'var(--purple-soft)', border: '1px solid var(--purple)' }}>
                      <div style={{ fontSize: 13, color: 'var(--purple)', fontWeight: 700, marginBottom: 10 }}>📮 #{pIdx + 1}: {point.postIndex}, {point.postAddress}</div>
                      <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
                        {normalizeCompanies(point.companies).map((comp, cIdx) => {
                          const key = `point-${pIdx}-comp-${cIdx}`;
                          return (
                            <div key={key} style={{ padding: 10, borderRadius: 8, background: 'var(--panel-2)', border: '1px solid var(--border)', display: 'flex', alignItems: 'center', gap: 10 }}>
                              <div style={{ flex: 1 }}><div style={{ fontWeight: 600 }}>{comp.name}</div></div>
                              <div style={{ display: 'flex', alignItems: 'center', gap: 6 }}>
                                <label className="muted" style={{ fontSize: 11 }}>Получено:</label>
                                <input type="number" min="0" value={confirmReceivedCounts[key] ?? 0} onChange={(e) => setConfirmReceivedCounts(prev => ({ ...prev, [key]: Math.max(0, Number(e.target.value) || 0) }))} className="input" style={{ width: 70, textAlign: 'center' }} />
                                <span className="muted" style={{ fontSize: 11 }}>шт.</span>
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>
            <div className="modal-foot">
              <button onClick={handleCancelConfirm} className="btn">← Отмена</button>
              <button onClick={handleConfirmReceived} className="btn btn-green">✓ Подтвердить и завершить</button>
            </div>
          </div>
        </div>
      )}

      {/* ================= МОДАЛКА: КУРЬЕР ================= */}
      {isCourierModalOpen && (
        <div className="modal-backdrop">
          <div className="modal">
            <div className="modal-head">
              <h2 className="modal-title">Карточка курьера</h2>
              <button onClick={() => setIsCourierModalOpen(false)} style={{ border: 0, background: 'none', fontSize: 24, color: 'var(--muted)', cursor: 'pointer' }}>&times;</button>
            </div>
            <div className="modal-body">
              <div className="field">
                <input type="text" value={courierForm.name} onChange={(e) => setCourierForm({ ...courierForm, name: e.target.value })} placeholder="Короткое имя *" className="input" />
              </div>
              <div className="field">
                <input type="text" value={courierForm.fullName} onChange={(e) => setCourierForm({ ...courierForm, fullName: e.target.value })} placeholder="ФИО полностью" className="input" />
              </div>
              <div className="field">
                <input type="tel" value={courierForm.phone} onChange={(e) => setCourierForm({ ...courierForm, phone: e.target.value })} placeholder="Телефон" className="input" />
              </div>
              <div className="field">
                <textarea value={courierForm.passport} onChange={(e) => setCourierForm({ ...courierForm, passport: e.target.value })} placeholder="Паспортные данные" rows={3} className="textarea" />
              </div>
              <div className="field">
                <textarea value={courierForm.comments} onChange={(e) => setCourierForm({ ...courierForm, comments: e.target.value })} placeholder="Комментарии" rows={3} className="textarea" />
              </div>
            </div>
            <div className="modal-foot">
              <button onClick={() => setIsCourierModalOpen(false)} className="btn">Отмена</button>
              <button onClick={handleSaveCourier} className="btn btn-primary">💾 Сохранить</button>
            </div>
          </div>
        </div>
      )}

      {/* ================= МОДАЛКА: КЛИЕНТ (с ячейкой и активностью) ================= */}
      {isClientModalOpen && (
        <div className="modal-backdrop">
          <div className="modal" style={{ maxHeight: '90vh' }}>
            <div className="modal-head">
              <h2 className="modal-title">{editingClient ? '✏️ Редактировать' : '➕ Новый клиент'}</h2>
              <button onClick={() => setIsClientModalOpen(false)} style={{ border: 0, background: 'none', fontSize: 24, color: 'var(--muted)', cursor: 'pointer' }}>&times;</button>
            </div>
            <div className="modal-body" style={{ overflowY: 'auto' }}>
              <div className="field">
                <input type="text" value={clientForm.companyName} onChange={(e) => setClientForm({ ...clientForm, companyName: e.target.value })} placeholder="Наименование организации *" className="input" />
              </div>
              <div className="field">
                <input type="text" value={clientForm.address} onChange={(e) => setClientForm({ ...clientForm, address: e.target.value })} placeholder="Юридический адрес" className="input" />
              </div>
              <div className="grid-2">
                <div className="field">
                  <input type="text" value={clientForm.postOffice || ''} onChange={(e) => setClientForm({ ...clientForm, postOffice: e.target.value })} placeholder="Почтовое отделение" className="input" />
                </div>
                <div className="field">
                  <input type="text" value={clientForm.holding || ''} onChange={(e) => setClientForm({ ...clientForm, holding: e.target.value })} placeholder="Холдинг" className="input" />
                </div>
              </div>
              <div className="field">
                <textarea value={clientForm.note} onChange={(e) => setClientForm({ ...clientForm, note: e.target.value })} placeholder="Комментарий" rows={3} className="textarea" />
              </div>
              <div className="grid-2">
                <div className="field">
                  <label className="label">📄 Договор до:</label>
                  <input type="date" value={clientForm.contractEndDate || ''} onChange={(e) => setClientForm({ ...clientForm, contractEndDate: e.target.value })} className="input" />
                </div>
                <div className="field">
                  <label className="label">📜 Доверенность до:</label>
                  <input type="date" value={clientForm.powerOfAttorneyEndDate || ''} onChange={(e) => setClientForm({ ...clientForm, powerOfAttorneyEndDate: e.target.value })} className="input" />
                </div>
              </div>
              <div className="field">
                <label className="label">💰 Тариф на задачу Доставка / Отправка (₽):</label>
                <input type="text" value={clientForm.deliveryPickupRate || ''} onChange={(e) => setClientForm({ ...clientForm, deliveryPickupRate: e.target.value })} placeholder="Например: 150" className="input" />
              </div>
              <div className="field">
                <label className="label">🗄️ Ячейка (отображается в архиве):</label>
                <input type="text" value={clientForm.cell || ''} onChange={(e) => setClientForm({ ...clientForm, cell: e.target.value })} placeholder="Например: A-15" className="input" />
              </div>
              <div style={{ display: 'flex', alignItems: 'center', gap: 10, padding: 12, borderRadius: 10, background: 'var(--panel-2)', border: '1px solid var(--border)', marginBottom: 14 }}>
                <input type="checkbox" id="clientActive" checked={clientForm.active !== false} onChange={(e) => setClientForm({ ...clientForm, active: e.target.checked })} style={{ width: 16, height: 16, accentColor: 'var(--green)' }} />
                <label htmlFor="clientActive" style={{ fontSize: 13, cursor: 'pointer' }}>Клиент активен</label>
              </div>
              <div className="grid-2">
                <div className="field">
                  <input type="text" value={clientForm.contactPerson} onChange={(e) => setClientForm({ ...clientForm, contactPerson: e.target.value })} placeholder="Контактное лицо" className="input" />
                </div>
                <div className="field">
                  <input type="tel" value={clientForm.phone} onChange={(e) => setClientForm({ ...clientForm, phone: e.target.value })} placeholder="Телефон" className="input" />
                </div>
              </div>
            </div>
            <div className="modal-foot">
              <button onClick={() => setIsClientModalOpen(false)} className="btn">Отмена</button>
              <button onClick={handleSaveClient} className="btn btn-primary">{editingClient ? 'Сохранить' : 'Добавить'}</button>
            </div>
          </div>
        </div>
      )}

      {/* ================= МОДАЛКА: ПРОСМОТР ЗАДАЧИ (с тарифом и временем завершения) ================= */}
      {selectedTask && (
        <div className="modal-backdrop" onClick={() => setSelectedTask(null)}>
          <div className="modal wide" style={{ maxHeight: '90vh' }} onClick={(e) => e.stopPropagation()}>
            <div className="modal-head">
              <input type="text" value={selectedTask.title} onChange={(e) => handleUpdateTask(selectedTask.id, { title: e.target.value })} className="input" style={{ fontWeight: 700, fontSize: 16 }} />
              <button onClick={() => setSelectedTask(null)} style={{ border: 0, background: 'none', fontSize: 28, color: 'var(--muted)', cursor: 'pointer', lineHeight: 1 }}>&times;</button>
            </div>
            <div className="modal-body" style={{ overflowY: 'auto' }}>
              <div className="grid-3" style={{ marginBottom: 14 }}>
                <div className="field" style={{ marginBottom: 0 }}>
                  <select value={selectedTask.type} onChange={(e) => handleTaskTypeChange(e.target.value as TaskType)} className="select">
                    <option value="post">📮 Почтовая</option>
                    <option value="delivery">🚚 Доставка</option>
                    <option value="pickup">📤 Отправка</option>
                    <option value="complex">📦 Сборная</option>
                    <option value="legal_address">⚖️ Юр. адрес</option>
                  </select>
                </div>
                <div className="field" style={{ marginBottom: 0 }}>
                  <input type="time" value={selectedTask.time} onChange={(e) => handleUpdateTask(selectedTask.id, { time: e.target.value })} className="input" />
                </div>
                <div className="field" style={{ marginBottom: 0 }}>
                  <input type="date" value={selectedTask.date} onChange={(e) => handleUpdateTask(selectedTask.id, { date: e.target.value })} className="input" />
                </div>
              </div>
              <div className="grid-2" style={{ marginBottom: 14 }}>
                <div className="field" style={{ marginBottom: 0 }}>
                  <label className="label">Статус:</label>
                  <select value={selectedTask.workflowStatus} onChange={(e) => handleWorkflowStatusChange(e.target.value as TaskWorkflowStatus)} className="select">
                    <option value="new">🟢 Новая</option>
                    <option value="in_progress">🟡 В работе</option>
                    <option value="completed">✅ Завершенная</option>
                  </select>
                </div>
                <div className="field" style={{ marginBottom: 0 }}>
                  <label className="label">Курьер:</label>
                  <select value={selectedTask.status} onChange={(e) => handleUpdateTask(selectedTask.id, { status: e.target.value })} className="select">
                    {couriers.map(col => <option key={col.id} value={col.id}>{col.name}</option>)}
                  </select>
                </div>
              </div>
              {selectedTask.completionType === 'no_visit' && (
                <div className="notice red">
                  <div style={{ fontWeight: 600 }}>🚫 Завершена без посещения{selectedTask.completedAt && <span className="muted" style={{ fontSize: 11, marginLeft: 6 }}>· {new Date(selectedTask.completedAt).toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' })}</span>}</div>
                  {selectedTask.noVisitReason && <div style={{ marginTop: 4 }}>{selectedTask.noVisitReason}</div>}
                </div>
              )}
              {selectedTask.type === 'pickup' && selectedTask.sentLetterCount != null && (
                <div className="notice blue">
                  <div style={{ fontSize: 11, fontWeight: 600, marginBottom: 3 }}>📤 Данные отправки:</div>
                  <div>Писем: <b style={{ fontFamily: 'monospace' }}>{selectedTask.sentLetterCount}</b> · Способ: <b>{selectedTask.sendMethod === 'ABS' ? 'АБС' : selectedTask.sendMethod === 'OPS' ? 'ОПС' : '—'}</b></div>
                </div>
              )}
              {/* 🆕 Тариф задачи */}
              {selectedTask.type !== 'post' && (
                <div className="notice green">
                  <label className="label" style={{ color: 'var(--green)' }}>💰 Тариф за задачу (₽):</label>
                  <input
                    type="text"
                    value={(selectedTask as any).taskRate || ''}
                    onChange={(e) => handleUpdateTask(selectedTask.id, { taskRate: e.target.value } as any)}
                    placeholder={getTaskRate(selectedTask) ? `Из карточки клиента: ${getTaskRate(selectedTask)}` : 'Например: 150'}
                    className="input"
                  />
                  {getTaskRate(selectedTask) && !(selectedTask as any).taskRate && (
                    <p className="muted" style={{ fontSize: 11, marginTop: 4 }}>Не задан для этой задачи — будет использован тариф клиента: {getTaskRate(selectedTask)} ₽</p>
                  )}
                </div>
              )}
              {/* 🆕 Время завершения */}
              {selectedTask.completedAt && (
                <div className="notice green">
                  <div style={{ fontSize: 11, fontWeight: 600, marginBottom: 3 }}>✅ Завершена курьером:</div>
                  <div>{formatCompletedAt(selectedTask.completedAt)}</div>
                </div>
              )}

              <div className="divider" />

              {selectedTask.type === 'post' && (
                <>
                  <div className="field">
                    <label className="label">Почтовое отделение:</label>
                    <SearchableSelect value={selectedTask.postOfficeFolder || ''} onChange={handlePostOfficeChangeInTask} options={postOfficeOptions} placeholder="-- Выберите --" searchPlaceholder="Поиск..." />
                  </div>
                  {selectedTask.postOfficeFolder && (() => {
                    const office = postOffices.find(po => po.folderName === selectedTask.postOfficeFolder);
                    const allCompanies: CompanyItem[] = office ? office.companies.map(name => ({ name, letterCount: 0 })) : (selectedTask.companies || []).map(c => typeof c === 'string' ? { name: c, letterCount: 0 } : c);
                    if (allCompanies.length === 0) return null;
                    return (
                      <div style={{ padding: 14, borderRadius: 10, background: 'var(--accent-soft)', border: '1px solid var(--accent)', marginBottom: 14 }}>
                        <button onClick={() => openPrintWindow([{ folderName: selectedTask.postOfficeFolder!, pointTitle: selectedTask.postIndex + ', ' + selectedTask.postAddress, companies: allCompanies }], 'Доверенности — ' + selectedTask.postOfficeFolder)} className="btn btn-primary" style={{ width: '100%' }}>🖨️ Распечатать ВСЕ доверенности ({allCompanies.length} шт.)</button>
                      </div>
                    );
                  })()}
                  <div className="field">
                    <label className="label" style={{ fontWeight: 700 }}>Организации:</label>
                    <div style={{ display: 'flex', flexDirection: 'column', gap: 6, marginBottom: 10 }}>
                      {normalizeCompanies(selectedTask.companies).map((comp, idx) => (
                        <div key={idx} style={{ padding: '8px 10px', borderRadius: 8, background: 'var(--panel-2)', border: `1px solid ${comp.operatorConfirmed ? 'var(--green)' : 'var(--border)'}` }}>
                          <div style={{ display: 'flex', alignItems: 'center', gap: 6, marginBottom: 4 }}>
                            <span style={{ flex: 1 }}>{comp.operatorConfirmed ? '✓ ' : '• '}{comp.name}</span>
                            <button onClick={() => removeOrganizationFromTask(idx)} style={{ color: 'var(--red)', background: 'none', border: 0, cursor: 'pointer', fontSize: 14, fontWeight: 700, padding: '0 4px' }}>&times;</button>
                          </div>
                          <div style={{ display: 'flex', gap: 10, fontSize: 12 }}>
                            <label style={{ display: 'flex', alignItems: 'center', gap: 4, color: 'var(--muted)' }}>К выдаче: <input type="number" min="0" value={comp.letterCount} onChange={(e) => updateCompanyCount(idx, Number(e.target.value) || 0)} className="input" style={{ width: 60, textAlign: 'center', padding: '2px 4px' }} /></label>
                            {(comp.receivedCount ?? 0) > 0 && <span style={{ color: 'var(--green)', display: 'flex', alignItems: 'center', gap: 3 }}>📬 Получено: <b style={{ fontFamily: 'monospace' }}>{comp.receivedCount}</b></span>}
                          </div>
                        </div>
                      ))}
                    </div>
                    <div style={{ display: 'flex', gap: 6 }}>
                      <input type="text" value={newOrgName} onChange={(e) => setNewOrgName(e.target.value)} placeholder="Название организации" className="input" style={{ flex: 1 }} onKeyDown={(e) => e.key === 'Enter' && addOrganizationToTask()} />
                      <button onClick={addOrganizationToTask} className="btn btn-primary">+</button>
                    </div>
                  </div>
                </>
              )}

              {selectedTask.type === 'legal_address' && (
                <div className="grid-2">
                  <div className="field" style={{ gridColumn: 'span 2' }}>
                    <label className="label">Клиент из базы:</label>
                    <SearchableSelect value={selectedTask.clientId ? String(selectedTask.clientId) : ''} onChange={(v) => { handleUpdateTask(selectedTask.id, { clientId: v ? Number(v) : undefined }); if (v) { const c = clients.find(cl => cl.id === Number(v)); if (c) handleUpdateTask(selectedTask.id, { legalCompanyName: c.companyName, legalAddress: c.address, legalContactPerson: c.contactPerson, legalContactPhone: c.phone, comments: selectedTask.comments || (getClientTaskNotesMap()[clientKeyForNote(c.id, c.companyName)] || ''), taskRate: (c as any).deliveryPickupRate || '' } as any); } }} options={clientOptions} placeholder="-- Выберите клиента --" searchPlaceholder="Поиск..." />
                  </div>
                  <div className="field" style={{ gridColumn: 'span 2' }}>
                    <label className="label">Наименование организации:</label>
                    <input type="text" value={selectedTask.legalCompanyName || ''} onChange={(e) => handleUpdateTask(selectedTask.id, { legalCompanyName: e.target.value })} className="input" />
                  </div>
                  <div className="field" style={{ gridColumn: 'span 2' }}>
                    <label className="label">Юридический адрес:</label>
                    <input type="text" value={selectedTask.legalAddress || ''} onChange={(e) => handleUpdateTask(selectedTask.id, { legalAddress: e.target.value })} className="input" />
                  </div>
                  <div className="field">
                    <label className="label">Контактное лицо:</label>
                    <input type="text" value={selectedTask.legalContactPerson || ''} onChange={(e) => handleUpdateTask(selectedTask.id, { legalContactPerson: e.target.value })} className="input" />
                  </div>
                  <div className="field">
                    <label className="label">Телефон:</label>
                    <input type="tel" value={selectedTask.legalContactPhone || ''} onChange={(e) => handleUpdateTask(selectedTask.id, { legalContactPhone: e.target.value })} className="input" />
                  </div>
                  <div className="field" style={{ gridColumn: 'span 2' }}>
                    <label className="label">Примечание:</label>
                    <textarea value={selectedTask.clientNote} onChange={(e) => handleUpdateTask(selectedTask.id, { clientNote: e.target.value })} rows={3} className="textarea" />
                  </div>
                </div>
              )}

              {(selectedTask.type === 'delivery' || selectedTask.type === 'pickup') && (
                <div className="grid-2">
                  <div className="field" style={{ gridColumn: 'span 2' }}>
                    <label className="label">Клиент из базы:</label>
                    <SearchableSelect value={selectedTask.clientId ? String(selectedTask.clientId) : ''} onChange={(v) => { handleUpdateTask(selectedTask.id, { clientId: v ? Number(v) : undefined }); if (v) { const c = clients.find(cl => cl.id === Number(v)); if (c) handleUpdateTask(selectedTask.id, { clientCompany: c.companyName, clientAddress: c.address, contactPerson: c.contactPerson, contactPhone: c.phone, clientNote: c.note, comments: selectedTask.comments || (getClientTaskNotesMap()[clientKeyForNote(c.id, c.companyName)] || ''), taskRate: (c as any).deliveryPickupRate || '' } as any); } }} options={clientOptions} placeholder="-- Выберите клиента --" searchPlaceholder="Поиск..." />
                  </div>
                  <div className="field" style={{ gridColumn: 'span 2' }}>
                    <label className="label">Наименование:</label>
                    <input type="text" value={selectedTask.clientCompany || ''} onChange={(e) => handleUpdateTask(selectedTask.id, { clientCompany: e.target.value })} className="input" />
                  </div>
                  <div className="field" style={{ gridColumn: 'span 2' }}>
                    <label className="label">Адрес:</label>
                    <input type="text" value={selectedTask.clientAddress} onChange={(e) => handleUpdateTask(selectedTask.id, { clientAddress: e.target.value })} className="input" />
                  </div>
                  <div className="field">
                    <label className="label">Интервал:</label>
                    <select value={selectedTask.timeWindow} onChange={(e) => handleUpdateTask(selectedTask.id, { timeWindow: e.target.value as TimeWindow })} className="select">
                      <option value="9:00-14:00">9:00 - 14:00</option>
                      <option value="14:00-18:00">14:00 - 18:00</option>
                    </select>
                  </div>
                  <div className="field">
                    <label className="label">Контакт:</label>
                    <input type="text" value={selectedTask.contactPerson} onChange={(e) => handleUpdateTask(selectedTask.id, { contactPerson: e.target.value })} className="input" />
                  </div>
                  <div className="field" style={{ gridColumn: 'span 2' }}>
                    <label className="label">Телефон:</label>
                    <input type="tel" value={selectedTask.contactPhone} onChange={(e) => handleUpdateTask(selectedTask.id, { contactPhone: e.target.value })} className="input" />
                  </div>
                  <div className="field" style={{ gridColumn: 'span 2' }}>
                    <label className="label">Примечание:</label>
                    <textarea value={selectedTask.clientNote} onChange={(e) => handleUpdateTask(selectedTask.id, { clientNote: e.target.value })} rows={3} className="textarea" />
                  </div>
                </div>
              )}

              {selectedTask.type === 'complex' && (
                <>
                  <div style={{ padding: 14, borderRadius: 10, background: 'var(--purple-soft)', border: '1px solid var(--purple)', marginBottom: 14 }}>
                    <h3 style={{ fontSize: 13, fontWeight: 700, color: 'var(--purple)', margin: '0 0 10px' }}>🏢 Офис клиента</h3>
                    <div className="field">
                      <label className="label">Клиент из базы:</label>
                      <SearchableSelect value={selectedTask.clientId ? String(selectedTask.clientId) : ''} onChange={handleTaskClientSelect} options={clientOptions} placeholder="-- Выберите клиента --" searchPlaceholder="Поиск..." />
                    </div>
                    <input type="text" value={selectedTask.officeCompany || ''} onChange={(e) => handleUpdateTask(selectedTask.id, { officeCompany: e.target.value })} placeholder="Наименование" className="input" style={{ marginBottom: 8 }} />
                    <input type="text" value={selectedTask.officeAddress || ''} onChange={(e) => handleUpdateTask(selectedTask.id, { officeAddress: e.target.value })} placeholder="Адрес" className="input" style={{ marginBottom: 8 }} />
                    <div className="grid-2">
                      <input type="text" value={selectedTask.officeContactPerson || ''} onChange={(e) => handleUpdateTask(selectedTask.id, { officeContactPerson: e.target.value })} placeholder="Контакт" className="input" />
                      <input type="tel" value={selectedTask.officeContactPhone || ''} onChange={(e) => handleUpdateTask(selectedTask.id, { officeContactPhone: e.target.value })} placeholder="Телефон" className="input" />
                    </div>
                  </div>
                  {selectedTask.postPoints && selectedTask.postPoints.length > 0 && (() => {
                    const points = selectedTask.postPoints!.filter(p => p.postOfficeFolder).map(p => {
                      const office = postOffices.find(po => po.folderName === p.postOfficeFolder);
                      const allCompanies: CompanyItem[] = office ? office.companies.map(name => ({ name, letterCount: 0 })) : (p.companies || []).map(c => typeof c === 'string' ? { name: c, letterCount: 0 } : c);
                      return { folderName: p.postOfficeFolder!, pointTitle: p.postIndex + ', ' + p.postAddress, companies: allCompanies };
                    }).filter(p => p.companies.length > 0);
                    if (points.length === 0) return null;
                    const totalDocs = points.reduce((sum, p) => sum + p.companies.length, 0);
                    return (
                      <div style={{ padding: 14, borderRadius: 10, background: 'var(--accent-soft)', border: '1px solid var(--accent)', marginBottom: 14 }}>
                        <button onClick={() => openPrintWindow(points, 'Доверенности — все почтовые точки')} className="btn btn-primary" style={{ width: '100%' }}>🖨️ Распечатать ВСЕ доверенности ({totalDocs} шт.)</button>
                      </div>
                    );
                  })()}
                  <div style={{ padding: 14, borderRadius: 10, background: 'var(--purple-soft)', border: '1px solid var(--purple)', marginBottom: 14 }}>
                    <h3 style={{ fontSize: 13, fontWeight: 700, color: 'var(--purple)', margin: '0 0 10px' }}>📮 Почтовые отделения ({selectedTask.postPoints?.length || 0})</h3>
                    <div style={{ display: 'flex', flexDirection: 'column', gap: 10, marginBottom: 12 }}>
                      {selectedTask.postPoints?.map((point, idx) => (
                        <div key={point.id} style={{ padding: 10, borderRadius: 8, background: 'var(--panel-2)', border: '1px solid var(--border)' }}>
                          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', marginBottom: 6 }}>
                            <div style={{ flex: 1 }}>
                              <div className="muted" style={{ fontSize: 11 }}>Точка #{idx + 1}</div>
                              <div style={{ fontWeight: 600 }}>{point.postIndex}, {point.postAddress}</div>
                            </div>
                            <button onClick={() => removePostPointFromTask(point.id)} style={{ color: 'var(--red)', background: 'none', border: 0, cursor: 'pointer', fontSize: 14, fontWeight: 700, padding: '0 4px' }}>&times;</button>
                          </div>
                          <div style={{ display: 'flex', flexDirection: 'column', gap: 3 }}>
                            {normalizeCompanies(point.companies).map((comp, cIdx) => (
                              <div key={cIdx} style={{ padding: '4px 8px', borderRadius: 5, fontSize: 12, display: 'flex', justifyContent: 'space-between', background: comp.operatorConfirmed ? 'var(--green-soft)' : 'var(--panel-3)' }}>
                                <span style={{ flex: 1, overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap' }}>{comp.operatorConfirmed ? '✓ ' : '• '}{comp.name}</span>
                                <div style={{ display: 'flex', gap: 6, flexShrink: 0 }}>{(comp.receivedCount ?? 0) > 0 && <span style={{ color: 'var(--accent)', fontFamily: 'monospace' }}>({comp.receivedCount})</span>}</div>
                              </div>
                            ))}
                          </div>
                        </div>
                      ))}
                    </div>
                    <div style={{ borderTop: '1px solid var(--purple)', paddingTop: 12, display: 'flex', flexDirection: 'column', gap: 8 }}>
                      <SearchableSelect value={newPointPostOfficeFolder} onChange={handlePointPostOfficeSelect} options={postOfficeOptions} placeholder="-- Выберите отделение --" searchPlaceholder="Поиск..." />
                      <textarea value={newPointCompanies} onChange={(e) => setNewPointCompanies(e.target.value)} placeholder="Организации (каждая с новой строки)" rows={3} className="textarea" />
                      <button onClick={addPostPointToTask} className="btn btn-primary">+ Добавить точку</button>
                    </div>
                  </div>
                </>
              )}

              <div className="field">
                <label className="label">💬 Комментарий логиста <span className="muted" style={{ fontWeight: 400 }}>(сохраняется ко всем последующим задачам)</span></label>
                <textarea value={selectedTask.comments} onChange={(e) => { const val = e.target.value; handleUpdateTask(selectedTask.id, { comments: val }); if (selectedTask.type === 'post' && selectedTask.postOfficeFolder) { saveOfficeNote(selectedTask.postOfficeFolder, val); } else { const ck = clientKeyForNote(selectedTask.clientId, selectedTask.clientCompany || selectedTask.officeCompany); if (ck) saveClientTaskNote(ck, val); } }} rows={3} className="textarea" />
              </div>
              {selectedTask.courierComments && (
                <div className="notice" style={{ background: 'var(--yellow-soft)', borderColor: 'var(--yellow)' }}>
                  <div style={{ fontSize: 11, color: 'var(--yellow)', fontWeight: 600, marginBottom: 3 }}>📝 Комментарий курьера <span className="muted" style={{ fontWeight: 400 }}>(только для этой задачи)</span>:</div>
                  <div>{selectedTask.courierComments}</div>
                </div>
              )}
            </div>
            <div className="modal-foot">
              {canAction('deleteTask') ? <button onClick={() => handleDeleteTask(false)} className="btn btn-red">🗑️ Удалить</button> : <span />}
              <button onClick={() => setSelectedTask(null)} className="btn btn-primary">Готово</button>
            </div>
          </div>
        </div>
      )}

      {/* ================= МОДАЛКА: СОЗДАНИЕ ЗАДАЧИ ================= */}
      {isModalOpen && (
        <div className="modal-backdrop">
          <div className="modal" style={{ maxHeight: '90vh' }}>
            <div className="modal-head">
              <h2 className="modal-title">Новая задача</h2>
              <button onClick={resetAllForms} style={{ border: 0, background: 'none', fontSize: 24, color: 'var(--muted)', cursor: 'pointer' }}>&times;</button>
            </div>
            <div className="modal-body" style={{ overflowY: 'auto' }}>
              <div className="notice">
                <b>Дата начала:</b> <span suppressHydrationWarning>{formatDateLong(selectedDate)}</span>
              </div>
              <div className="field">
                <label className="label">👤 Назначить курьера</label>
                <SearchableSelect value={newTaskCourier} onChange={setNewTaskCourier} options={courierOptions} placeholder="-- Выберите курьера --" searchPlaceholder="Поиск курьера..." />
              </div>
              <div className="grid-3" style={{ marginBottom: 14 }}>
                {[{ type: 'post' as TaskType, label: '📮 Почтовая' }, { type: 'delivery' as TaskType, label: '🚚 Доставка' }, { type: 'pickup' as TaskType, label: '📤 Отправка' }, { type: 'complex' as TaskType, label: '📦 Сборная' }, { type: 'legal_address' as TaskType, label: '⚖️ Юр. адрес' }].map(item => (
                  <button key={item.type} onClick={() => setNewTaskType(item.type)} style={{ padding: '10px 8px', borderRadius: 8, border: `2px solid ${newTaskType === item.type ? 'var(--accent)' : 'var(--border)'}`, background: newTaskType === item.type ? 'var(--accent-soft)' : 'var(--panel-2)', color: newTaskType === item.type ? 'var(--accent)' : 'var(--text)', cursor: 'pointer', fontSize: 12, fontWeight: 600 }}>
                    {item.label}
                  </button>
                ))}
              </div>
              <div style={{ padding: 14, borderRadius: 10, background: 'var(--yellow-soft)', border: '1px solid var(--yellow)', marginBottom: 14 }}>
                <h3 style={{ fontSize: 13, fontWeight: 700, color: 'var(--yellow)', margin: '0 0 10px' }}>🔁 Повторение задачи</h3>
                <select value={recurrenceType} onChange={(e) => { setRecurrenceType(e.target.value as RecurrenceType); if (e.target.value === 'none') { setRecurrenceDays([]); setRecurrenceEndDate(''); } }} className="select" style={{ marginBottom: 10 }}>
                  <option value="none">Не повторять</option>
                  <option value="weekly">Еженедельно</option>
                  <option value="monthly">Ежемесячно</option>
                </select>
                {recurrenceType === 'weekly' && (
                  <div>
                    <div style={{ display: 'grid', gridTemplateColumns: 'repeat(7, 1fr)', gap: 4, marginBottom: 6 }}>
                      {WEEK_DAYS.map(day => (
                        <button key={day.value} type="button" onClick={() => { setRecurrenceDays(prev => prev.includes(day.value) ? prev.filter(d => d !== day.value) : [...prev, day.value]); }} style={{ padding: '8px 4px', borderRadius: 6, border: 0, background: recurrenceDays.includes(day.value) ? 'var(--yellow)' : 'var(--panel-2)', color: recurrenceDays.includes(day.value) ? '#fff' : 'var(--text)', cursor: 'pointer', fontSize: 11, fontWeight: 600 }}>{day.label}</button>
                      ))}
                    </div>
                    {recurrenceDays.length === 0 && <p style={{ fontSize: 11, color: 'var(--red)', margin: 0 }}>Выберите хотя бы один день</p>}
                  </div>
                )}
                {recurrenceType === 'monthly' && <input type="number" min="1" max="31" value={recurrenceDayOfMonth} onChange={(e) => setRecurrenceDayOfMonth(Math.max(1, Math.min(31, Number(e.target.value) || 1)))} className="input" />}
                {recurrenceType !== 'none' && <input type="date" value={recurrenceEndDate} onChange={(e) => setRecurrenceEndDate(e.target.value)} min={selectedDate} className="input" style={{ marginTop: 8 }} />}
              </div>

              {newTaskType === 'post' && (
                <>
                  <div className="field">
                    <SearchableSelect value={newPostData.postOfficeFolder} onChange={handlePostOfficeSelect} options={postOfficeOptions} placeholder="-- Выберите почтовое отделение --" searchPlaceholder="Введите индекс или адрес..." />
                  </div>
                  {newPostData.postOfficeFolder && (
                    <div className="notice">
                      <b>Индекс:</b> {newPostData.postIndex}<br />
                      <b>Адрес:</b> {newPostData.postAddress}
                    </div>
                  )}
                  <div className="field">
                    <label className="label">Организации (каждая с новой строки) <span style={{ color: 'var(--red)' }}>*</span></label>
                    <textarea value={newPostData.companiesText} onChange={(e) => setNewPostData({ ...newPostData, companiesText: e.target.value })} placeholder={'ООО Ромашка\nИП Иванов'} rows={6} className="textarea" />
                  </div>
                </>
              )}

              {(newTaskType === 'delivery' || newTaskType === 'pickup') && (
                <>
                  {clients.length > 0 && (
                    <div className="field">
                      <SearchableSelect value={selectedClientId ? String(selectedClientId) : ''} onChange={handleClientSelect} options={clientOptions} placeholder="-- Выберите из базы клиентов --" searchPlaceholder="Поиск клиента..." />
                    </div>
                  )}
                  <div className="field">
                    <input type="text" value={newClientData.clientCompany} onChange={(e) => setNewClientData(p => ({ ...p, clientCompany: e.target.value }))} placeholder="Наименование организации *" className="input" />
                  </div>
                  <div className="field">
                    <input type="text" value={newClientData.clientAddress} onChange={(e) => setNewClientData(p => ({ ...p, clientAddress: e.target.value }))} placeholder="Адрес клиента" className="input" />
                  </div>
                  <div className="grid-2">
                    <div className="field">
                      <select value={newClientData.timeWindow} onChange={(e) => setNewClientData(p => ({ ...p, timeWindow: e.target.value as TimeWindow }))} className="select">
                        <option value="9:00-14:00">9:00 - 14:00</option>
                        <option value="14:00-18:00">14:00 - 18:00</option>
                      </select>
                    </div>
                    <div className="field">
                      <input type="text" value={newClientData.contactPerson} onChange={(e) => setNewClientData(p => ({ ...p, contactPerson: e.target.value }))} placeholder="Контактное лицо" className="input" />
                    </div>
                  </div>
                  <div className="field">
                    <input type="tel" value={newClientData.contactPhone} onChange={(e) => setNewClientData(p => ({ ...p, contactPhone: e.target.value }))} placeholder="Телефон" className="input" />
                  </div>
                  <div className="field">
                    <textarea value={newClientData.clientNote} onChange={(e) => setNewClientData(p => ({ ...p, clientNote: e.target.value }))} placeholder="Примечание" rows={3} className="textarea" />
                  </div>
                </>
              )}

              {newTaskType === 'legal_address' && (
                <>
                  {clients.length > 0 && (
                    <div className="field">
                      <SearchableSelect value={selectedClientId ? String(selectedClientId) : ''} onChange={handleClientSelect} options={clientOptions} placeholder="-- Выберите из базы клиентов --" searchPlaceholder="Поиск клиента..." />
                    </div>
                  )}
                  <div className="field">
                    <input type="text" value={newClientData.clientCompany} onChange={(e) => setNewClientData(p => ({ ...p, clientCompany: e.target.value }))} placeholder="Наименование организации *" className="input" />
                  </div>
                  <div className="field">
                    <input type="text" value={newClientData.clientAddress} onChange={(e) => setNewClientData(p => ({ ...p, clientAddress: e.target.value }))} placeholder="Юридический адрес *" className="input" />
                  </div>
                  <div className="grid-2">
                    <div className="field">
                      <input type="text" value={newClientData.contactPerson} onChange={(e) => setNewClientData(p => ({ ...p, contactPerson: e.target.value }))} placeholder="Контактное лицо" className="input" />
                    </div>
                    <div className="field">
                      <input type="tel" value={newClientData.contactPhone} onChange={(e) => setNewClientData(p => ({ ...p, contactPhone: e.target.value }))} placeholder="Телефон" className="input" />
                    </div>
                  </div>
                  <div className="field">
                    <textarea value={newClientData.clientNote} onChange={(e) => setNewClientData(p => ({ ...p, clientNote: e.target.value }))} placeholder="Примечание" rows={3} className="textarea" />
                  </div>
                </>
              )}

              {newTaskType === 'complex' && (
                <>
                  <div style={{ padding: 14, borderRadius: 10, background: 'var(--purple-soft)', border: '1px solid var(--purple)', marginBottom: 14 }}>
                    <h3 style={{ fontSize: 13, fontWeight: 700, color: 'var(--purple)', margin: '0 0 10px' }}>🏢 Офис клиента</h3>
                    {clients.length > 0 && (
                      <div className="field">
                        <label className="label">Клиент из базы:</label>
                        <SearchableSelect value={selectedComplexClientId ? String(selectedComplexClientId) : ''} onChange={handleComplexClientSelect} options={clientOptions} placeholder="-- Выберите из базы клиентов --" searchPlaceholder="Поиск клиента..." />
                      </div>
                    )}
                    <input type="text" value={newComplexData.officeCompany} onChange={(e) => setNewComplexData(p => ({ ...p, officeCompany: e.target.value }))} placeholder="Наименование *" className="input" style={{ marginBottom: 8 }} />
                    <input type="text" value={newComplexData.officeAddress} onChange={(e) => setNewComplexData(p => ({ ...p, officeAddress: e.target.value }))} placeholder="Адрес офиса *" className="input" style={{ marginBottom: 8 }} />
                    <div className="grid-2">
                      <input type="text" value={newComplexData.officeContactPerson} onChange={(e) => setNewComplexData(p => ({ ...p, officeContactPerson: e.target.value }))} placeholder="Контакт *" className="input" />
                      <input type="tel" value={newComplexData.officeContactPhone} onChange={(e) => setNewComplexData(p => ({ ...p, officeContactPhone: e.target.value }))} placeholder="Телефон *" className="input" />
                    </div>
                  </div>
                  <div style={{ padding: 14, borderRadius: 10, background: 'var(--purple-soft)', border: '1px solid var(--purple)' }}>
                    <h3 style={{ fontSize: 13, fontWeight: 700, color: 'var(--purple)', margin: '0 0 10px' }}>📮 Почтовые отделения ({newComplexData.postPoints.length})</h3>
                    {newComplexData.postPoints.length > 0 && (
                      <div style={{ display: 'flex', flexDirection: 'column', gap: 6, marginBottom: 10 }}>
                        {newComplexData.postPoints.map((point) => (
                          <div key={point.id} style={{ padding: 8, borderRadius: 8, background: 'var(--panel-2)', border: '1px solid var(--border)' }}>
                            <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start' }}>
                              <div style={{ flex: 1, fontSize: 12 }}>
                                <div style={{ fontWeight: 600 }}>{point.postIndex}, {point.postAddress}</div>
                                <div className="muted" style={{ marginTop: 2 }}>{normalizeCompanies(point.companies).map(c => c.name).join(', ')}</div>
                              </div>
                              <button onClick={() => removePointFromNewComplexTask(point.id)} style={{ color: 'var(--red)', background: 'none', border: 0, cursor: 'pointer', fontSize: 14, fontWeight: 700, padding: '0 4px' }}>×</button>
                            </div>
                          </div>
                        ))}
                      </div>
                    )}
                    <div style={{ borderTop: '1px solid var(--purple)', paddingTop: 10, display: 'flex', flexDirection: 'column', gap: 8 }}>
                      <SearchableSelect value={newPointPostOfficeFolder} onChange={handlePointPostOfficeSelect} options={postOfficeOptions} placeholder="-- Выберите почтовое отделение --" searchPlaceholder="Введите индекс или адрес..." />
                      <textarea value={newPointCompanies} onChange={(e) => setNewPointCompanies(e.target.value)} placeholder="Организации (каждая с новой строки)" rows={3} className="textarea" />
                      <button onClick={addPointToNewComplexTask} className="btn btn-primary">+ Добавить точку</button>
                    </div>
                  </div>
                </>
              )}

              <div style={{ padding: 14, borderRadius: 10, background: 'var(--accent-soft)', border: '1px solid var(--accent)', marginTop: 14 }}>
                <label className="label" style={{ color: 'var(--accent)' }}>💬 Комментарий логиста</label>
                <textarea value={newLogistComment} onChange={(e) => setNewLogistComment(e.target.value)} placeholder={newTaskType === 'post' ? 'Сохранится для всех будущих задач этого отделения...' : 'Сохранится для всех будущих задач этого клиента...'} rows={2} className="textarea" />
                <p className="muted" style={{ fontSize: 11, marginTop: 4 }}>Автоматически подставляется в последующие задачи {newTaskType === 'post' ? 'этого почтового отделения' : 'этого клиента'}.</p>
              </div>
            </div>
            <div className="modal-foot">
              <button onClick={resetAllForms} className="btn">Отмена</button>
              <button onClick={handleCreateTask} className="btn btn-primary">Создать задачу</button>
            </div>
          </div>
        </div>
      )}

      {/* ================= СКАНЕР ОПЕРАТОРА ================= */}
      <OperatorScannerModal
        isOpen={isOperatorScannerOpen}
        onClose={() => setIsOperatorScannerOpen(false)}
        receiveTasks={operatorTasks}
        pendingReturns={returnsPending}
        couriers={couriers}
      />
    </div>
  );
}
