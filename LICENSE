  const [isCashModalOpen, setIsCashModalOpen] = useState(false);
  const [cashForm, setCashForm] = useState<{ type: CashOperationType; date: string; amount: string; description: string; clientId: string; employeeName: string; expenseArticle: string; letterCount: string; paymentMethod: PaymentMethod; }>({ type: 'income', date: '', amount: '', description: '', clientId: '', employeeName: '', expenseArticle: '', letterCount: '', paymentMethod: 'cash' });
  const [cashDateFrom, setCashDateFrom] = useState<string>('');
  const [cashDateTo, setCashDateTo] = useState<string>('');
  const [cashTypeFilter, setCashTypeFilter] = useState<string>('');
  const [cashPaymentFilter, setCashPaymentFilter] = useState<string>('');
  const [cashClientFilter, setCashClientFilter] = useState<string>('');
  // 🆕 Недельный обзор курьера
  const [courierWeekView, setCourierWeekView] = useState<Courier | null>(null);
  // 🆕 Режим даты оператора
