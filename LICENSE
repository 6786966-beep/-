function createInitialTasks(date: string): Task[] {
  return [{ id: 1, type: 'post', title: '101000, Мясницкая 26', time: '09:30', date: date, status: 'unassigned', workflowStatus: 'new', comments: '', postIndex: '101000', postAddress: 'Мясницкая 26', postOfficeFolder: '101000 Мясницкая 26', indexAutoDetected: true, companies: [{ name: 'ООО ТехноСервис', letterCount: 0 }, { name: 'ИП Козлов А.В.', letterCount: 0 }] }];
}

